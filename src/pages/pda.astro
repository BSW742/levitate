---
// PDA - Lead sourcing tool
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>PDA - Lead Sourcing</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
  <meta name="theme-color" content="#f6f5f3">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="PDA">
</head>
<body>
  <!-- Password Gate -->
  <div id="login-gate">
    <div class="login-box">
      <h1 class="login-title">PDA</h1>
      <p class="login-subtitle">Use your Stiki sync password</p>
      <input type="password" id="password-input" placeholder="Sync password" autocomplete="off">
      <button id="login-btn">Enter</button>
      <p id="login-error">Password required (min 4 chars)</p>
    </div>
  </div>

  <!-- Main App -->
  <div id="app">
    <!-- Header -->
    <header id="header">
      <div id="primary-nav">
        <div id="mode-toggle">
          <button class="mode-btn active" data-mode="leads">Leads</button>
          <a class="mode-btn" href="/?view=goals">Goals</a>
          <a class="mode-btn mode-icon" href="/?view=list" title="List" aria-label="List view"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg></a>
          <a class="mode-btn" href="/?view=tasks">Tasks</a>
        </div>
      </div>
      <div id="header-top">
        <h1 id="header-project-name">No project</h1>
        <div id="header-actions">
          <button id="settings-btn" title="Settings">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </button>
        </div>
      </div>
      <div id="board-bar">
        <button id="back-to-search" class="search-dot active" title="Find leads" aria-label="Find leads">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
        </button>
        <button class="board-dot" data-board="0" style="background: #fed7aa" title="Orange"></button>
        <button class="board-dot" data-board="1" style="background: #fef08a" title="Yellow"></button>
        <button class="board-dot" data-board="2" style="background: #bbf7d0" title="Green"></button>
        <button class="board-dot" data-board="3" style="background: #93c5fd" title="Blue"></button>
        <button class="board-dot" data-board="4" style="background: #c7d2fe" title="Indigo"></button>
        <button class="board-dot" data-board="5" style="background: #ddd6fe" title="Violet"></button>
      </div>
    </header>

    <!-- Mode 1: LinkedIn Scanner -->
    <div id="scan-mode" class="mode-content active">
      <!-- Criteria Form -->
      <div id="criteria-form">
        <div class="form-row">
          <input type="url" id="company-url" placeholder="Company URL (e.g. acme.com) - takes precedence">
        </div>
        <div class="form-divider"><span>or search by</span></div>
        <div class="form-row">
          <input type="text" id="criteria-location" placeholder="Location (e.g., Sydney, Australia)">
        </div>
        <div class="form-row">
          <input type="text" id="criteria-industry" placeholder="Industry (e.g., Real Estate)">
        </div>
        <div class="form-row">
          <input type="text" id="criteria-role" placeholder="Role (e.g., CEO, Director)">
        </div>
        <button id="gimme-btn" class="primary-btn">
          <span class="btn-text">Find leads</span>
          <span class="btn-loading">Searching...</span>
        </button>

        <div id="lookup-results" class="lookup-results hidden"></div>

        <div class="google-row">
          <span class="google-row-label">Look up on the web</span>
          <div class="google-btns">
            <button class="google-btn" data-g="website">Website</button>
            <button class="google-btn" data-g="people">People</button>
            <button class="google-btn" data-g="companies">Companies</button>
          </div>
        </div>
      </div>

      <!-- Queue -->
      <div id="queue-section" class="hidden">
        <div id="queue-header">
          <span id="queue-count">0 profiles</span>
          <button id="clear-queue" class="text-btn">Clear</button>
        </div>
        <div id="queue-list"></div>
      </div>

      <!-- Current Profile -->
      <div id="current-profile" class="hidden">
        <div class="profile-card">
          <div class="profile-avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>
          </div>
          <div class="profile-info">
            <h2 id="profile-name">Name</h2>
            <p id="profile-role">Role</p>
            <p id="profile-company">Company</p>
          </div>
          <div class="profile-actions">
            <button id="view-linkedin" class="action-btn linkedin">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              Search LI
            </button>
            <button id="add-lead" class="action-btn primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              Add Lead
            </button>
            <button id="skip-profile" class="action-btn secondary">Skip</button>
          </div>
        </div>
      </div>

      <!-- Photo Capture -->
      <div id="photo-capture" class="hidden">
        <div class="capture-header">
          <h3>Take Screenshot</h3>
          <p>Screenshot the LinkedIn profile, then select the image</p>
        </div>
        <div class="capture-actions">
          <button id="select-photo" class="action-btn primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            Select Photo
          </button>
          <button id="cancel-capture" class="action-btn secondary">Cancel</button>
        </div>
      </div>

      <!-- Lead Preview -->
      <div id="lead-preview" class="hidden">
        <div class="preview-card">
          <div class="preview-avatar" id="preview-avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>
          </div>
          <div class="preview-fields">
            <div class="field-group">
              <label>Name</label>
              <input type="text" id="preview-name">
            </div>
            <div class="field-group">
              <label>Role</label>
              <input type="text" id="preview-role">
            </div>
            <div class="field-group">
              <label>Company</label>
              <input type="text" id="preview-company">
            </div>
            <div class="field-row">
              <div class="field-group">
                <label>Phone</label>
                <input type="tel" id="preview-phone">
              </div>
              <div class="field-group">
                <label>Email</label>
                <input type="email" id="preview-email">
              </div>
            </div>
            <div class="field-group">
              <label>Website</label>
              <input type="url" id="preview-website">
            </div>
            <div class="field-group">
              <label>LinkedIn URL</label>
              <input type="url" id="preview-linkedin" placeholder="linkedin.com/in/...">
            </div>
          </div>
          <div class="board-select">
            <label>Add to board:</label>
            <div class="board-options">
              <button class="board-btn active" data-board="0" style="background: #fed7aa" title="Orange"></button>
              <button class="board-btn" data-board="1" style="background: #fef9c3" title="Yellow"></button>
              <button class="board-btn" data-board="2" style="background: #dcfce7" title="Green"></button>
              <button class="board-btn" data-board="3" style="background: #93c5fd" title="Blue"></button>
              <button class="board-btn" data-board="4" style="background: #e0e7ff" title="Indigo"></button>
              <button class="board-btn" data-board="5" style="background: #ede9fe" title="Violet"></button>
            </div>
          </div>
          <div class="preview-actions">
            <button id="cancel-preview" class="action-btn secondary">Cancel</button>
            <button id="save-lead" class="action-btn primary">Save Lead</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Mode 2: Website/Webhook -->
    <div id="web-mode" class="mode-content">
      <div id="url-form" hidden>
        <button id="enrich-btn" class="primary-btn">
          <span class="btn-text">Enrich</span>
          <span class="btn-loading">Enriching...</span>
        </button>
      </div>

      <!-- Web Profile Card (after enrich) -->
      <div id="web-profile" class="hidden">
        <div class="profile-card">
          <div class="profile-avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>
          </div>
          <div class="profile-info">
            <h2 id="web-profile-name">Name</h2>
            <p id="web-profile-role">Role</p>
            <p id="web-profile-company">Company</p>
          </div>
          <div class="profile-actions">
            <button id="web-view-linkedin" class="action-btn linkedin">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              Search LI
            </button>
            <button id="web-add-lead" class="action-btn primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              Add LI Photo
            </button>
            <button id="web-skip" class="action-btn secondary">Save Without Photo</button>
          </div>
        </div>
      </div>

      <!-- Web Photo Capture -->
      <div id="web-photo-capture" class="hidden">
        <div class="capture-header">
          <h3>Take Screenshot</h3>
          <p>Screenshot the LinkedIn profile, then select the image</p>
        </div>
        <div class="capture-actions">
          <button id="web-select-photo" class="action-btn primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            Select Photo
          </button>
          <button id="web-cancel-capture" class="action-btn secondary">Cancel</button>
        </div>
      </div>

      <!-- Web Lead Preview (final step) -->
      <div id="web-preview" class="hidden">
        <div class="preview-card">
          <div class="preview-avatar" id="web-preview-avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>
          </div>
          <div class="preview-fields">
            <div class="field-group">
              <label>Name</label>
              <input type="text" id="web-name" placeholder="Contact name">
            </div>
            <div class="field-group">
              <label>Company</label>
              <input type="text" id="web-company">
            </div>
            <div class="field-group">
              <label>Role</label>
              <input type="text" id="web-role" placeholder="Job title">
            </div>
            <div class="field-row">
              <div class="field-group">
                <label>Phone</label>
                <input type="tel" id="web-phone">
              </div>
              <div class="field-group">
                <label>Email</label>
                <input type="email" id="web-email">
              </div>
            </div>
            <div class="field-group">
              <label>Website</label>
              <input type="url" id="web-website">
            </div>
          </div>
          <div class="board-select">
            <label>Add to board:</label>
            <div class="board-options">
              <button class="board-btn web active" data-board="0" style="background: #fed7aa" title="Orange"></button>
              <button class="board-btn web" data-board="1" style="background: #fef9c3" title="Yellow"></button>
              <button class="board-btn web" data-board="2" style="background: #dcfce7" title="Green"></button>
              <button class="board-btn web" data-board="3" style="background: #93c5fd" title="Blue"></button>
              <button class="board-btn web" data-board="4" style="background: #e0e7ff" title="Indigo"></button>
              <button class="board-btn web" data-board="5" style="background: #ede9fe" title="Violet"></button>
            </div>
          </div>
          <div class="preview-actions">
            <button id="cancel-web" class="action-btn secondary">Cancel</button>
            <button id="save-web-lead" class="action-btn primary">Save Lead</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Board View -->
    <div id="board-view" class="hidden">
      <div id="board-title-bar">
        <input type="text" id="board-title" placeholder="Untitled">
      </div>
      <div id="board-cards"></div>
      <div id="board-empty" class="hidden">
        <p>No leads on this board yet</p>
      </div>
    </div>

    <!-- Settings Modal -->
    <div id="settings-modal" class="modal hidden">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Settings</h2>
          <button class="modal-close" id="close-settings">&times;</button>
        </div>
        <div class="modal-body">
          <div class="setting-group">
            <label>Current Project</label>
            <div class="current-project">
              <span id="current-project-name">No project</span>
            </div>
          </div>
          <div class="setting-divider"></div>
          <div class="setting-group">
            <label>Switch Project</label>
            <p class="setting-hint">Enter a project name to switch or create a new project</p>
            <input type="text" id="switch-project-input" placeholder="e.g. litebooks-sales">
            <div class="setting-actions">
              <button id="switch-project-btn">Switch Project</button>
            </div>
          </div>
          <div class="setting-divider"></div>
          <div class="setting-group">
            <label>Data</label>
            <div class="setting-actions">
              <button id="export-data">Export</button>
              <button id="import-data" class="secondary">Import</button>
            </div>
          </div>
        </div>
      </div>
    </div>
    <input type="file" id="import-file" accept=".json" style="display: none">

    <!-- Project Switch Success Overlay -->
    <div id="switch-success" class="switch-success hidden">
      <div class="switch-success-content">
        <div class="switch-success-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <div class="switch-success-text">Switched to</div>
        <div class="switch-success-project" id="switch-success-name"></div>
      </div>
    </div>

    <!-- Card Detail Modal -->
    <div id="card-detail-modal" class="modal hidden">
      <div class="modal-content detail-content">
        <div class="modal-header">
          <h2>Edit Lead</h2>
          <button class="modal-close" id="close-detail">&times;</button>
        </div>
        <div class="modal-body">
          <div class="detail-avatar-section">
            <div class="detail-avatar" id="detail-avatar">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>
            </div>
          </div>
          <div class="detail-fields">
            <div class="field-group">
              <label>Name</label>
              <input type="text" id="detail-name">
            </div>
            <div class="field-group">
              <label>Role</label>
              <input type="text" id="detail-role">
            </div>
            <div class="field-group">
              <label>Company</label>
              <input type="text" id="detail-company">
            </div>
            <div class="field-row">
              <div class="field-group">
                <label>Phone</label>
                <input type="tel" id="detail-phone">
              </div>
              <div class="field-group">
                <label>Email</label>
                <input type="email" id="detail-email">
              </div>
            </div>
            <div class="field-group">
              <label>Website</label>
              <input type="url" id="detail-website">
            </div>
            <div class="field-group">
              <label>Notes</label>
              <textarea id="detail-notes" rows="3"></textarea>
            </div>
            <div class="field-group">
              <label>Board: <span id="selected-board-name"></span></label>
              <div class="detail-board-picker" id="detail-board-picker">
                <button class="board-opt" data-board="0" style="background: #fed7aa"></button>
                <button class="board-opt" data-board="1" style="background: #fef08a"></button>
                <button class="board-opt" data-board="2" style="background: #bbf7d0"></button>
                <button class="board-opt" data-board="3" style="background: #93c5fd"></button>
                <button class="board-opt" data-board="4" style="background: #c7d2fe"></button>
                <button class="board-opt" data-board="5" style="background: #ddd6fe"></button>
              </div>
            </div>
          </div>

          <!-- Activity Log -->
          <div class="activity-section">
            <div class="activity-header">
              <label>Activity</label>
              <div class="activity-type-btns">
                <button class="activity-type-btn" data-type="call" title="Log call">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                </button>
                <button class="activity-type-btn" data-type="email" title="Log email">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
                </button>
                <button class="activity-type-btn" data-type="meeting" title="Log meeting">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                </button>
              </div>
            </div>
            <div id="activity-input" class="activity-input hidden">
              <input type="text" id="activity-text" placeholder="Add a note...">
              <button id="activity-add" class="action-btn primary small">Add</button>
              <button id="activity-cancel" class="action-btn secondary small">✕</button>
            </div>
            <div id="activity-list" class="activity-list"></div>
          </div>

