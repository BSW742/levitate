  document.getElementById('confirm-crop')?.addEventListener('click', () => {
    if (!rawImage || !cropperImage) return;

    const canvas = document.createElement('canvas');
    const size = 150;
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext('2d')!;

    // Calculate scale from display to actual image
    const displayWidth = cropperImage.clientWidth;
    const naturalWidth = cropperImage.naturalWidth;
    const scale = naturalWidth / displayWidth;

    const srcX = cropX * scale;
    const srcY = cropY * scale;
    const srcSize = cropSize * scale;

    const img = new Image();
    img.onload = () => {
      ctx.drawImage(img, srcX, srcY, srcSize, srcSize, 0, 0, size, size);
      const croppedImage = canvas.toDataURL('image/jpeg', 0.8);

      cropperModal?.classList.add('hidden');

      // Check which mode we're in
      if (currentMode === 'web') {
        // Web mode - store image and show web preview
        webCapturedImage = croppedImage;
        showWebPreview();
      } else {
        // Scan mode - original behavior
        capturedImage = croppedImage;

        // Show preview
        const avatarEl = document.getElementById('preview-avatar')!;
        avatarEl.innerHTML = `<img src="${capturedImage}" alt="" />`;

        // Populate preview fields
        (document.getElementById('preview-name') as HTMLInputElement).value = scannedData.name || queue[currentIndex]?.name || '';
        (document.getElementById('preview-role') as HTMLInputElement).value = scannedData.role || queue[currentIndex]?.role || '';
        (document.getElementById('preview-company') as HTMLInputElement).value = scannedData.company || queue[currentIndex]?.company || '';
        (document.getElementById('preview-phone') as HTMLInputElement).value = scannedData.phone || '';
        (document.getElementById('preview-email') as HTMLInputElement).value = scannedData.email || '';
        (document.getElementById('preview-website') as HTMLInputElement).value = scannedData.website || '';

        document.getElementById('photo-capture')?.classList.add('hidden');
        document.getElementById('lead-preview')?.classList.remove('hidden');

        // preview is up; the slow half runs behind it
        startEnrich(
          (document.getElementById('preview-name') as HTMLInputElement).value,
          (document.getElementById('preview-company') as HTMLInputElement).value,
        );
      }
    };
    img.src = rawImage;
  });

  /* A phone screenshot is 3-7MB once base64'd, and it was being uploaded raw.
     LinkedIn text stays perfectly legible to the vision model at 1400px, and
     this cuts the upload - the slowest leg on mobile - by roughly 20x. */
  function shrinkForScan(dataUrl: string, maxEdge = 1400, quality = 0.75): Promise<string> {
    return new Promise(resolve => {
      const img = new Image();
      img.onload = () => {
        const scale = Math.min(1, maxEdge / Math.max(img.width, img.height));
        if (scale === 1 && dataUrl.length < 700000) return resolve(dataUrl);
        const c = document.createElement('canvas');
        c.width = Math.round(img.width * scale);
        c.height = Math.round(img.height * scale);
        const ctx = c.getContext('2d');
        if (!ctx) return resolve(dataUrl);
        ctx.drawImage(img, 0, 0, c.width, c.height);
        resolve(c.toDataURL('image/jpeg', quality));
      };
      img.onerror = () => resolve(dataUrl);
      img.src = dataUrl;
    });
  }

