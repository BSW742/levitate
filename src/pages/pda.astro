  // Save lead to Stiki
  async function saveLead(data: {
    name: string;
    role?: string;
    company?: string;
    phone?: string;
    email?: string;
    website?: string;
    linkedin?: string;
    avatar?: string;
    quadrant: number;
  }) {
    const colors = ['#fed7aa', '#fef08a', '#bbf7d0', '#93c5fd', '#c7d2fe', '#ddd6fe'];

    let displayText = data.name;
    if (data.role) displayText += `\n${data.role}`;
    if (data.company && data.company !== data.name) displayText += `\n${data.company}`;

    const note = {
      id: `note-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      text: displayText,
      color: colors[data.quadrant] || '#fed7aa',
      x: 50 + Math.random() * 200,
      y: 80 + Math.random() * 200,
      rotation: (Math.random() - 0.5) * 6,
      createdAt: Date.now(),
      updatedAt: Date.now(),
      zIndex: 1,            // the worker assigns the real one
      isLead: true,
      quadrant: data.quadrant,
      avatar: data.avatar,
      name: data.name,
      role: data.role,
      company: data.company,
      phone: data.phone,
      email: data.email,
      website: data.website,
      linkedin: data.linkedin,
    };

    /* Send only the note. The worker merges it into the project, so nothing
       else in the blob can be clobbered and there is no 150KB round trip. */
    const res = await fetch(`${WORKER_URL}/append-note`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Sync-Password': syncPassword! },
      body: JSON.stringify(note),
    });
    if (!res.ok) throw new Error(`Save failed: HTTP ${res.status} ${await res.text()}`);
  }


