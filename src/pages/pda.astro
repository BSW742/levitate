        body: JSON.stringify({ name, company }),
      });
      if (!res.ok) return;
      const d = await res.json();
      const fill = (id: string, v: string) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        if (el && v && !el.value.trim()) el.value = v;   // never overwrite typing
      };
      fill('preview-website', d.website || '');
      fill('preview-phone', d.phone || '');
      fill('preview-email', d.email || '');
      if (scannedData) {
        scannedData.website = scannedData.website || d.website || '';
        scannedData.phone = scannedData.phone || d.phone || '';
        scannedData.email = scannedData.email || d.email || '';
