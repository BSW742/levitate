}

/* Activity Section */
.activity-section {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid #e9e7e2;
}
.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.activity-header label {
  font-size: 0.75rem;
  font-weight: 600;
  color: #8a847c;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.activity-type-btns {
  display: flex;
  gap: 8px;
}
.activity-type-btn {
  width: 40px;
  height: 40px;
  border: 1.5px solid #e9e7e2;
  background: #ffffff;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a847c;
}
.activity-type-btn svg {
  width: 18px;
  height: 18px;
  transition: all 0.2s ease;
}
.activity-type-btn:hover {
  background: #eceae5;
  border-color: #ded9d3;
  color: #3f3b36;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(18,16,14,0.14);
}
.activity-type-btn.active {
  background: #6366f1;
  border-color: #6366f1;
  color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(99,102,241,0.3);
}

.activity-input {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}
.activity-input.hidden { display: none; }
.activity-input input {
  flex: 1;
  padding: 10px 12px;
  background: #eceae5;
  border: 1px solid #ded9d3;
  border-radius: 8px;
  color: #12100e;
  font-size: 0.95rem;
}
.activity-input input:focus {
  outline: none;
  border-color: #6366f1;
}
.action-btn.small {
  padding: 10px 14px;
  font-size: 0.9rem;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: 200px;
  overflow-y: auto;
}
.activity-item {
  display: flex;
  gap: 10px;
  padding: 10px 12px;
  background: #eceae5;
  border-radius: 10px;
  position: relative;
}
.activity-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  background: #e2dfd9;
  border-radius: 6px;
  color: #8a847c;
}
.activity-item[data-type="call"] .activity-icon { color: #22c55e; background: rgba(34,197,94,0.15); }
.activity-item[data-type="email"] .activity-icon { color: #3b82f6; background: rgba(59,130,246,0.15); }
.activity-item[data-type="meeting"] .activity-icon { color: #f59e0b; background: rgba(245,158,11,0.15); }
.activity-content {
  flex: 1;
  min-width: 0;
}
.activity-text {
  font-size: 0.95rem;
  color: #12100e;
  word-break: break-word;
}
.activity-time {
  font-size: 0.75rem;
  color: #8a847c;
  margin-top: 2px;
}
.activity-delete {
  position: absolute;
  top: 8px;
  right: 8px;
  background: none;
  border: none;
  color: #8a847c;
  cursor: pointer;
  font-size: 1rem;
  padding: 2px 6px;
  opacity: 0;
  transition: opacity 0.2s;
}
.activity-item:hover .activity-delete {
  opacity: 1;
}
.activity-delete:hover {
  color: #f87171;
}
.activity-empty {
  text-align: center;
  color: #8a847c;
  font-size: 0.9rem;
  padding: 20px;
}

.detail-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid #e9e7e2;
}
.detail-actions .action-btn {
  flex: 1;
}
.action-btn.danger {
  background: #7f1d1d;
  color: #fecaca;
}
.action-btn.danger:hover {
  background: #991b1b;
}

/* Toast */
#toast {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: #22c55e;
  color: white;
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 500;
  z-index: 1000;
  animation: slideUp 0.3s ease;
}
#toast.hidden { display: none; }
#toast.error { background: #ef4444; }
@keyframes slideUp {
  from { opacity: 0; transform: translateX(-50%) translateY(20px); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* Cropper Modal */
#cropper-modal {
  position: fixed;
  inset: 0;
  background: #ffffff;
  z-index: 200;
  display: flex;
  flex-direction: column;
}
#cropper-modal.hidden { display: none; }
.cropper-header {
  padding: 16px 20px;
  text-align: center;
  font-weight: 600;
  border-bottom: 1px solid #e9e7e2;
}
.cropper-container {
  flex: 1;
  position: relative;
  overflow: auto;
  -webkit-overflow-scrolling: touch;
}
#cropper-image {
  display: block;
  width: 100%;
  height: auto;
}
#crop-circle {
  position: absolute;
  left: 50px;
  top: 120px;
  width: 100px;
  height: 100px;
  border: 3px solid #fef08a;
  border-radius: 50%;
  cursor: move;
  touch-action: none;
  box-shadow: 0 0 0 9999px rgba(18,16,14,0.14);
}
.cropper-controls {
  padding: 16px 20px;
  border-top: 1px solid #e9e7e2;
}
.cropper-controls label {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
}
.cropper-controls input[type="range"] {
  flex: 1;
  height: 4px;
  -webkit-appearance: none;
  background: #eceae5;
  border-radius: 2px;
}
.cropper-controls input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 24px;
  height: 24px;
  background: #fef08a;
  border-radius: 50%;
  cursor: pointer;
}
.cropper-actions {
  display: flex;
  gap: 12px;
  padding: 16px 20px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom, 0));
}

/* Mobile adjustments */
/* Loading Overlay */
#loading-overlay {
  position: fixed;
  inset: 0;
  background: rgba(18,16,14,0.14);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  z-index: 500;
}
#loading-overlay.hidden { display: none; }
.loading-spinner {
  width: 48px;
  height: 48px;
  border: 4px solid #e9e7e2;
  border-top-color: #fef08a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
#loading-text {
  color: white;
  font-size: 16px;
  font-weight: 500;
}

@media (max-width: 480px) {
  .field-row { grid-template-columns: 1fr; }
  .profile-actions { gap: 8px; }
  .action-btn { padding: 12px 16px; }
}
</style>

<script>
  const SYNC_PASSWORD_KEY = 'stiki-sync-password';
  const STORAGE_KEY = 'stiki-notes-v2';
  const PDA_QUEUE_KEY = 'pda-queue';
  const WORKER_URL = 'https://levitate-sync.ben-6a6.workers.dev';

  interface Profile {
    name: string;
    role: string;
    company: string;
    linkedin: string;
  }

  interface Activity {
    id: string;
    timestamp: number;
    type: 'call' | 'email' | 'meeting' | 'note';
    text: string;
  }

  interface Note {
    id: string;
    text: string;
    color: string;
    x: number;
    y: number;
    rotation: number;
    createdAt: number;
    updatedAt: number;
    zIndex: number;
    isLead: boolean;
    quadrant: number;
    avatar?: string;
    name?: string;
    role?: string;
    company?: string;
    phone?: string;
    email?: string;
    website?: string;
    linkedin?: string;
    notes?: string;
    activity?: Activity[];
  }

  interface State {
    notes: Note[];
    nextZIndex: number;
    boardTitles?: string[];
  }

  let syncPassword: string | null = null;
  let queue: Profile[] = [];
  let currentIndex = 0;
  let currentMode: 'scan' | 'web' = 'scan';
  let selectedBoard = 0;
  let selectedWebBoard = 0;
  let capturedImage: string | null = null;
  let webCapturedImage: string | null = null;
  let webEnrichedData: { name: string; role: string; company: string; phone: string; email: string; website: string } | null = null;

  // Utility functions - defined early so they can be used anywhere
  function showToast(message: string, isError = false) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = message;
    toast.className = isError ? 'error' : '';
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 3000);
  }

  function showLoading(message: string) {
    const overlay = document.getElementById('loading-overlay');
    const text = document.getElementById('loading-text');
    if (!overlay || !text) return;
    text.textContent = message;
    overlay.classList.remove('hidden');
  }

  function hideLoading() {
    document.getElementById('loading-overlay')?.classList.add('hidden');
  }

  function escapeHtml(s: string): string {
    const div = document.createElement('div');
    div.textContent = s;
    return div.innerHTML;
  }

  // Auth
  function getSyncPassword(): string | null {
    return localStorage.getItem(SYNC_PASSWORD_KEY);
  }

  function checkAuth(): boolean {
    syncPassword = getSyncPassword();
    const loginGate = document.getElementById('login-gate')!;
    const app = document.getElementById('app')!;
    const headerName = document.getElementById('header-project-name');

    if (syncPassword && syncPassword.length >= 4) {
      loginGate.classList.add('hidden');
      app.classList.add('visible');
      loadQueue();
      // Update header title
      if (headerName) {
        headerName.textContent = syncPassword;
      }
      return true;
    } else {
      loginGate.classList.remove('hidden');
      app.classList.remove('visible');
      if (headerName) {
        headerName.textContent = 'No project';
      }
      (document.getElementById('password-input') as HTMLInputElement)?.focus();
      return false;
    }
  }

  function attemptLogin() {
    const input = document.getElementById('password-input') as HTMLInputElement;
    const error = document.getElementById('login-error')!;
    const pw = input.value;

    if (pw.length >= 4) {
      localStorage.setItem(SYNC_PASSWORD_KEY, pw);
      syncPassword = pw;
      checkAuth();
    } else {
      error.style.display = 'block';
      input.focus();
    }
  }

  document.getElementById('login-btn')?.addEventListener('click', attemptLogin);
  document.getElementById('password-input')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') attemptLogin();
  });

  // Queue persistence
  function saveQueue() {
    localStorage.setItem(PDA_QUEUE_KEY, JSON.stringify({ queue, currentIndex }));
  }

  function loadQueue() {
    const data = localStorage.getItem(PDA_QUEUE_KEY);
    if (data) {
      try {
        const parsed = JSON.parse(data);
        queue = parsed.queue || [];
        currentIndex = parsed.currentIndex || 0;
        if (queue.length > 0) {
          renderQueue();
          showCurrentProfile();
        }
      } catch { /* ignore */ }
    }
  }


  /* One form, two paths: a company URL wins, otherwise the search criteria
     are used. The enrich handler still reads #company-url and lives on a
     hidden button, so that flow is reused rather than reimplemented. */
  /* Web lookups run in the app and land in a list, rather than throwing you
     out to Safari. Tapping a website or company result drops its domain into
     the URL field; tapping a person copies their source link. */
  function domainOf(u: string): string {
    try { return new URL(u.startsWith('http') ? u : `https://${u}`).hostname.replace(/^www\./, ''); }
    catch { return u; }
  }

  function renderLookup(kind: string, results: Array<{ title: string; subtitle: string; url: string }>) {
    const box = document.getElementById('lookup-results')!;
    box.classList.remove('hidden');
    if (!results.length) {
      box.innerHTML = `<div class="lookup-empty">Nothing found. Try different words.</div>`;
      return;
    }
    box.innerHTML = `
      <div class="lookup-head">
        <span>${results.length} result${results.length === 1 ? '' : 's'}</span>
        <button class="lookup-close" aria-label="Close">&times;</button>
      </div>` + results.map((r, i) => `
        <button class="lookup-item" data-i="${i}">
          <span class="lookup-title">${r.title || domainOf(r.url)}</span>
          ${r.subtitle ? `<span class="lookup-sub">${r.subtitle}</span>` : ''}
          <span class="lookup-url">${domainOf(r.url)}</span>
        </button>`).join('');

    box.querySelector('.lookup-close')?.addEventListener('click', () => box.classList.add('hidden'));
    box.querySelectorAll('.lookup-item').forEach(el => {
      el.addEventListener('click', () => {
        const r = results[parseInt((el as HTMLElement).dataset.i || '0', 10)];
        if (!r) return;
        if (kind === 'people') {
          navigator.clipboard?.writeText(r.url).then(
            () => showToast('Link copied'),
            () => showToast(r.url),
          );
        } else {
          const input = document.getElementById('company-url') as HTMLInputElement;
          input.value = domainOf(r.url);
          syncFindButton();
          box.classList.add('hidden');
          input.scrollIntoView({ behavior: 'smooth', block: 'center' });
          showToast('URL filled in');
        }
      });
    });
  }

  document.querySelectorAll('.google-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || '';
      const kind = (btn as HTMLElement).dataset.g || 'website';
      const body = {
        kind,
        company: val('company-url'),
        location: val('criteria-location'),
        industry: val('criteria-industry'),
        role: val('criteria-role'),
      };

      if (kind === 'website' && !body.company) { showToast('Type a company name in the first field', true); return; }
      if (kind === 'people' && !body.role && !body.industry && !body.location) { showToast('Add a role, industry or location first', true); return; }
      if (kind === 'companies' && !body.industry && !body.location) { showToast('Add an industry or location first', true); return; }

      document.querySelectorAll('.google-btn').forEach(b => (b as HTMLButtonElement).disabled = true);
      btn.classList.add('loading');
      showLoading('Searching the web...');
      try {
        const res = await fetch(`${WORKER_URL}/lookup`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Sync-Password': syncPassword! },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        renderLookup(kind, data.results || []);
      } catch {
        showToast('Search failed', true);
      } finally {
        hideLoading();
        btn.classList.remove('loading');
        document.querySelectorAll('.google-btn').forEach(b => (b as HTMLButtonElement).disabled = false);
      }
    });
  });

  function urlFieldValue(): string {
    return (document.getElementById('company-url') as HTMLInputElement)?.value.trim() || '';
  }

  /* Called when an already-selected board dot is clicked. It was referenced
     but never defined - harmless while the Scan/Web toggle offered a way
     back to the form, but a dead end now that it is gone. */
  document.getElementById('back-to-search')?.addEventListener('click', deselectBoardView);

  function deselectBoardView() {
    selectedBoardView = null;
    document.querySelectorAll('.board-dot[data-board]').forEach(d => d.classList.remove('active'));
    document.getElementById('back-to-search')?.classList.add('active');
    document.getElementById('board-view')?.classList.add('hidden');
    backToFindForm();
  }

  function backToFindForm() {
    currentMode = 'scan';
    document.querySelectorAll('.mode-content').forEach(c => c.classList.remove('active'));
    document.getElementById('scan-mode')?.classList.add('active');
  }

  function syncFindButton() {
    const label = document.querySelector('#gimme-btn .btn-text');
    if (label) label.textContent = urlFieldValue() ? 'Look up company' : 'Find leads';
    document.getElementById('criteria-form')?.classList.toggle('url-mode', !!urlFieldValue());
  }
  document.getElementById('company-url')?.addEventListener('input', syncFindButton);
  syncFindButton();

  // Find leads / Look up company
  document.getElementById('gimme-btn')?.addEventListener('click', async () => {
    if (urlFieldValue()) {
      // hand over to the enrich flow, which owns the web-* panels
      currentMode = 'web';
      document.querySelectorAll('.mode-content').forEach(c => c.classList.remove('active'));
      document.getElementById('web-mode')?.classList.add('active');
      (document.getElementById('enrich-btn') as HTMLButtonElement).click();
      return;
    }

    const btn = document.getElementById('gimme-btn') as HTMLButtonElement;
    const location = (document.getElementById('criteria-location') as HTMLInputElement).value;
    const industry = (document.getElementById('criteria-industry') as HTMLInputElement).value;
    const role = (document.getElementById('criteria-role') as HTMLInputElement).value;

    console.log('Find leads clicked', { location, industry, role, syncPassword });
    btn.classList.add('loading');
    btn.disabled = true;
    showLoading('Searching for leads...');

    try {
      const res = await fetch(`${WORKER_URL}/search`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Sync-Password': syncPassword!,
        },
        body: JSON.stringify({ location, industry, role }),
      });

      const data = await res.json();
      console.log('Search response:', data);

      hideLoading();
      if (data.profiles && data.profiles.length > 0) {
        queue = data.profiles;
        currentIndex = -1; // No selection initially
        saveQueue();
        renderQueue();
        // Don't show profile automatically - wait for user to tap one
        document.getElementById('current-profile')?.classList.add('hidden');
        showToast(`Found ${queue.length} profiles!`);
      } else {
        showToast('No profiles found', true);
      }
    } catch (e) {
      hideLoading();
      console.error('Search error:', e);
      showToast('Search failed', true);
    } finally {
      btn.classList.remove('loading');
      btn.disabled = false;
    }
  });

  function renderQueue() {
    const section = document.getElementById('queue-section')!;
    const list = document.getElementById('queue-list')!;
    const count = document.getElementById('queue-count')!;

    if (queue.length === 0) {
      section.classList.add('hidden');
      return;
    }

    section.classList.remove('hidden');
    count.textContent = `${queue.length} profiles`;
    list.innerHTML = '';

    queue.forEach((profile, i) => {
      const item = document.createElement('div');
      item.className = `queue-item ${i === currentIndex ? 'active' : ''}`;
      item.innerHTML = `
        <div class="queue-item-info">
          <div class="queue-item-name">${escapeHtml(profile.name)}</div>
          <div class="queue-item-company">${escapeHtml(profile.company)}</div>
        </div>
      `;
      item.addEventListener('click', () => {
        currentIndex = i;
        saveQueue();
        renderQueue();
        showCurrentProfile();
      });
      list.appendChild(item);
    });
  }

  function showCurrentProfile() {
    const profileSection = document.getElementById('current-profile')!;
    const captureSection = document.getElementById('photo-capture')!;
    const previewSection = document.getElementById('lead-preview')!;

    if (currentIndex < 0 || currentIndex >= queue.length) {
      profileSection.classList.add('hidden');
      captureSection.classList.add('hidden');
      previewSection.classList.add('hidden');
      return;
    }

    const profile = queue[currentIndex];
    document.getElementById('profile-name')!.textContent = profile.name;
    document.getElementById('profile-role')!.textContent = profile.role;
    document.getElementById('profile-company')!.textContent = profile.company;

    profileSection.classList.remove('hidden');
    captureSection.classList.add('hidden');
    previewSection.classList.add('hidden');
  }

  // Clear queue
  document.getElementById('clear-queue')?.addEventListener('click', () => {
    queue = [];
    currentIndex = 0;
    saveQueue();
    renderQueue();
    document.getElementById('current-profile')!.classList.add('hidden');
    document.getElementById('photo-capture')!.classList.add('hidden');
    document.getElementById('lead-preview')!.classList.add('hidden');
  });

  // View LinkedIn
  document.getElementById('view-linkedin')?.addEventListener('click', async () => {
    if (currentIndex >= queue.length) return;
    const profile = queue[currentIndex];

    // Copy name to clipboard for pasting in LinkedIn app
    const searchText = `${profile.name} ${profile.company}`;
    try {
      await navigator.clipboard.writeText(searchText);
      showToast('Copied! Paste in LinkedIn search');
      // Open LinkedIn app
      window.location.href = 'linkedin://search';
    } catch {
      // Fallback to Google search
      const googleUrl = `https://www.google.com/search?q=${encodeURIComponent(searchText + ' LinkedIn')}`;
      window.open(googleUrl, '_blank');
    }
  });

  // Add Lead
  document.getElementById('add-lead')?.addEventListener('click', () => {
    document.getElementById('current-profile')!.classList.add('hidden');
    document.getElementById('photo-capture')!.classList.remove('hidden');
    capturedImage = null;
  });

  // Skip - remove from queue and go back to list
  document.getElementById('skip-profile')?.addEventListener('click', () => {
    queue.splice(currentIndex, 1);
    currentIndex = -1;
    saveQueue();
    renderQueue();
    document.getElementById('current-profile')?.classList.add('hidden');
    showToast('Skipped');
  });

  // Photo selection
  document.getElementById('select-photo')?.addEventListener('click', () => {
    document.getElementById('photo-input')?.click();
  });

  document.getElementById('cancel-capture')?.addEventListener('click', () => {
    document.getElementById('photo-capture')!.classList.add('hidden');
    showCurrentProfile();
  });

  // Cropper state
  let rawImage: string | null = null;
  let cropX = 50;
  let cropY = 120;
  let cropSize = 100;
  let isDragging = false;
  let dragStart = { x: 0, y: 0, cropX: 0, cropY: 0 };
  let scannedData: { name?: string; role?: string; company?: string; phone?: string; email?: string; website?: string } = {};

  const cropCircle = document.getElementById('crop-circle');
  const cropSizeInput = document.getElementById('crop-size') as HTMLInputElement | null;
  const cropperModal = document.getElementById('cropper-modal');
  const cropperImage = document.getElementById('cropper-image') as HTMLImageElement | null;

  function updateCropCircle() {
    if (!cropCircle) return;
    cropCircle.style.left = `${cropX}px`;
    cropCircle.style.top = `${cropY}px`;
    cropCircle.style.width = `${cropSize}px`;
    cropCircle.style.height = `${cropSize}px`;
  }

  cropSizeInput?.addEventListener('input', () => {
    cropSize = parseInt(cropSizeInput.value);
    updateCropCircle();
  });

  cropCircle?.addEventListener('touchstart', (e) => {
    e.preventDefault();
    isDragging = true;
    const touch = e.touches[0];
    dragStart = { x: touch.clientX, y: touch.clientY, cropX, cropY };
  });

  cropCircle?.addEventListener('mousedown', (e) => {
    e.preventDefault();
    isDragging = true;
    dragStart = { x: e.clientX, y: e.clientY, cropX, cropY };
  });

  document.addEventListener('touchmove', (e) => {
    if (!isDragging) return;
    const touch = e.touches[0];
    cropX = Math.max(0, dragStart.cropX + touch.clientX - dragStart.x);
    cropY = Math.max(0, dragStart.cropY + touch.clientY - dragStart.y);
    updateCropCircle();
  });

  document.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    cropX = Math.max(0, dragStart.cropX + e.clientX - dragStart.x);
    cropY = Math.max(0, dragStart.cropY + e.clientY - dragStart.y);
    updateCropCircle();
  });

  document.addEventListener('touchend', () => isDragging = false);
  document.addEventListener('mouseup', () => isDragging = false);

  document.getElementById('cancel-crop')?.addEventListener('click', () => {
    cropperModal?.classList.add('hidden');
    rawImage = null;
    // Return to the appropriate capture screen based on mode
    if (currentMode === 'web') {
      document.getElementById('web-photo-capture')?.classList.remove('hidden');
