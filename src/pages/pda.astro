      });

      if (!res.ok) {
        cardsEl.innerHTML = '';
        emptyEl.classList.remove('hidden');
        titleEl.value = '';
        return;
      }

      const data = await res.json();
      const notes: Note[] = Array.isArray(data.notes) ? data.notes : [];

      // Load board titles from cloud
      if (Array.isArray(data.boardTitles)) {
        boardTitles = data.boardTitles.map((t: string, i: number) => t || DEFAULT_TITLES[i]);
      }
      titleEl.value = boardTitles[board] || DEFAULT_TITLES[board];

      // Filter by board (quadrant) and sort by newest first
      currentBoardNotes = notes
        .filter(n => n.quadrant === board && n.isLead)
        .sort((a, b) => b.createdAt - a.createdAt);

      renderBoardCards();
    } catch (e) {
      cardsEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      titleEl.value = '';
      showToast('Failed to load cards', true);
    }
  }

  function renderBoardCards() {
    const cardsEl = document.getElementById('board-cards')!;
    const emptyEl = document.getElementById('board-empty')!;

    if (currentBoardNotes.length === 0) {
      cardsEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    cardsEl.innerHTML = currentBoardNotes.map(note => `
      <div class="card-item" data-id="${note.id}">
        <div class="card-avatar">
          ${note.avatar
            ? `<img src="${note.avatar}" alt="" />`
            : `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>`
          }
        </div>
        <div class="card-info">
          <div class="card-name">${escapeHtml(note.name || note.text.split('\n')[0])}</div>
          <div class="card-meta">${escapeHtml(note.role || '')}${note.role && note.company ? ' @ ' : ''}${escapeHtml(note.company || '')}</div>
        </div>
      </div>
    `).join('');

    // Add click handlers
    cardsEl.querySelectorAll('.card-item').forEach(item => {
      item.addEventListener('click', () => {
        const id = (item as HTMLElement).dataset.id;
        const note = currentBoardNotes.find(n => n.id === id);
        if (note) openCardDetail(note);
      });
    });
  }

  function openCardDetail(note: Note) {
    editingNote = note;
    editingNoteBoard = note.quadrant;
    editingActivities = note.activity ? [...note.activity] : [];

    // Populate fields
    const avatarEl = document.getElementById('detail-avatar')!;
    if (note.avatar) {
      avatarEl.innerHTML = `<img src="${note.avatar}" alt="" />`;
    } else {
      avatarEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>';
    }

    (document.getElementById('detail-name') as HTMLInputElement).value = note.name || '';
    (document.getElementById('detail-role') as HTMLInputElement).value = note.role || '';
    (document.getElementById('detail-company') as HTMLInputElement).value = note.company || '';
    (document.getElementById('detail-phone') as HTMLInputElement).value = note.phone || '';
    (document.getElementById('detail-email') as HTMLInputElement).value = note.email || '';
    (document.getElementById('detail-website') as HTMLInputElement).value = note.website || '';
    (document.getElementById('detail-notes') as HTMLTextAreaElement).value = note.notes || '';

    // Set board picker with custom titles
    document.querySelectorAll('#detail-board-picker .board-opt').forEach(opt => {
      const boardIdx = parseInt((opt as HTMLElement).dataset.board || '0');
      opt.classList.remove('active');
      (opt as HTMLElement).title = boardTitles[boardIdx] || DEFAULT_TITLES[boardIdx];
      if (boardIdx === note.quadrant) {
        opt.classList.add('active');
      }
    });
    updateSelectedBoardName();

    // Reset activity input
    document.getElementById('activity-input')?.classList.add('hidden');
    (document.getElementById('activity-text') as HTMLInputElement).value = '';
    document.querySelectorAll('.activity-type-btn').forEach(b => b.classList.remove('active'));

    // Render activities
    renderActivities();

    document.getElementById('card-detail-modal')?.classList.remove('hidden');
  }

  function renderActivities() {
    const listEl = document.getElementById('activity-list')!;

    if (editingActivities.length === 0) {
      listEl.innerHTML = '<div class="activity-empty">No activity yet</div>';
      return;
    }

    // Sort by newest first
    const sorted = [...editingActivities].sort((a, b) => b.timestamp - a.timestamp);

    listEl.innerHTML = sorted.map(act => `
      <div class="activity-item" data-id="${act.id}" data-type="${act.type}">
        <span class="activity-icon">${ACTIVITY_ICONS[act.type] || '📝'}</span>
        <div class="activity-content">
          <div class="activity-text">${escapeHtml(act.text)}</div>
          <div class="activity-time">${formatActivityTime(act.timestamp)}</div>
        </div>
        <button class="activity-delete" data-id="${act.id}" title="Delete">✕</button>
      </div>
    `).join('');

    // Add delete handlers
    listEl.querySelectorAll('.activity-delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = (btn as HTMLElement).dataset.id;
        editingActivities = editingActivities.filter(a => a.id !== id);
        renderActivities();
      });
    });
  }

  function formatActivityTime(timestamp: number): string {
    const now = Date.now();
    const diff = now - timestamp;
    const mins = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    const days = Math.floor(diff / 86400000);

    if (mins < 1) return 'Just now';
    if (mins < 60) return `${mins}m ago`;
    if (hours < 24) return `${hours}h ago`;
    if (days < 7) return `${days}d ago`;

    const date = new Date(timestamp);
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function updateSelectedBoardName() {
    const nameEl = document.getElementById('selected-board-name');
    if (nameEl) {
      nameEl.textContent = boardTitles[editingNoteBoard] || DEFAULT_TITLES[editingNoteBoard];
    }
  }

  // Activity type buttons
  document.querySelectorAll('.activity-type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = (btn as HTMLElement).dataset.type as 'call' | 'email' | 'meeting' | 'note';
      currentActivityType = type;

      // Highlight selected type
      document.querySelectorAll('.activity-type-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Show input
      const inputEl = document.getElementById('activity-input')!;
      const textEl = document.getElementById('activity-text') as HTMLInputElement;
      inputEl.classList.remove('hidden');
      textEl.placeholder = `Add ${type}...`;
      textEl.focus();
    });
  });

  // Add activity
  document.getElementById('activity-add')?.addEventListener('click', () => {
    const textEl = document.getElementById('activity-text') as HTMLInputElement;
    const text = textEl.value.trim();

    if (!text) {
      showToast('Please enter a note', true);
      return;
    }

    const activity: Activity = {
      id: `act-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      timestamp: Date.now(),
      type: currentActivityType,
      text,
    };

    editingActivities.push(activity);
    renderActivities();

    // Reset input
    textEl.value = '';
    document.getElementById('activity-input')?.classList.add('hidden');
    document.querySelectorAll('.activity-type-btn').forEach(b => b.classList.remove('active'));
  });

  // Cancel activity input
  document.getElementById('activity-cancel')?.addEventListener('click', () => {
    document.getElementById('activity-input')?.classList.add('hidden');
    (document.getElementById('activity-text') as HTMLInputElement).value = '';
    document.querySelectorAll('.activity-type-btn').forEach(b => b.classList.remove('active'));
  });

  // Enter key to add activity
  document.getElementById('activity-text')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      document.getElementById('activity-add')?.click();
    }
  });

  // Board picker in detail modal
  document.querySelectorAll('#detail-board-picker .board-opt').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('#detail-board-picker .board-opt').forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
      editingNoteBoard = parseInt((opt as HTMLElement).dataset.board || '0');
      updateSelectedBoardName();
    });
  });

  // Close detail modal
  document.getElementById('close-detail')?.addEventListener('click', () => {
    document.getElementById('card-detail-modal')?.classList.add('hidden');
    editingNote = null;
  });

  // Save detail
  document.getElementById('detail-save')?.addEventListener('click', async () => {
    if (!editingNote) return;

    const name = (document.getElementById('detail-name') as HTMLInputElement).value;
    const role = (document.getElementById('detail-role') as HTMLInputElement).value;
    const company = (document.getElementById('detail-company') as HTMLInputElement).value;
    const phone = (document.getElementById('detail-phone') as HTMLInputElement).value;
    const email = (document.getElementById('detail-email') as HTMLInputElement).value;
    const website = (document.getElementById('detail-website') as HTMLInputElement).value;
    const notes = (document.getElementById('detail-notes') as HTMLTextAreaElement).value;

    if (!name.trim()) {
      showToast('Name is required', true);
      return;
    }

    showLoading('Saving...');

    try {
      // Load current state
      const res = await fetch(WORKER_URL, {
        method: 'GET',
        headers: { 'X-Sync-Password': syncPassword! },
      });

      if (!res.ok) throw new Error('Failed to load data');

      const data = await res.json();
      const state: State = {
        notes: Array.isArray(data.notes) ? data.notes : [],
        nextZIndex: data.nextZIndex || 1,
        boardTitles: Array.isArray(data.boardTitles) ? data.boardTitles : boardTitles,
      };

      // Find and update the note
      const noteIndex = state.notes.findIndex(n => n.id === editingNote!.id);
      if (noteIndex === -1) throw new Error('Note not found');

      // Update display text
      let displayText = name;
      if (role) displayText += `\n${role}`;
      if (company && company !== name) displayText += `\n${company}`;

      // Get new color based on board
      const colors = ['#fed7aa', '#fef08a', '#bbf7d0', '#93c5fd', '#c7d2fe', '#ddd6fe'];

      state.notes[noteIndex] = {
        ...state.notes[noteIndex],
        name,
        role,
        company,
        phone,
        email,
        website,
        notes,
        activity: editingActivities,
        text: displayText,
        quadrant: editingNoteBoard,
        color: colors[editingNoteBoard],
        updatedAt: Date.now(),
      };

      // Save to cloud
      const saveRes = await fetch(WORKER_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Sync-Password': syncPassword!,
        },
        body: JSON.stringify(state),
      });

      if (!saveRes.ok) throw new Error('Failed to save');

      hideLoading();
      showToast('Saved!');
      document.getElementById('card-detail-modal')?.classList.add('hidden');
      editingNote = null;

      // Reload board view
      if (selectedBoardView !== null) {
        await loadBoardCards(selectedBoardView);
      }
    } catch (e) {
      hideLoading();
      showToast('Error: ' + (e instanceof Error ? e.message : String(e)), true);
    }
  });

  // Delete card
  document.getElementById('detail-delete')?.addEventListener('click', async () => {
    if (!editingNote) return;

    if (!confirm('Delete this lead?')) return;

    showLoading('Deleting...');

    try {
      // Load current state
      const res = await fetch(WORKER_URL, {
        method: 'GET',
        headers: { 'X-Sync-Password': syncPassword! },
      });

      if (!res.ok) throw new Error('Failed to load data');

      const data = await res.json();
      const state: State = {
        notes: Array.isArray(data.notes) ? data.notes : [],
        nextZIndex: data.nextZIndex || 1,
        boardTitles: Array.isArray(data.boardTitles) ? data.boardTitles : boardTitles,
      };

      // Remove the note
      state.notes = state.notes.filter(n => n.id !== editingNote!.id);

      // Save to cloud
      const saveRes = await fetch(WORKER_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Sync-Password': syncPassword!,
        },
        body: JSON.stringify(state),
      });

      if (!saveRes.ok) throw new Error('Failed to save');

      hideLoading();
      showToast('Deleted');
      document.getElementById('card-detail-modal')?.classList.add('hidden');
      editingNote = null;

      // Reload board view
      if (selectedBoardView !== null) {
        await loadBoardCards(selectedBoardView);
      }
    } catch (e) {
      hideLoading();
      showToast('Error: ' + (e instanceof Error ? e.message : String(e)), true);
    }
  });

  // Settings modal
  const settingsModal = document.getElementById('settings-modal')!;

  function updateCurrentProjectDisplay(flash = false) {
    const projectName = getSyncPassword();
    const nameEl = document.getElementById('current-project-name')!;
    const headerName = document.getElementById('header-project-name')!;

    if (projectName) {
      nameEl.textContent = projectName;
      nameEl.classList.remove('no-project');
      headerName.textContent = projectName;
    } else {
      nameEl.textContent = 'No project (local only)';
      nameEl.classList.add('no-project');
      headerName.textContent = 'No project';
    }

    if (flash && projectName) {
      headerName.classList.remove('flash');
      void headerName.offsetWidth; // Force reflow
      headerName.classList.add('flash');
    }
  }

  document.getElementById('settings-btn')?.addEventListener('click', () => {
    settingsModal.classList.remove('hidden');
    updateCurrentProjectDisplay();
    (document.getElementById('switch-project-input') as HTMLInputElement).value = '';
  });
  document.getElementById('close-settings')?.addEventListener('click', () => {
    settingsModal.classList.add('hidden');
  });
  settingsModal.addEventListener('click', e => {
    if (e.target === settingsModal) settingsModal.classList.add('hidden');
  });

  document.getElementById('switch-project-btn')?.addEventListener('click', () => {
    const input = document.getElementById('switch-project-input') as HTMLInputElement;
    const btn = document.getElementById('switch-project-btn') as HTMLButtonElement;
    const newProject = input.value.trim();

    if (!newProject || newProject.length < 4) {
      showToast('Project name must be at least 4 characters', true);
      return;
    }

    const currentProject = getSyncPassword();

    // Don't switch if same project
    if (newProject === currentProject) {
      settingsModal.classList.add('hidden');
      return;
    }

    try {
      // Immediate button feedback
      btn.textContent = 'Switching...';
      btn.disabled = true;

      // Set new project password
      localStorage.setItem(SYNC_PASSWORD_KEY, newProject);
      syncPassword = newProject;

      // Clear local queue
      localStorage.removeItem(PDA_QUEUE_KEY);
      queue = [];

      // Close modal
      settingsModal.classList.add('hidden');

      // Reset button
      btn.textContent = 'Switch Project';
      btn.disabled = false;

      // Show success overlay
      const successOverlay = document.getElementById('switch-success');
      const successName = document.getElementById('switch-success-name');
      if (successOverlay && successName) {
        successName.textContent = newProject;
        successOverlay.classList.remove('hidden', 'fade-out');

        // Auto-hide
        setTimeout(() => {
          successOverlay.classList.add('fade-out');
          setTimeout(() => successOverlay.classList.add('hidden'), 300);
        }, 1200);
      }

      // Update header
      const headerName = document.getElementById('header-project-name');
      if (headerName) headerName.textContent = newProject;

    } catch (e) {
      console.error('Switch error:', e);
      btn.textContent = 'Switch Project';
      btn.disabled = false;
      settingsModal.classList.add('hidden');
      showToast('Switched to ' + newProject);
    }
  });

  document.getElementById('export-data')?.addEventListener('click', async () => {
    try {
      const res = await fetch(WORKER_URL, {
        method: 'GET',
        headers: { 'X-Sync-Password': syncPassword! },
      });
      if (res.ok) {
        const data = await res.json();
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `stiki-${getSyncPassword()}-${new Date().toISOString().split('T')[0]}.json`;
        a.click();
        URL.revokeObjectURL(url);
      }
    } catch (e) {
      showToast('Export failed', true);
    }
  });

  document.getElementById('import-data')?.addEventListener('click', () => {
    document.getElementById('import-file')?.click();
  });

  document.getElementById('import-file')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    try {
      const text = await file.text();
      const data = JSON.parse(text);

      showLoading();
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Sync-Password': syncPassword!,
        },
        body: JSON.stringify(data),
      });

      hideLoading();
      if (res.ok) {
        showToast('Data imported successfully');
        if (selectedBoardView !== null) {
          await loadBoardCards(selectedBoardView);
        }
      } else {
        showToast('Import failed', true);
      }
    } catch (e) {
      hideLoading();
      showToast('Invalid file format', true);
    }
    (e.target as HTMLInputElement).value = '';
  });

  // Init
  checkAuth();
</script>
</body>
</html>
