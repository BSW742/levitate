  document.querySelectorAll('#play-modal .modal-close').forEach(b =>
    b.addEventListener('click', () => {
      document.getElementById('play-modal')!.classList.remove('visible');
      editingPlay = null;
    }));

  // ============ LINKEDIN ACTIVITY ============
  /* LinkedIn answers every automated request with a 999, so the only lawful
     way to know when someone last posted is your own logged-in browser:
     screenshot their activity, paste it here, and Claude Vision reads the
     relative age LinkedIn already prints next to the post. */
  const AGO_UNITS: Record<string, number> = {
    m: 60000, h: 3600000, d: 86400000, w: 604800000, mo: 2592000000, yr: 31536000000,
  };

  function agoToTimestamp(ago: string): number | undefined {
    const m = (ago || '').trim().toLowerCase().match(/^(\d+)\s*(mo|yr|[mhdw])/);
    if (!m) return undefined;
    const unit = AGO_UNITS[m[2]];
    return unit ? Date.now() - parseInt(m[1], 10) * unit : undefined;
  }

  function describeAge(ts: number): string {
    const d = Math.floor((Date.now() - ts) / 86400000);
    if (d <= 0) return 'today';
    if (d === 1) return 'yesterday';
    if (d < 7) return `${d}d ago`;
    if (d < 31) return `${Math.floor(d / 7)}w ago`;
    if (d < 365) return `${Math.floor(d / 30)}mo ago`;
    return `${Math.floor(d / 365)}yr ago`;
  }

  function shrinkImage(dataUrl: string, maxEdge = 1400, quality = 0.75): Promise<string> {
    return new Promise(resolve => {
      const img = new Image();
      img.onload = () => {
        const scale = Math.min(1, maxEdge / Math.max(img.width, img.height));
        if (scale === 1 && dataUrl.length < 700000) return resolve(dataUrl);
        const c = document.createElement('canvas');
        c.width = Math.round(img.width * scale);
        c.height = Math.round(img.height * scale);
        const ctx = c.getContext('2d');
        if (!ctx) return resolve(dataUrl);
        ctx.drawImage(img, 0, 0, c.width, c.height);
        resolve(c.toDataURL('image/jpeg', quality));
      };
      img.onerror = () => resolve(dataUrl);
      img.src = dataUrl;
    });
  }

  function renderLastPost(n: Note | undefined) {
    const el = document.getElementById('li-act-value');
    if (!el) return;
    if (!n?.lastPostAt) { el.textContent = '—'; el.className = 'li-act-value'; return; }
    const days = Math.floor((Date.now() - n.lastPostAt) / 86400000);
    el.textContent = describeAge(n.lastPostAt) + (n.lastPostNote ? ` · ${n.lastPostNote}` : '');
    el.className = `li-act-value ${days <= 7 ? 'fresh' : days <= 30 ? 'ok' : 'stale'}`;
  }

  async function readActivityShot(dataUrl: string) {
    if (!detailNoteId) return;
    const note = state.notes.find(n => n.id === detailNoteId);
    const el = document.getElementById('li-act-value');
    if (!note || !el) return;
    el.textContent = 'Reading...';
    el.className = 'li-act-value';
    try {
      const img = await shrinkImage(dataUrl);
      const res = await fetch(`${WORKER_URL}/scan-activity`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Sync-Password': getSyncPassword() || '' },
        body: JSON.stringify({ image: img }),
      });
      const d = await res.json();
      const ts = d.ago ? agoToTimestamp(d.ago) : undefined;
      if (!ts) { el.textContent = 'No post found in that image'; return; }
      note.lastPostAt = ts;
      note.lastPostNote = [d.kind && d.kind !== 'post' ? d.kind : '', d.topic].filter(Boolean).join(' · ').slice(0, 80);
      note.updatedAt = Date.now();
      addPlayActivity(note, `Last LinkedIn ${d.kind || 'post'} ${d.ago}${d.topic ? ` - ${d.topic}` : ''}`, 'linkedin');
      save();
      renderLastPost(note);
      renderActivities();
    } catch {
      el.textContent = 'Could not read that image';
    }
  }

  function handleActivityFile(f: File) {
    const r = new FileReader();
    r.onload = ev => readActivityShot(ev.target?.result as string);
    r.readAsDataURL(f);
  }

  document.getElementById('li-act-check')?.addEventListener('click', () => document.getElementById('li-act-file')?.click());
  document.getElementById('li-act-file')?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.files?.[0]) handleActivityFile(input.files[0]);
    input.value = '';
  });
  // paste a screenshot straight into an open lead
  document.addEventListener('paste', (e) => {
    if (!detailNoteId) return;
    if (!document.getElementById('detail-modal')?.classList.contains('visible')) return;
    const item = [...((e as ClipboardEvent).clipboardData?.items || [])].find(i => i.type.startsWith('image/'));
    const f = item?.getAsFile();
    if (!f) return;
    e.preventDefault();
    handleActivityFile(f);
  });

  // ============ DEALS ============
  /* Where the work gets quoted. Every quote lives behind a URL and a login,
     so the card is a key first and a record second: one action opens the
     quote with the password already on your clipboard. */
  function getDeals(): Deal[] {
    if (!state.deals) state.deals = [];
    return state.deals;
  }

  const money = (v?: number) => v
    ? '$' + Math.round(v).toLocaleString('en-NZ')
    : '—';

  const capexOf = (d: Deal) => d.capex ?? d.value ?? 0;   // legacy deals carried one figure
  const ongoingOf = (d: Deal) => d.ongoing ?? 0;

  /* Two totals, because they are different money: a one-off build and the
     monthly line that actually moves a recurring revenue goal. */
  function dealTotals(list: Deal[]) {
    return {
      capex: list.reduce((t, d) => t + capexOf(d), 0),
      ongoing: list.reduce((t, d) => t + ongoingOf(d), 0),
    };
  }
  function totalsHtml(list: Deal[]) {
    const t = dealTotals(list);
    return `${t.capex ? money(t.capex) : ''}${t.capex && t.ongoing ? ' + ' : ''}${t.ongoing ? money(t.ongoing) + '/mo' : ''}` || '—';
  }

  /* In play is talking, quoted is a number sent. The quote date decides,
     so there is no status field to keep honest - either a quote went out
     on a day, or it has not. */
  function dealState(d: Deal): 'won' | 'lost' | 'quoted' | 'inplay' {
    if (d.wonAt) return 'won';
    if (d.lostAt) return 'lost';
    return d.sentAt ? 'quoted' : 'inplay';
  }

  let editingDeal: Deal | null = null;

  function openDealModal(id?: string) {
    const deals = getDeals();
    editingDeal = id
      ? JSON.parse(JSON.stringify(deals.find(d => d.id === id))) as Deal
      : { id: `deal-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`, title: '', createdAt: Date.now() };

    const v = (el: string, val: string) => { (document.getElementById(el) as HTMLInputElement).value = val; };
    (document.getElementById('deal-modal-title') as HTMLElement).textContent = id ? 'Edit Deal' : 'New Deal';
    v('deal-title', editingDeal.title || '');
    v('deal-capex', capexOf(editingDeal) ? String(capexOf(editingDeal)) : '');
    v('deal-ongoing', editingDeal.ongoing != null ? String(editingDeal.ongoing) : '');
    v('deal-url', editingDeal.url || '');
    v('deal-username', editingDeal.username || '');
    v('deal-password', editingDeal.password || '');
    v('deal-sent', editingDeal.sentAt ? new Date(editingDeal.sentAt).toISOString().slice(0, 10) : '');

    const people = state.notes.filter(n => n.isLead).sort((a, b) => (a.name || '').localeCompare(b.name || ''));
    (document.getElementById('deal-person') as HTMLSelectElement).innerHTML =
      `<option value="">No person</option>` + people.map(p =>
        `<option value="${p.id}" ${p.id === editingDeal!.personId ? 'selected' : ''}>${escapeHtml(p.name || noteHeadline(p))}${p.company ? ` — ${escapeHtml(p.company)}` : ''}</option>`).join('');
    (document.getElementById('deal-goal') as HTMLSelectElement).innerHTML =
      `<option value="">No goal</option>` + getGoals().map(g =>
        `<option value="${g.id}" ${g.id === editingDeal!.goalId ? 'selected' : ''}>${escapeHtml((g.text || 'Untitled goal').split('\n')[0])}</option>`).join('');

    (document.getElementById('deal-delete') as HTMLElement).style.display = id ? '' : 'none';
    document.getElementById('deal-modal')!.classList.add('visible');
  }

  document.getElementById('add-deal')?.addEventListener('click', () => openDealModal());
  document.getElementById('add-opp')?.addEventListener('click', () => openDealModal());
  document.querySelectorAll('#deal-modal .modal-close').forEach(b =>
    b.addEventListener('click', () => { document.getElementById('deal-modal')!.classList.remove('visible'); editingDeal = null; }));

  document.getElementById('deal-save')?.addEventListener('click', () => {
    if (!editingDeal) return;
    const g = (el: string) => (document.getElementById(el) as HTMLInputElement).value.trim();
    editingDeal.title = g('deal-title') || 'Untitled deal';
    const cx = parseFloat(g('deal-capex')); const og = parseFloat(g('deal-ongoing'));
    editingDeal.capex = isNaN(cx) ? undefined : cx;
    editingDeal.ongoing = isNaN(og) ? undefined : og;
    delete editingDeal.value;   // folded into capex
    editingDeal.url = g('deal-url') || undefined;
    editingDeal.username = g('deal-username') || undefined;
    editingDeal.password = g('deal-password') || undefined;
    editingDeal.personId = (document.getElementById('deal-person') as HTMLSelectElement).value || undefined;
    editingDeal.goalId = (document.getElementById('deal-goal') as HTMLSelectElement).value || undefined;
    const sent = g('deal-sent');
    editingDeal.sentAt = sent ? new Date(sent + 'T00:00:00').getTime() : undefined;

    const deals = getDeals();
    const i = deals.findIndex(d => d.id === editingDeal!.id);
    if (i >= 0) deals[i] = editingDeal; else deals.push(editingDeal);
    save();
    document.getElementById('deal-modal')!.classList.remove('visible');
    editingDeal = null;
    refreshView();
  });

  document.getElementById('deal-delete')?.addEventListener('click', () => {
    if (!editingDeal || !confirm(`Delete "${editingDeal.title}"?`)) return;
    tombstone(editingDeal.id);
    state.deals = getDeals().filter(d => d.id !== editingDeal!.id);
    save();
    document.getElementById('deal-modal')!.classList.remove('visible');
    editingDeal = null;
    refreshView();
  });

  function setDealOutcome(id: string, outcome: 'won' | 'lost' | 'quoted' | 'inplay') {
    const d = getDeals().find(x => x.id === id);
    if (!d) return;
    d.wonAt = outcome === 'won' ? Date.now() : undefined;
    d.lostAt = outcome === 'lost' ? Date.now() : undefined;
    if (outcome === 'quoted' && !d.sentAt) d.sentAt = Date.now();
    if (outcome === 'inplay') d.sentAt = undefined;
    const person = d.personId ? state.notes.find(n => n.id === d.personId) : undefined;
    if (person) addPlayActivity(person, outcome === 'inplay' ? `Back to in play: ${d.title}`
      : outcome === 'quoted' ? `Quote sent: ${d.title}` : `Quote ${outcome}: ${d.title} (${totalsHtml([d])})`);
    save();
    refreshView();   // Deals or Funnel, whichever is open
  }

  /* The point of the whole view: get into the quote without hunting for a
     password. Copy first, then open, so the paste is ready when the login is. */
  async function openQuote(id: string) {
    const d = getDeals().find(x => x.id === id);
    if (!d?.url) return;
    if (d.password) { try { await navigator.clipboard.writeText(d.password); } catch { /* no clipboard, just open */ } }
    window.open(d.url.startsWith('http') ? d.url : `https://${d.url}`, '_blank', 'noopener');
    const el = document.querySelector(`.deal[data-id="${id}"] .deal-open span`) as HTMLElement;
    if (el && d.password) { el.textContent = 'Password copied'; setTimeout(() => { el.textContent = 'Open quote'; }, 2200); }
  }

  function dealCardHtml(d: Deal): string {
    const person = d.personId ? state.notes.find(n => n.id === d.personId) : undefined;
    const goal = d.goalId ? getGoals().find(g => g.id === d.goalId) : undefined;
    const st = dealState(d);
    const host = (() => { try { return new URL(d.url!.startsWith('http') ? d.url! : `https://${d.url}`).hostname.replace(/^www\./, ''); } catch { return d.url || ''; } })();

    return `
      <article class="deal ${st}" data-id="${d.id}">
        ${st === 'won' ? `<span class="deal-seal">Won</span>` : st === 'inplay' ? `<span class="deal-seal inplay">In play</span>` : ''}
        <header class="deal-head">
          ${person ? `<span class="deal-face">${person.avatar
            ? `<img src="${person.avatar}" alt="">`
            : `<span>${escapeHtml(initials(person.name || noteHeadline(person)))}</span>`}</span>` : ''}
          <div class="deal-who">
            <h3>${escapeHtml(d.title)}</h3>
            ${person ? `<p>${escapeHtml(person.name || noteHeadline(person))}${person.company ? ` · ${escapeHtml(person.company)}` : ''}</p>` : ''}
          </div>
        </header>

        <div class="deal-money">
          ${capexOf(d) ? `<div class="deal-value">${money(capexOf(d))}</div>` : ''}
          ${ongoingOf(d) ? `<div class="deal-ongoing ${capexOf(d) ? '' : 'lead'}">${capexOf(d) ? '+ ' : ''}${money(ongoingOf(d))}<em>/month</em></div>` : ''}
          ${!capexOf(d) && !ongoingOf(d) ? `<div class="deal-value muted">${dealState(d) === 'inplay' ? 'In play' : '—'}</div>` : ''}
        </div>

        ${d.url ? `
          <button class="deal-open" data-open="${d.id}">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 7h3a5 5 0 010 10h-3M9 17H6A5 5 0 016 7h3"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            <span>Open quote</span>
          </button>` : `<div class="deal-nolink">No quote link yet</div>`}

        ${(d.username || d.password) ? `
          <div class="deal-creds">
            ${d.username ? `<button class="cred" data-copy="${escapeHtml(d.username)}" title="Copy username"><i>user</i>${escapeHtml(d.username)}</button>` : ''}
            ${d.password ? `<button class="cred" data-copy="${escapeHtml(d.password)}" title="Copy password"><i>pass</i>••••••••</button>` : ''}
          </div>` : ''}

        <footer class="deal-foot">
          <span class="deal-host">${escapeHtml(host)}</span>
          <span class="deal-meta">
            ${goal ? `<span class="deal-goal" title="Goal: ${escapeHtml(goal.text || 'Untitled goal')}">◆</span>` : ''}
            ${d.sentAt ? formatDate(d.sentAt) : 'not quoted yet'}
          </span>
        </footer>

        <div class="deal-actions">
          <button data-edit="${d.id}">Edit</button>
          ${st === 'inplay'
            ? `<button data-quoted="${d.id}">Quoted</button><button data-won="${d.id}">Won</button><button data-lost="${d.id}">Lost</button>`
            : st === 'quoted'
              ? `<button data-won="${d.id}">Won</button><button data-lost="${d.id}">Lost</button>`
              : `<button data-live="${d.id}">Reopen</button>`}
        </div>
      </article>`;
  }

  function renderDeals() {
    const root = document.getElementById('deals-inner');
    const countEl = document.getElementById('deals-count');
    if (!root) return;
    const deals = getDeals();

    const inplay = deals.filter(d => dealState(d) === 'inplay');
    const quoted = deals.filter(d => dealState(d) === 'quoted');
    const won = deals.filter(d => dealState(d) === 'won');
    const lost = deals.filter(d => dealState(d) === 'lost');


    /* In play lives in Opps now. Deals is only the quotes that went out and
       what became of them, so the count row is money rather than headcount -
       with one line back to the room the work came from. */
    if (countEl) {
      const q = dealTotals(quoted), w = dealTotals(won);
      countEl.innerHTML = (quoted.length || won.length || lost.length) ? `
        <span class="dc-stat"><i>Quoted</i><b>${money(q.capex)}</b>${q.ongoing ? `<u>+${money(q.ongoing)}/mo</u>` : ''}</span>
        <span class="dc-stat won"><i>Won</i><b>${money(w.capex)}</b>${w.ongoing ? `<u>+${money(w.ongoing)}/mo</u>` : ''}</span>
        ${inplay.length ? `<button class="dc-link" id="deals-to-opps">${inplay.length} still in play →</button>` : ''}` : '';
    }

    if (!quoted.length && !won.length && !lost.length) {
      root.innerHTML = `<div class="deals-empty"><p>No quotes sent yet.</p><span>A deal is a quote you have sent — its value, who it is for, and the way back into it. Conversations before that live in Opps.</span></div>`;
      document.getElementById('deals-to-opps')?.addEventListener('click', () => setViewMode('opps'));
      return;
    }

    const section = (title: string, list: Deal[], cls = '') => list.length ? `
      <section class="deal-section ${cls}">
        <header class="deal-section-head"><h3>${title}</h3><span>${cls === 'is-inplay'
          ? `${list.length} conversation${list.length === 1 ? '' : 's'}`
          : `${list.length} · ${totalsHtml(list)}`}</span></header>
        <div class="deal-grid">${list.map(dealCardHtml).join('')}</div>
      </section>` : '';

    root.innerHTML = section('Quoted', quoted) + section('Won', won, 'is-won') + section('Lost', lost, 'is-lost');
    document.getElementById('deals-to-opps')?.addEventListener('click', () => setViewMode('opps'));

    root.querySelectorAll('[data-open]').forEach(b => b.addEventListener('click', () => openQuote((b as HTMLElement).dataset.open!)));
    root.querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => openDealModal((b as HTMLElement).dataset.edit!)));
    root.querySelectorAll('[data-quoted]').forEach(b => b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.quoted!, 'quoted')));
    root.querySelectorAll('[data-won]').forEach(b => b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.won!, 'won')));
    root.querySelectorAll('[data-lost]').forEach(b => b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.lost!, 'lost')));
    root.querySelectorAll('[data-live]').forEach(b => b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.live!, getDeals().find(x => x.id === (b as HTMLElement).dataset.live)?.sentAt ? 'quoted' : 'inplay')));
    root.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', async () => {
      const el = b as HTMLElement;
      try {
        await navigator.clipboard.writeText(el.dataset.copy!);
        const was = el.innerHTML;
        el.innerHTML = '<i>ok</i>copied';
        setTimeout(() => { el.innerHTML = was; }, 1400);
      } catch { /* clipboard unavailable */ }
    }));
  }


  // ============ OPPS ============
  /* Everything still unquoted, and nothing else. Deals answers "what did I
     send and what happened"; this answers "who am I talking to, and what is
     the next thing I say to them". The moment a quote date goes on one of
     these it leaves this page for Deals - there is no status to keep honest. */

  function oppAge(d: Deal): string {
    if (!d.createdAt) return '';
    const days = Math.floor((Date.now() - d.createdAt) / 86400000);
    if (days <= 0) return 'today';
    if (days === 1) return '1 day in';
    if (days < 14) return `${days} days in`;
    if (days < 60) return `${Math.round(days / 7)} weeks in`;
    return `${Math.round(days / 30)} months in`;
  }

  function oppCardHtml(d: Deal): string {
    const person = d.personId ? state.notes.find(n => n.id === d.personId) : undefined;
    const goal = d.goalId ? getGoals().find(g => g.id === d.goalId) : undefined;
    const cx = capexOf(d), og = ongoingOf(d);
    const worth = (cx || og)
      ? `${cx ? money(cx) : ''}${cx && og ? ' + ' : ''}${og ? `${money(og)}<em>/month</em>` : ''}`
      : `<span class="opp-noworth">No number yet</span>`;
    const age = oppAge(d);

    return `
      <article class="opp" data-id="${d.id}">
        <header class="opp-head">
          ${person ? `<span class="opp-face">${person.avatar
            ? `<img src="${person.avatar}" alt="">`
            : `<span>${escapeHtml(initials(person.name || noteHeadline(person)))}</span>`}</span>` : ''}
          <div class="opp-who">
            <h3>${escapeHtml(d.title)}</h3>
            ${person ? `<p>${escapeHtml(person.name || noteHeadline(person))}${person.company ? ` · ${escapeHtml(person.company)}` : ''}</p>` : ''}
          </div>
          ${age ? `<span class="opp-age">${age}</span>` : ''}
        </header>

        <div class="opp-worth">${worth}</div>

        <div class="opp-note" contenteditable="true" spellcheck="false"
             data-note="${d.id}" data-ph="Where it is at, and the next move">${escapeHtml(d.notes || '')}</div>

        <footer class="opp-foot">
          <span class="opp-goal ${goal ? '' : 'none'}">${goal ? `◆ ${escapeHtml((goal.text || 'Untitled goal').split('\n')[0])}` : 'No goal'}</span>
          <div class="opp-actions">
            <button data-edit="${d.id}">Edit</button>
            <button class="is-go" data-quoted="${d.id}">Quoted</button>
            <button data-won="${d.id}">Won</button>
            <button data-lost="${d.id}">Lost</button>
          </div>
        </footer>
      </article>`;
  }

  function renderOpps() {
    const root = document.getElementById('opps-inner');
    const countEl = document.getElementById('opps-count');
    if (!root) return;
    const opps = getDeals().filter(d => dealState(d) === 'inplay');

    if (countEl) {
      const t = dealTotals(opps);
      const blank = opps.filter(d => !capexOf(d) && !ongoingOf(d)).length;
      countEl.innerHTML = opps.length ? `
        <span class="dc-stat"><i>In play</i><b>${opps.length}</b><u>conversation${opps.length === 1 ? '' : 's'}</u></span>
        <span class="dc-stat"><i>On the table</i><b>${t.capex ? money(t.capex) : (t.ongoing ? money(t.ongoing) + '/mo' : '—')}</b>${t.capex && t.ongoing ? `<u>+${money(t.ongoing)}/mo</u>` : ''}</span>
        ${blank ? `<span class="dc-stat"><i>No number yet</i><b>${blank}</b><u>of ${opps.length}</u></span>` : ''}` : '';
    }

    if (!opps.length) {
      root.innerHTML = `<div class="deals-empty"><p>Nothing in play.</p><span>An opp is a conversation with no number on it yet. Put a quote date on one and it moves to Deals.</span></div>`;
      return;
    }

    root.innerHTML = `<div class="opp-grid">${opps.map(oppCardHtml).join('')}</div>`;

    root.querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => openDealModal((b as HTMLElement).dataset.edit!)));
    root.querySelectorAll('[data-quoted]').forEach(b => b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.quoted!, 'quoted')));
    root.querySelectorAll('[data-won]').forEach(b => b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.won!, 'won')));
    root.querySelectorAll('[data-lost]').forEach(b => b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.lost!, 'lost')));

    /* The note saves on blur and does NOT redraw: nothing on this page is
       computed from it, and a redraw mid-sentence is how you lose a thought. */
    root.querySelectorAll('[data-note]').forEach(el => {
      el.addEventListener('blur', () => {
        const node = el as HTMLElement;
        const d = getDeals().find(x => x.id === node.dataset.note);
        if (!d) return;
        const text = (node.innerText || '').replace(/\s+$/, '');
        if ((d.notes || '') === text) return;
        d.notes = text || undefined;
        save();
      });
      el.addEventListener('keydown', e => {
        if ((e as KeyboardEvent).key === 'Escape') (el as HTMLElement).blur();
      });
    });
  }

  // ============ SCRIPTS ============
  /* Moments down the left, the words at reading size on the right. Which
     one is open is a local preference, not project data - the laptop and
     the phone are looking at different parts of the same call. */
  const SCRIPT_OPEN_KEY = 'stiki-script-open';
  let currentScriptId: string | null = localStorage.getItem(SCRIPT_OPEN_KEY);

  function getScripts(): Script[] {
    if (!state.scripts) state.scripts = [];
    return state.scripts;
  }

  const scriptTitle = (sc: Script) => (sc.when || '').trim() || 'Untitled moment';
  const scriptPeek = (sc: Script) => ((sc.body || '').trim().split('\n')[0] || '').slice(0, 70);

  function openScript(id: string | null) {
    currentScriptId = id;
    if (id) localStorage.setItem(SCRIPT_OPEN_KEY, id); else localStorage.removeItem(SCRIPT_OPEN_KEY);
  }

  function addScript() {
    const sc: Script = {
      id: `script-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
      when: '', body: '', createdAt: Date.now(),
    };
    getScripts().push(sc);
    openScript(sc.id);
    save();
    renderScripts(true);
    (document.querySelector('.sc-when') as HTMLElement)?.focus();
  }

  function deleteScript(id: string) {
    const sc = getScripts().find(x => x.id === id);
    if (!sc || !confirm(`Delete "${scriptTitle(sc)}"?`)) return;
    tombstone(id);
    state.scripts = getScripts().filter(x => x.id !== id);
    if (currentScriptId === id) openScript(null);
    save();
    renderScripts(true);
  }

  function commitScriptField(el: HTMLElement) {
    const sc = getScripts().find(x => x.id === el.dataset.id);
    if (!sc) return;
    const field = el.dataset.field as 'when' | 'body';
    const text = (el.innerText || '').replace(/\s+$/, '');
    if ((sc[field] || '') === text) return;
    sc[field] = text;
    save();
    renderScriptList();   // the left column shows both fields, so it follows
  }

  function renderScriptList() {
    const list = document.getElementById('sc-moments');
    if (!list) return;
    const scripts = getScripts();

    list.innerHTML = scripts.length
      ? scripts.map(sc => `
        <button class="sc-moment ${sc.id === currentScriptId ? 'on' : ''}" data-id="${sc.id}">
          ${escapeHtml(scriptTitle(sc))}
          <span>${escapeHtml(scriptPeek(sc) || 'Nothing written yet')}</span>
        </button>`).join('')
      : `<p class="sc-none">No scripts yet. Add one: the moment it is for, then the words.</p>`;

    list.querySelectorAll('.sc-moment').forEach(b => b.addEventListener('click', () => {
      openScript((b as HTMLElement).dataset.id!);
      renderScripts(true);
    }));
  }

  function renderScriptPane() {
    const pane = document.getElementById('script-pane');
    if (!pane) return;
    const scripts = getScripts();
    const sc = scripts.find(x => x.id === currentScriptId) || scripts[0];

    if (!sc) {
      pane.innerHTML = `<div class="sc-blank">A script is one moment and the words for it — the first ten seconds of a cold call, what you say when they ask you to send something through, how you ask for the meeting.
        <div class="sc-tools"><button class="sc-first">Write the first one</button></div></div>`;
      pane.querySelector('.sc-first')?.addEventListener('click', addScript);
      return;
    }
    if (sc.id !== currentScriptId) openScript(sc.id);

    pane.innerHTML = `
      <div class="sc-doc">
        <div class="sc-when" contenteditable="true" spellcheck="false"
             data-id="${sc.id}" data-field="when" data-ph="When to use this">${escapeHtml(sc.when || '')}</div>
        <div class="sc-body" contenteditable="true"
             data-id="${sc.id}" data-field="body" data-ph="What you say.">${escapeHtml(sc.body || '')}</div>
        <div class="sc-tools">
          <button class="sc-copy">Copy</button>
          <span class="sc-saved">${sc.updatedAt ? `Edited ${formatDate(sc.updatedAt)}` : ''}</span>
          <button class="sc-del">Delete</button>
        </div>
      </div>`;

    pane.querySelectorAll('[data-field]').forEach(el => {
      el.addEventListener('blur', () => commitScriptField(el as HTMLElement));
      el.addEventListener('keydown', e => {
        const ev = e as KeyboardEvent;
        if (ev.key === 'Escape') (el as HTMLElement).blur();
        // the heading is one line; Enter there means "on to the words"
        if (ev.key === 'Enter' && (el as HTMLElement).dataset.field === 'when') {
          ev.preventDefault();
          commitScriptField(el as HTMLElement);
          (pane.querySelector('.sc-body') as HTMLElement)?.focus();
        }
      });
    });

    pane.querySelector('.sc-copy')?.addEventListener('click', async () => {
      const btn = pane.querySelector('.sc-copy') as HTMLElement;
      const body = (pane.querySelector('.sc-body') as HTMLElement)?.innerText || '';
      try {
        await navigator.clipboard.writeText(body);
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
      } catch { /* clipboard unavailable */ }
    });
    pane.querySelector('.sc-del')?.addEventListener('click', () => deleteScript(sc.id));
  }

  /* force: this redraw was asked for (added, deleted, picked a moment), so it
     happens whatever has focus. Unforced is the background one - a pull from
     the cloud repaints the open view every 30 seconds, and redrawing the pane
     under a cursor would eat the sentence being typed. */
  function renderScripts(force = false) {
    renderScriptList();
    const pane = document.getElementById('script-pane');
    const active = document.activeElement as HTMLElement | null;
    if (!force && pane && active && active.isContentEditable && pane.contains(active)) return;
    renderScriptPane();
  }

  document.getElementById('add-script')?.addEventListener('click', addScript);

  // ============ FUNNEL ============
  /* The climb, and the only view that answers whether the target gets met.
     Deals is the record of quotes and Sales is the sheet of typed figures;
     this is neither. One number - recurring money already won - measured
     against $100k a month, and behind it the three stages that have to fill
     the rest, so "where does the remainder come from" is answered on the
     same screen. Only the per-month figure counts: a one-off build is real
     money but it is not passive revenue, so it never moves the bar. */
  const DEFAULT_PASSIVE_TARGET = 100000;

  /* Conversion is measured once there is enough history to divide by, and
     stated as an assumption until then. Two closed deals is not a win rate,
     and a view that quietly presents one as fact is worse than no view. */
  const FUNNEL_MIN_SAMPLE = 4;
  const ASSUMED_QUOTE_RATE = 0.5;
  const ASSUMED_WIN_RATE = 0.33;

  function passiveTarget(): number {
    const t = state.passiveTarget;
    return t && typeof t.value === 'number' && t.value > 0 ? t.value : DEFAULT_PASSIVE_TARGET;
  }

  function setPassiveTarget(v: number) {
    state.passiveTarget = { value: v, updatedAt: Date.now() };
    save();
  }

  type FunnelStage = 'suspect' | 'prospect' | 'win' | 'lost';

  /* The three words, read off dates the deal already carries: talking with no
     quote out is a suspect, a quote sent and still open is a prospect, wonAt
     is a win. No status field to keep honest, and nothing to migrate. */
  function funnelStage(d: Deal): FunnelStage {
    const st = dealState(d);
    return st === 'inplay' ? 'suspect' : st === 'quoted' ? 'prospect' : st === 'won' ? 'win' : 'lost';
  }

  const fnMoney = (v: number) => '$' + Math.round(v).toLocaleString('en-NZ');
  const fnPct = (v: number) => `${Math.round(v * 100)}%`;
  const monthlyOf = (list: Deal[]) => list.reduce((t, d) => t + ongoingOf(d), 0);

  function funnelRates() {
    const deals = getDeals();
    // a win counts as having been quoted even where the sent date never got filled in
    const asked = deals.filter(d => d.sentAt || d.wonAt);
    const decided = deals.filter(d => d.wonAt || d.lostAt);
    const won = deals.filter(d => d.wonAt);
    const quoteKnown = deals.length >= FUNNEL_MIN_SAMPLE;
    const winKnown = decided.length >= FUNNEL_MIN_SAMPLE;
    return {
      quote: quoteKnown ? asked.length / deals.length : ASSUMED_QUOTE_RATE,
      win: winKnown ? won.length / decided.length : ASSUMED_WIN_RATE,
      quoteKnown, winKnown,
      askedOf: `${asked.length} of ${deals.length}`,
      wonOf: `${won.length} of ${decided.length}`,
    };
  }

  function funnelRowHtml(d: Deal, stage: FunnelStage): string {
    const person = d.personId ? state.notes.find(n => n.id === d.personId) : undefined;
    const mo = ongoingOf(d);
    const act = stage === 'suspect'
      ? `<button data-fn-quoted="${d.id}" title="A quote has gone out">Quote sent</button>`
      : stage === 'prospect'
        ? `<button data-fn-won="${d.id}">Won</button><button class="is-lost" data-fn-lost="${d.id}">Lost</button>`
        : '';

    return `
      <article class="fn-row${mo ? '' : ' no-mo'}" data-id="${d.id}">
        <button class="fn-row-main" data-fn-edit="${d.id}" title="Edit deal">
          ${person
            ? `<span class="fn-face">${person.avatar
                ? `<img src="${person.avatar}" alt="">`
                : `<span>${escapeHtml(initials(person.name || noteHeadline(person)))}</span>`}</span>`
            : `<span class="fn-face empty"></span>`}
          <span class="fn-row-who">
            <b>${escapeHtml(d.title)}</b>
            ${person ? `<i>${escapeHtml(person.name || noteHeadline(person))}${person.company ? ` · ${escapeHtml(person.company)}` : ''}</i>` : ''}
          </span>
          <span class="fn-row-mo">${mo ? `${fnMoney(mo)}<em>/mo</em>` : `<em>one-off</em>`}</span>
        </button>
        ${act ? `<div class="fn-row-act">${act}</div>` : ''}
      </article>`;
  }

  function renderFunnel() {
    const root = document.getElementById('funnel-inner');
    if (!root) return;

    const target = passiveTarget();
    const targetEl = document.getElementById('funnel-target');
    // never repaint the figure being typed into
    if (targetEl && document.activeElement !== targetEl) targetEl.textContent = fnMoney(target);

    const deals = getDeals();
    const suspects = deals.filter(d => funnelStage(d) === 'suspect');
    const prospects = deals.filter(d => funnelStage(d) === 'prospect');
    const wins = deals.filter(d => funnelStage(d) === 'win');

    if (!deals.length) {
      root.innerHTML = `
        <div class="fn-empty">
          <p>Nothing in the funnel yet.</p>
          <span>Every deal lands here the moment it exists. Talking with no quote out is a
          <b>suspect</b>; a quote sent and still open is a <b>prospect</b>; a deal marked won is a
          <b>win</b>. Only the monthly part of a deal counts toward ${fnMoney(target)} a month.</span>
        </div>`;
      return;
    }

    const r = funnelRates();
    const wonMo = monthlyOf(wins);
    const prospectMo = monthlyOf(prospects);
    const suspectMo = monthlyOf(suspects);

    const expProspect = prospectMo * r.win;
    const expSuspect = suspectMo * r.quote * r.win;
    const projected = wonMo + expProspect + expSuspect;
    const gap = Math.max(0, target - wonMo);
    const met = wonMo >= target;

    // widths as a share of the target, each segment taking only the room left
    const w = (v: number) => Math.max(0, Math.min(100, (v / target) * 100));
    const wWon = w(wonMo);
    const wPro = Math.min(100 - wWon, w(expProspect));
    const wSus = Math.min(100 - wWon - wPro, w(expSuspect));

    const climb = `
      <section class="fn-climb">
        <div class="fn-climb-head">
          <div class="fn-now">
            <i>Won and recurring</i>
            <b>${fnMoney(wonMo)}<em>/mo</em></b>
            <u>${fnPct(target ? wonMo / target : 0)} of ${fnMoney(target)}</u>
          </div>
          <div class="fn-now right ${met ? 'is-met' : ''}">
            <i>${met ? 'Target' : 'Still to find'}</i>
            <b>${met ? 'Met' : fnMoney(gap)}${met ? '' : '<em>/mo</em>'}</b>
            <u>${met ? 'every month, banked' : `at ${fnPct(r.win)} win rate, ${fnMoney(gap / (r.win || ASSUMED_WIN_RATE))} of quotes`}</u>
          </div>
        </div>

        <div class="fn-track" role="img" aria-label="${fnMoney(wonMo)} of ${fnMoney(target)} per month won">
          <div class="fn-seg won" style="width:${wWon}%"></div>
          <div class="fn-seg pro" style="width:${wPro}%"></div>
          <div class="fn-seg sus" style="width:${wSus}%"></div>
        </div>

        <div class="fn-legend">
          <span><i class="sw won"></i>Won ${fnMoney(wonMo)}</span>
          <span><i class="sw pro"></i>Prospects, weighted ${fnMoney(expProspect)}</span>
          <span><i class="sw sus"></i>Suspects, weighted ${fnMoney(expSuspect)}</span>
          <span class="fn-proj">Projects to ${fnMoney(projected)}/mo</span>
        </div>
      </section>`;

    const col = (stage: FunnelStage, title: string, blurb: string, list: Deal[]) => {
      const mo = monthlyOf(list);
      const oneOff = list.filter(d => !ongoingOf(d)).length;
      return `
        <div class="fn-stage is-${stage}">
          <header>
            <h3>${title}</h3>
            <p>${blurb}</p>
            <div class="fn-stage-sum">
              <b>${fnMoney(mo)}<em>/mo</em></b>
              <u>${list.length} deal${list.length === 1 ? '' : 's'}${oneOff ? ` · ${oneOff} one-off only` : ''}</u>
            </div>
          </header>
          <div class="fn-rows">${list.length
            ? list.map(d => funnelRowHtml(d, stage)).join('')
            : `<div class="fn-none">Nothing here</div>`}</div>
        </div>`;
    };

    const gate = (pct: string, label: string, known: boolean, of: string) => `
      <div class="fn-gate">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        <b>${pct}</b>
        <i>${label}</i>
        <u>${known ? of : 'assumed'}</u>
      </div>`;

    const stages = `
      <section class="fn-stages">
        ${col('suspect', 'Suspects', 'Talking, no quote out', suspects)}
        ${gate(fnPct(r.quote), 'get a quote', r.quoteKnown, r.askedOf)}
        ${col('prospect', 'Prospects', 'Quote sent, still open', prospects)}
        ${gate(fnPct(r.win), 'are won', r.winKnown, r.wonOf)}
        ${col('win', 'Wins', 'Recurring money banked', wins)}
      </section>`;

    /* The arithmetic spelled out, because a bar can be read optimistically.
       Every rate it leans on says whether it was measured or assumed. */
    const shortfall = target - projected;
    const effWin = r.win > 0 ? r.win : ASSUMED_WIN_RATE;
    const maths = `
      <section class="fn-maths">
        <h3>What it takes</h3>
        <ul>
          ${met
            ? `<li><b>${fnMoney(wonMo)}/mo</b> is won against a ${fnMoney(target)} target. The target is met.</li>`
            : `<li><b>${fnMoney(gap)}/mo</b> still to find after the ${fnMoney(wonMo)}/mo already won.</li>`}
          <li>${prospectMo
            ? `<b>${fnMoney(prospectMo)}/mo</b> is out on quotes. At a ${fnPct(r.win)} win rate${r.winKnown ? ` (${r.wonOf} closed deals)` : ' (assumed — not enough closed deals to measure)'} that is worth about <b>${fnMoney(expProspect)}/mo</b>.`
            : `No quotes are out. Nothing can be won this month from an empty prospect column.`}</li>
          <li>${suspectMo
            ? `<b>${fnMoney(suspectMo)}/mo</b> is in conversation. At ${fnPct(r.quote)} reaching a quote${r.quoteKnown ? '' : ' (assumed)'} and ${fnPct(r.win)} of those won, that is worth about <b>${fnMoney(expSuspect)}/mo</b>.`
            : `No suspects. The funnel has nothing feeding it.`}</li>
          ${met ? '' : shortfall > 0
            ? `<li class="is-verdict">Everything in the funnel projects to <b>${fnMoney(projected)}/mo</b> — <b>${fnMoney(shortfall)}/mo short</b>. Closing that needs roughly <b>${fnMoney(shortfall / effWin)}/mo</b> of new quotes out.</li>`
            : `<li class="is-verdict ok">Everything in the funnel projects to <b>${fnMoney(projected)}/mo</b>, which clears ${fnMoney(target)}. The work is converting it, not finding more.</li>`}
        </ul>
      </section>`;

    root.innerHTML = climb + stages + maths;

    root.querySelectorAll('[data-fn-edit]').forEach(b =>
      b.addEventListener('click', () => openDealModal((b as HTMLElement).dataset.fnEdit!)));
    root.querySelectorAll('[data-fn-quoted]').forEach(b =>
      b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.fnQuoted!, 'quoted')));
    root.querySelectorAll('[data-fn-won]').forEach(b =>
      b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.fnWon!, 'won')));
    root.querySelectorAll('[data-fn-lost]').forEach(b =>
      b.addEventListener('click', () => setDealOutcome((b as HTMLElement).dataset.fnLost!, 'lost')));
  }

  document.getElementById('add-funnel-deal')?.addEventListener('click', () => openDealModal());

  /* The target is typed, so read what a hand types - "100k", "$100,000" -
     with the sales parser that already does exactly that. */
  (() => {
    const el = document.getElementById('funnel-target');
    if (!el) return;
    const commit = () => {
      const parsed = parseSalesInput(el.textContent || '');
      const next = parsed === null || Number.isNaN(parsed) || parsed <= 0 ? passiveTarget() : parsed;
      if (next !== passiveTarget()) setPassiveTarget(next);
      el.textContent = fnMoney(next);
      renderFunnel();
    };
    el.addEventListener('blur', commit);
    el.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'Enter') { e.preventDefault(); el.blur(); }
      if (k === 'Escape') { el.textContent = fnMoney(passiveTarget()); el.blur(); }
    });
  })();

  // ============ SALES ============
  /* Twelve months down the side, six lines across the top, and one typed
     figure in each box. Five of those lines are whatever gets typed into
     them - this sheet holds the numbers being worked to, it does not model
     the accounts. NP is the one exception: it always equals Gross Profit
     less Expenses less Salary, so it is worked out rather than entered and
     cannot drift away from the three lines above it. The other arithmetic
     is the year total per line, along the bottom. */
  const SALES_LINES = [
    { key: 'revenue',  label: 'Revenue',         derived: false, built: true  },
    { key: 'passive',  label: 'Passive Revenue', derived: false, built: true  },
    { key: 'gp',       label: 'Gross Profit',    derived: false, built: false },
    { key: 'expenses', label: 'Expenses',        derived: false, built: false },
    { key: 'salary',   label: 'Salary',          derived: false, built: false },
    { key: 'np',       label: 'NP',              derived: true,  built: false },
  ];
  const salesLineLabel = (key: string) => SALES_LINES.find(l => l.key === key)?.label || key;
  // how far Enter has to jump to land on the same line a month down
  const SALES_INPUT_COLS = SALES_LINES.filter(l => !l.derived).length;

  /* April 2026 through March 2027, as ['2026-04' ... '2027-03']. Spelled out
     from a start rather than hardcoded so next year is a one-line change. */
  const SALES_FY_START_YEAR = 2026;
  const SALES_FY_START_MONTH = 4;
  const SALES_MONTHS: string[] = Array.from({ length: 12 }, (_, i) => {
    const n = SALES_FY_START_MONTH - 1 + i;
    const y = SALES_FY_START_YEAR + Math.floor(n / 12);
    return `${y}-${String((n % 12) + 1).padStart(2, '0')}`;
  });
  const MONTH_ABBR = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const salesMonthName = (m: string) => `${MONTH_ABBR[+m.slice(5) - 1]} ${m.slice(0, 4)}`;

  function getSales(): SalesCell[] {
    if (!state.sales) state.sales = [];
    return state.sales;
  }

  /* Derived, not random: the same box edited on two devices lands on one
     row that merges by timestamp, instead of forking into two. */
  const salesCellId = (month: string, line: string) => `sales-${month}-${line}`;

  function salesValue(month: string, line: string): number | null {
    const c = getSales().find(x => x.id === salesCellId(month, line));
    return c ? c.value : null;
  }

  function setSalesValue(month: string, line: string, v: number | null) {
    const id = salesCellId(month, line);
    const cells = getSales();
    const i = cells.findIndex(c => c.id === id);
    if (v === null) {
      if (i < 0) return;
      /* An emptied box has to stay empty everywhere. Without the marker the
         other device just sees a row it still holds and puts the figure back. */
      tombstone(id);
      cells.splice(i, 1);
    } else if (i >= 0) {
      if (cells[i].value === v) return;
      cells[i].value = v;
    } else {
      cells.push({ id, month, line, value: v, createdAt: Date.now() });
    }
    save();
  }

  function salesItems(month: string, line: string): SalesItem[] {
    const c = getSales().find(x => x.id === salesCellId(month, line));
    return c && Array.isArray(c.items) ? c.items : [];
  }

  /* The assembled lines write the list and the figure together: the cell's
     value is never anything other than the sum of what is in it, so the
     column totals and NP keep working off value exactly as they did when
     every box was keyed. An empty list is an emptied box, tombstone and
     all, for the same reason a cleared input is. */
  function setSalesBreakdown(month: string, line: string, items: SalesItem[]) {
    const id = salesCellId(month, line);
    const cells = getSales();
    const i = cells.findIndex(c => c.id === id);
    if (!items.length) {
      if (i < 0) return;
      tombstone(id);
      cells.splice(i, 1);
    } else {
      const total = items.reduce((t, it) => t + it.value, 0);
      if (i >= 0) {
        cells[i].value = total;
        cells[i].items = items;
      } else {
        cells.push({ id, month, line, value: total, items, createdAt: Date.now() });
      }
    }
    save();
  }

  /* Typed by hand, so read what a hand types: $, thousands commas, a
     trailing k or m, and brackets or a minus for money going out.
     null means the box was cleared. NaN means it holds something that is
     not a number at all, and the caller puts back the previous figure
     rather than wiping it over a typo. */
  function parseSalesInput(raw: string): number | null {
    let t = raw.trim().replace(/[$,\s]/g, '');
    if (!t) return null;
    let neg = false;
    if (/^\(.*\)$/.test(t)) { neg = true; t = t.slice(1, -1); }
    let mult = 1;
    if (/k$/i.test(t)) { mult = 1000; t = t.slice(0, -1); }
    else if (/m$/i.test(t)) { mult = 1e6; t = t.slice(0, -1); }
    const n = Number(t);
    if (t === '' || !isFinite(n)) return NaN;
    const v = Math.round(n * mult);
    return neg ? -v : v;
  }

  const salesFmt = (v: number) =>
    (v < 0 ? '-' : '') + '$' + Math.abs(v).toLocaleString('en-NZ');

  /* The one derived figure. null - rather than $0 - while none of the three
     lines it is built from has been filled in, so an untouched month reads
     as blank instead of as a month that nets out to nothing. */
  function salesNp(month: string): number | null {
    const gp = salesValue(month, 'gp');
    const ex = salesValue(month, 'expenses');
    const sal = salesValue(month, 'salary');
    if (gp === null && ex === null && sal === null) return null;
    return (gp ?? 0) - (ex ?? 0) - (sal ?? 0);
  }

  /* What a month is worth to you if it simply kept happening: the salary
     and the net profit are one pot, you take half, and that half runs for
     twelve months. Null when NP is - an untouched month has nothing to
     annualise, and $0 a year would read as an answer rather than as a
     blank. */
  function salesPotential(month: string) {
    const np = salesNp(month);
    if (np === null) return null;
    const salary = salesValue(month, 'salary') ?? 0;
    const together = salary + np;
    const half = together / 2;      // may land on a half-dollar; the year never does
    return { np, salary, together, half, year: together * 6 };
  }

  // the half can be a half-dollar, and $45.5 reads as a typo
  const salesFmtExact = (v: number) => (v < 0 ? '-' : '') + '$' +
    Math.abs(v).toLocaleString('en-NZ', {
      minimumFractionDigits: Number.isInteger(v) ? 0 : 2, maximumFractionDigits: 2 });

  /* ---- What the year actually pays you -------------------------------
     Salary and NP are one pot, you take half, and that half is income -
     so it gets taxed like income rather than admired gross.

     PAYE bands as they have stood since 1 April 2025 (ird.govt.nz), which
     are the bands for the 2026/27 year this sheet covers, plus the ACC
     earners' levy at 1.75% on the first $156,641 of earnings. These are a
     year's rates against a year's income: they are only true of the twelve
     months summed, which is why this sits under the sheet and not in a
     column beside it. */
  const NZ_TAX_BANDS: { upTo: number; rate: number }[] = [
    { upTo: 15600,    rate: 0.105 },
    { upTo: 53500,    rate: 0.175 },
    { upTo: 78100,    rate: 0.30 },
    { upTo: 180000,   rate: 0.33 },
    { upTo: Infinity, rate: 0.39 },
  ];
  const ACC_LEVY_RATE = 0.0175;
  const ACC_LEVY_CAP = 156641;      // maximum liable earnings, 2026/27

  function nzTakeHome(gross: number) {
    const g = Math.max(0, gross);
    let paye = 0, floor = 0, marginal = NZ_TAX_BANDS[0].rate;
    for (const b of NZ_TAX_BANDS) {
      const inBand = Math.min(g, b.upTo) - floor;
      if (inBand <= 0) break;
      paye += inBand * b.rate;
      marginal = b.rate;
      floor = b.upTo;
    }
    const acc = Math.min(g, ACC_LEVY_CAP) * ACC_LEVY_RATE;
    return { gross: g, paye, acc, net: g - paye - acc, marginal, rate: g ? (paye + acc) / g : 0 };
  }

  /* The sheet's whole year, through the same halving the NP cell does for
     a single month. */
  function salesTakeHome() {
    const salary = salesLineTotal('salary');
    const np = salesLineTotal('np');
    const together = salary + np;
    const half = together / 2;
    return { salary, np, together, half, ...nzTakeHome(half) };
  }

  function salesTakeHtml(): string {
    const t = salesTakeHome();
    const yearEnd = salesMonthName(SALES_MONTHS[SALES_MONTHS.length - 1]);
    const head = `<header class="st-head"><h3>What it pays you</h3><span>Year to ${yearEnd} &middot; your half of Salary and NP, after tax</span></header>`;

    if (!t.salary && !t.np) {
      return `<section class="sales-take is-empty">${head}
        <p class="st-blank">Fill in Salary and Gross Profit above and this works out the half you take, and what is left of it after PAYE and the ACC levy.</p>
      </section>`;
    }

    const money = (v: number) => salesFmt(Math.round(v));
    const pct = (v: number) => `${(v * 100).toFixed(1)}%`;

    return `<section class="sales-take">${head}
      <div class="st-grid">
        <div class="st-work">
          <div class="st-row"><span>Salary</span><b>${money(t.salary)}</b></div>
          <div class="st-row${t.np < 0 ? ' is-neg' : ''}"><span>NP</span><b>${money(t.np)}</b></div>
          <div class="st-row is-sub${t.together < 0 ? ' is-neg' : ''}"><span>Together</span><b>${money(t.together)}</b></div>
          <div class="st-row is-op"><span>Your half</span><b>&divide; 2</b></div>
          <div class="st-row is-gross${t.half < 0 ? ' is-neg' : ''}"><span>Gross</span><b>${salesFmtExact(t.half)}</b></div>
          ${t.half > 0 ? `
            <div class="st-row is-out"><span>PAYE</span><b>&minus;${money(t.paye)}</b></div>
            <div class="st-row is-out"><span>ACC levy <i>1.75% to ${salesFmt(ACC_LEVY_CAP)}</i></span><b>&minus;${money(t.acc)}</b></div>` : ''}
        </div>
        <div class="st-net${t.half > 0 ? '' : ' is-neg'}">
          <i>Net, for the fortnight</i>
          ${t.half > 0 ? `
            <b>${money(t.net / 26)}</b>
            <span>${money(t.net)} a year &middot; ${money(t.net / 12)} a month</span>
            <u>${pct(t.rate)} of it to tax &middot; top dollar at ${pct(t.marginal)}${t.gross > ACC_LEVY_CAP ? ', ACC levy capped out' : ''}</u>`
          : `
            <b>&mdash;</b>
            <span>Nothing to take, so nothing to tax &mdash; the year as it stands does not pay you.</span>`}
        </div>
      </div>
      <p class="st-note">PAYE on the bands in force for 2026/27 &mdash; 10.5% to ${salesFmt(15600)}, 17.5% to ${salesFmt(53500)}, 30% to ${salesFmt(78100)}, 33% to ${salesFmt(180000)}, 39% above &mdash; plus the ACC earners' levy. Worked on the year as a whole, because that is how the bands work; a payslip would also carry KiwiSaver and any student loan.</p>
    </section>`;
  }

  function salesLineTotal(line: string): number {
    if (line === 'np') return SALES_MONTHS.reduce((t, m) => t + (salesNp(m) ?? 0), 0);
    return SALES_MONTHS.reduce((t, m) => t + (salesValue(m, line) ?? 0), 0);
  }

  /* Repaint only the bottom row. A full renderSales() here would rebuild the
     inputs mid-edit, which throws away the focus Tab is trying to hand on. */
  function updateSalesTotals() {
    const tds = document.querySelectorAll('#sales-inner tfoot td:not(.sales-mh)');
    SALES_LINES.forEach((l, i) => {
      const td = tds[i] as HTMLElement | undefined;
      if (!td) return;
      const t = salesLineTotal(l.key);
      // rebuilt rather than toggled, but the column rule has to survive it
      td.className = [l.derived ? 'sales-np' : '', t === 0 ? 'is-zero' : t < 0 ? 'is-neg' : ''].filter(Boolean).join(' ');
      td.textContent = t === 0 ? '—' : salesFmt(t);
    });
    // the summary is built off those totals, so it moves with them
    const take = document.getElementById('sales-take-wrap');
    if (take) take.innerHTML = salesTakeHtml();
  }

  function commitSalesCell(el: HTMLInputElement) {
    const month = el.dataset.month!, line = el.dataset.line!;
    const before = salesValue(month, line);
    const parsed = parseSalesInput(el.value);
    const next = parsed !== null && Number.isNaN(parsed) ? before : parsed;
    if (next !== before) setSalesValue(month, line, next);
    el.value = next === null ? '' : salesFmt(next);
    el.closest('.sales-cell')?.classList.toggle('is-neg', next !== null && next < 0);
    paintSalesNp(month);
    updateSalesTotals();
  }

  /* Repaint one month's NP box in place, for the same reason the totals are
     repainted rather than re-rendered: a full renderSales() would rebuild
     the inputs mid-edit and throw away the focus Tab is handing on. */
  function paintSalesNp(month: string) {
    const td = document.querySelector(`#sales-inner td.sales-np[data-month="${month}"]`) as HTMLElement | null;
    if (!td) return;
    const v = salesNp(month);
    td.classList.toggle('is-neg', v !== null && v < 0);
    td.classList.toggle('is-zero', v === null);
    // the figure lives inside the button that opens the potential, so write
    // into it rather than over the top of it
    const btn = td.querySelector('.sales-np-open') as HTMLElement | null;
    const p = salesPotential(month);
    if (btn) {
      btn.textContent = v === null ? '—' : salesFmt(v);
      btn.title = p
        ? `Gross Profit less Expenses less Salary \u2014 a year of months like this is worth ${salesFmt(p.year)} to you`
        : 'Gross Profit less Expenses less Salary';
    } else {
      td.textContent = v === null ? '—' : salesFmt(v);
    }
  }

  // true while a figure is being worked on, so a cloud pull does not repaint over it
  function salesCellFocused(): boolean {
    if (document.getElementById('sales-build-modal')?.classList.contains('visible')) return true;
    if (document.getElementById('sales-np-modal')?.classList.contains('visible')) return true;
    return !!(document.activeElement as HTMLElement | null)?.closest?.('.sales-cell');
  }

  /* ---- Earning potential ----
     The one thing NP is actually read for: not the figure itself but what a
     year of months like this one would be worth. Nothing to edit, so the
     modal only lays the arithmetic out in the order it is done, and ends on
     the number. */
  let npCellMonth: string | null = null;

  function openNpPotential(month: string) {
    const body = document.getElementById('ep-body');
    if (!body) return;
    npCellMonth = month;
    (document.getElementById('ep-title') as HTMLElement).textContent =
      `Earning potential \u2014 ${salesMonthName(month)}`;

    const p = salesPotential(month);
    body.innerHTML = !p
      ? `<p class="ep-empty">Nothing to work from yet. Fill in Gross Profit, Expenses and Salary for ${salesMonthName(month)} and this will tell you what a year of months like it is worth.</p>`
      : `
      <div class="ep-work">
        <div class="ep-row"><span>Salary</span><b>${salesFmt(p.salary)}</b></div>
        <div class="ep-row${p.np < 0 ? ' is-neg' : ''}"><span>NP</span><b>${salesFmt(p.np)}</b></div>
        <div class="ep-row is-sub${p.together < 0 ? ' is-neg' : ''}"><span>Together, for the month</span><b>${salesFmt(p.together)}</b></div>
        <div class="ep-row is-op"><span>Your half, run for a year</span><b>\u00f7 2 \u00d7 12</b></div>
      </div>
      <div class="ep-figure${p.year < 0 ? ' is-neg' : ''}">
        <b>${salesFmt(p.year)}</b>
        <span>a year \u2014 ${salesFmtExact(p.half)} a month to you</span>
      </div>
      <p class="ep-note">If ${salesMonthName(month)} kept happening. Worked off the salary and net profit as they stand in the sheet \u2014 nothing here is saved.</p>`;

    document.getElementById('sales-np-modal')!.classList.add('visible');
    (document.getElementById('ep-close') as HTMLElement | null)?.focus();
  }

  function closeNpPotential() {
    document.getElementById('sales-np-modal')!.classList.remove('visible');
    npCellMonth = null;
  }

  document.getElementById('ep-close')?.addEventListener('click', closeNpPotential);
  document.querySelectorAll('#sales-np-modal .modal-close').forEach(b =>
    b.addEventListener('click', closeNpPotential));
  document.getElementById('sales-np-modal')?.addEventListener('click', e => {
    if (e.target === e.currentTarget) closeNpPotential();
  });

  /* ---- The breakdown editor ----
     Revenue and Passive are the two lines you forecast by looking at what
     is actually in front of you, so they are assembled rather than keyed:
     the box opens this sheet, each line is a piece of work, and the figure
     is their total. Held in a working copy while open and written on Done,
     so a half-entered list never reaches the sheet or the cloud. */
  let buildCell: { month: string; line: string } | null = null;
  let buildRows: SalesItem[] = [];

  const newBuildItem = (label = '', value = 0): SalesItem =>
    ({ id: `sbi-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`, label, value });

  // the amount fields carry their own $, so the figure goes in without one
  const salesNum = (v: number) => (v < 0 ? '-' : '') + Math.abs(v).toLocaleString('en-NZ');

  const buildTotal = () => buildRows.reduce((t, r) => t + (r.value || 0), 0);
  const buildIsBlank = () => buildRows.every(r => !r.label.trim() && !r.value);

  function openSalesBuild(month: string, line: string) {
    buildCell = { month, line };
    const items = salesItems(month, line);
    const typed = salesValue(month, line);
    buildRows = items.length
      ? items.map(it => ({ ...it }))
      /* A figure that was keyed before this existed, or by an older copy of
         the app, opens as its own single line rather than being thrown away. */
      : typed !== null ? [newBuildItem('', typed)] : [];
    if (!buildRows.length) buildRows.push(newBuildItem());

    (document.getElementById('sb-title') as HTMLElement).textContent =
      `${salesLineLabel(line)} \u2014 ${salesMonthName(month)}`;
    renderBuildRows();
    document.getElementById('sales-build-modal')!.classList.add('visible');
    (document.querySelector('#sb-rows .sb-row input') as HTMLInputElement | null)?.focus();
  }

  function closeSalesBuild() {
    document.getElementById('sales-build-modal')!.classList.remove('visible');
    buildCell = null;
    buildRows = [];
  }

  function saveSalesBuild() {
    if (!buildCell) return;
    const { month, line } = buildCell;
    // a line with neither a name nor a figure was never a line
    const items = buildRows
      .map(r => ({ id: r.id, label: r.label.trim(), value: r.value || 0 }))
      .filter(r => r.label || r.value);
    setSalesBreakdown(month, line, items);
    closeSalesBuild();
    renderSales();
  }

  function updateBuildTotal() {
    const el = document.getElementById('sb-total') as HTMLElement | null;
    if (!el) return;
    const t = buildTotal();
    el.className = t === 0 ? 'is-zero' : t < 0 ? 'is-neg' : '';
    el.textContent = t === 0 ? '\u2014' : salesFmt(t);
  }

  /* The month before this one, same line - a forecast is mostly last
     month's work carried on, and re-keying it twelve times is the thing
     that stops a sheet like this from ever being filled in. Only offered
     while the list is still blank, so it can never wipe anything. */
  function buildCarrySource(): { month: string; items: SalesItem[] } | null {
    if (!buildCell) return null;
    const i = SALES_MONTHS.indexOf(buildCell.month);
    if (i <= 0) return null;
    const prev = SALES_MONTHS[i - 1];
    const items = salesItems(prev, buildCell.line);
    return items.length ? { month: prev, items } : null;
  }

  function renderBuildRows() {
    const root = document.getElementById('sb-rows');
    if (!root) return;

    root.innerHTML = buildRows.length ? buildRows.map((r, i) => `
      <div class="sb-row" data-i="${i}">
        <input type="text" class="sb-label" spellcheck="false" autocomplete="off"
          placeholder="Project, client or job" value="${escapeHtml(r.label)}"
          aria-label="What this line is">
        <div class="sb-amt"><i>$</i><input type="text" class="sb-val" inputmode="decimal"
          spellcheck="false" autocomplete="off" placeholder="0"
          value="${r.value ? escapeHtml(salesNum(r.value)) : ''}"
          aria-label="Amount"></div>
        <button type="button" class="sb-del" data-del="${i}" title="Remove this line" aria-label="Remove this line">&times;</button>
      </div>`).join('')
      : `<p class="sb-empty">Nothing here yet \u2014 add the first piece of work.</p>`;

    root.querySelectorAll('.sb-label').forEach(el => {
      const inp = el as HTMLInputElement;
      inp.addEventListener('input', () => {
        buildRows[+(inp.closest('.sb-row') as HTMLElement).dataset.i!].label = inp.value;
        syncBuildCarry();
      });
    });

    root.querySelectorAll('.sb-val').forEach(el => {
      const inp = el as HTMLInputElement;
      const rowOf = () => buildRows[+(inp.closest('.sb-row') as HTMLElement).dataset.i!];
      inp.addEventListener('input', () => {
        const parsed = parseSalesInput(inp.value);
        // mid-typo stays on screen; only a figure that reads as one counts
        if (parsed !== null && Number.isNaN(parsed)) return;
        rowOf().value = parsed ?? 0;
        updateBuildTotal();
        syncBuildCarry();
      });
      inp.addEventListener('focus', () => inp.select());
      inp.addEventListener('blur', () => {
        const v = rowOf().value;
        inp.value = v ? salesNum(v) : '';
      });
      inp.addEventListener('keydown', e => {
        if ((e as KeyboardEvent).key !== 'Enter') return;
        e.preventDefault();
        addBuildRow();
      });
    });

    root.querySelectorAll('[data-del]').forEach(b => b.addEventListener('click', () => {
      buildRows.splice(+(b as HTMLElement).dataset.del!, 1);
      renderBuildRows();
    }));

    updateBuildTotal();
    syncBuildCarry();
  }

  function addBuildRow() {
    buildRows.push(newBuildItem());
    renderBuildRows();
    const rows = document.querySelectorAll('#sb-rows .sb-row input.sb-label');
    (rows[rows.length - 1] as HTMLInputElement | undefined)?.focus();
  }

  function syncBuildCarry() {
    const btn = document.getElementById('sb-copy') as HTMLButtonElement | null;
    if (!btn) return;
    const src = buildCarrySource();
    const show = !!src && buildIsBlank();
    btn.hidden = !show;
    if (show && src) btn.textContent = `Copy ${salesMonthName(src.month)}`;
  }

  document.getElementById('sb-add')?.addEventListener('click', addBuildRow);
  document.getElementById('sb-save')?.addEventListener('click', saveSalesBuild);
  document.getElementById('sb-copy')?.addEventListener('click', () => {
    const src = buildCarrySource();
    if (!src) return;
    buildRows = src.items.map(it => newBuildItem(it.label, it.value));
    renderBuildRows();
  });
  document.querySelectorAll('#sales-build-modal .modal-close').forEach(b =>
    b.addEventListener('click', saveSalesBuild));
  document.getElementById('sales-build-modal')?.addEventListener('click', e => {
    if (e.target === e.currentTarget) saveSalesBuild();
  });
  document.addEventListener('keydown', e => {
    if ((e as KeyboardEvent).key !== 'Escape') return;
    if (npCellMonth) { e.stopPropagation(); closeNpPotential(); return; }
    if (!buildCell) return;
    // Esc walks away from the box without writing, the same as it does in the sheet
    e.stopPropagation();
    closeSalesBuild();
  }, true);

  function renderSales() {
    const root = document.getElementById('sales-inner');
    if (!root) return;

    const now = new Date();
    const nowKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

    /* Each month is settled, in play, or still only forecast. Compared as
       strings rather than against an index, so a sheet that sits entirely
       behind or ahead of today still shades correctly instead of reading as
       twelve months of history. */
    const firstFwd = SALES_MONTHS.findIndex(m => m > nowKey);

    const rows = SALES_MONTHS.map((m, i) => {
      const cls = [m === nowKey ? 'is-now' : m > nowKey ? 'is-fwd' : 'is-past'];
      // the line between what has happened and what is still being planned
      if (i === firstFwd && i > 0) cls.push('is-fwd-open');
      return `
      <tr class="${cls.join(' ')}">
        <td class="sales-mo">${MONTH_ABBR[+m.slice(5) - 1]} <em>${m.slice(0, 4)}</em>${m === nowKey ? '<i>now</i>' : ''}</td>
        ${SALES_LINES.map(l => {
          if (l.derived) {
            const d = salesNp(m);
            const p = salesPotential(m);
            return `<td class="sales-cell sales-np is-openable${d === null ? ' is-zero' : d < 0 ? ' is-neg' : ''}"
              data-month="${m}"><button type="button" class="sales-np-open" data-month="${m}"
              title="${p ? `Gross Profit less Expenses less Salary \u2014 a year of months like this is worth ${salesFmt(p.year)} to you` : 'Gross Profit less Expenses less Salary'}"
              aria-label="${l.label}, ${salesMonthName(m)} \u2014 opens what a year of this month is worth"
              >${d === null ? '—' : salesFmt(d)}</button></td>`;
          }
          const v = salesValue(m, l.key);
          if (l.built) {
            const items = salesItems(m, l.key);
            // the breakdown itself, on hover - no second view needed to read it back
            const tip = items.length
              ? items.map(it => `${it.label || 'Unnamed'} \u00b7 ${salesFmt(it.value)}`).join('\n')
              : 'Build this figure from the work behind it';
            return `<td class="sales-cell${v !== null && v < 0 ? ' is-neg' : ''}"><button
              type="button" class="sales-build${v === null ? ' is-empty' : ''}"
              data-month="${m}" data-line="${l.key}" title="${escapeHtml(tip)}"
              aria-label="${l.label}, ${salesMonthName(m)} \u2014 ${items.length
                ? `${items.length} line${items.length === 1 ? '' : 's'}` : 'empty'}, opens the breakdown"
              >${items.length > 1 ? `<i>${items.length}</i>` : ''}<span>${v === null ? '\u2014' : salesFmt(v)}</span></button></td>`;
          }
          return `<td class="sales-cell${v !== null && v < 0 ? ' is-neg' : ''}"><input
            type="text" inputmode="decimal" spellcheck="false" autocomplete="off" placeholder="—"
            data-month="${m}" data-line="${l.key}"
            aria-label="${l.label}, ${salesMonthName(m)}"
            value="${v === null ? '' : salesFmt(v)}"></td>`;
        }).join('')}
      </tr>`;
    }).join('');

    root.innerHTML = `
      <table class="sales-sheet">
        <thead>
          <tr>
            <th class="sales-mh">Month</th>
            ${SALES_LINES.map(l => `<th${l.derived ? ' class="sales-np"' : ''}>${l.label}</th>`).join('')}
          </tr>
        </thead>
        <tbody>${rows}</tbody>
        <tfoot>
          <tr>
            <td class="sales-mh">Total</td>
            ${SALES_LINES.map(l => {
              const t = salesLineTotal(l.key);
              const cls = [l.derived ? 'sales-np' : '', t === 0 ? 'is-zero' : t < 0 ? 'is-neg' : ''].filter(Boolean).join(' ');
              return `<td class="${cls}">${t === 0 ? '—' : salesFmt(t)}</td>`;
            }).join('')}
          </tr>
        </tfoot>
      </table>
      <div id="sales-take-wrap">${salesTakeHtml()}</div>
      <p class="sales-hint"><strong>Revenue</strong> and <strong>Passive Revenue</strong> open a breakdown &mdash; list the projects and work you can see, and the month's figure is their total. The rest are typed: <strong>Tab</strong> moves across, <strong>Enter</strong> moves down, <strong>Esc</strong> undoes. <strong>NP</strong> is the one worked-out column: Gross Profit less Expenses less Salary &mdash; click it to see what a year of months like that one is worth to you. The only other sums are the year totals along the bottom.</p>`;

    /* Inputs and breakdown buttons together, in the order they sit in the
       grid, so Tab and Enter still walk the sheet as one surface even
       though two of the five columns are no longer typed into. */
    root.querySelectorAll('.sales-np-open').forEach(b => b.addEventListener('click', () =>
      openNpPotential((b as HTMLElement).dataset.month!)));

    const cells = Array.from(root.querySelectorAll('.sales-cell input, .sales-cell .sales-build')) as HTMLElement[];
    cells.forEach((cell, idx) => {
      if (cell instanceof HTMLButtonElement) {
        // Enter and Space reach this too, as the browser's own button handling
        cell.addEventListener('click', () => openSalesBuild(cell.dataset.month!, cell.dataset.line!));
        return;
      }
      const el = cell as HTMLInputElement;
      el.addEventListener('focus', () => el.select());
      el.addEventListener('blur', () => commitSalesCell(el));
      el.addEventListener('keydown', e => {
        const ev = e as KeyboardEvent;
        if (ev.key === 'Escape') {
          const v = salesValue(el.dataset.month!, el.dataset.line!);
          el.value = v === null ? '' : salesFmt(v);
          el.blur();
        } else if (ev.key === 'Enter') {
          ev.preventDefault();
          // down a month in the same line, or up one with shift
          const next = cells[idx + (ev.shiftKey ? -SALES_INPUT_COLS : SALES_INPUT_COLS)];
          if (next) next.focus(); else el.blur();
        }
      });
    });
  }

  // ============ PEOPLE ============
  /* The same six boards, holding only lead cards. Because the view is
     homogeneous there is nothing to tell apart, so no lens and no competing
     card languages. Laid out as a uniform grid rather than a scatter - a
     roster, not a whiteboard - and ordered by what needs you, so the board
     answers "where am I at" without being arranged by hand. */
  function leadCardHtml(n: Note): string {
    const play = playOf(n);
    const total = play ? play.steps.length : 0;
    const at = n.playStep ?? 0;
    const due = playDueToday(n);
    const step = currentStep(n);

    const rail = play ? `
      <div class="lead-rail ${due ? 'due' : ''}">
        <span class="rail-pips">${Array.from({ length: total }, (_, i) =>
          `<i class="${i < at ? 'done' : i === at ? 'now' : ''}"></i>`).join('')}</span>
        <span class="rail-count">${due && step ? `${stepIcon(step.type)} ${escapeHtml(stepLabel(step.type))}` : `${at + 1}/${total}`}</span>
      </div>` : `<div class="lead-rail empty">No play</div>`;

    const contacts = [
      n.phone ? `<a href="tel:${escapeHtml(n.phone.replace(/\s+/g, ''))}" title="${escapeHtml(n.phone)}" data-stop>${ACTIVITY_ICONS.call}</a>` : '',
      n.email ? `<a href="mailto:${escapeHtml(n.email)}" title="${escapeHtml(n.email)}" data-stop>${ACTIVITY_ICONS.email}</a>` : '',
      n.linkedin ? `<a href="${escapeHtml(n.linkedin.startsWith('http') ? n.linkedin : 'https://' + n.linkedin)}" target="_blank" rel="noopener" title="LinkedIn" data-stop>${ACTIVITY_ICONS.linkedin}</a>` : '',
      n.website ? `<a href="${escapeHtml(n.website.startsWith('http') ? n.website : 'https://' + n.website)}" target="_blank" rel="noopener" title="Website" data-stop>${ACTIVITY_ICONS.web}</a>` : '',
    ].join('');

    const goal = n.goalId ? getGoals().find(g => g.id === n.goalId) : null;

    return `
      <div class="person ${due ? 'is-due' : ''}" data-id="${n.id}">
        <div class="person-head">
          <div class="lead-face">${n.avatar
            ? `<img src="${n.avatar}" alt="">`
            : `<span>${escapeHtml(initials(n.name || noteHeadline(n)))}</span>`}</div>
          <div class="lead-who">
            <div class="lead-card-name">${escapeHtml(n.name || noteHeadline(n))}</div>
            ${n.role ? `<div class="lead-card-role">${escapeHtml(n.role)}</div>` : ''}
            ${n.company ? `<div class="lead-card-co">${escapeHtml(n.company)}</div>` : ''}
          </div>
        </div>
        <div class="person-foot">
          <div class="lead-card-contacts">${contacts}</div>
          ${n.lastPostAt ? `<span class="person-post ${Math.floor((Date.now() - n.lastPostAt) / 86400000) <= 7 ? 'fresh' : ''}" title="Last LinkedIn post${n.lastPostNote ? ': ' + escapeHtml(n.lastPostNote) : ''}">${describeAge(n.lastPostAt)}</span>` : ''}
          ${goal ? `<span class="person-goal" title="Goal: ${escapeHtml(goal.text || 'Untitled goal')}">◆</span>` : ''}
        </div>
        ${rail}
      </div>`;
  }

  document.getElementById('add-person')?.addEventListener('click', () => {
    const q = state.notes.some(n => n.isLead) ? (state.notes.find(n => n.isLead)!.quadrant ?? 0) : 0;
    const person: Note = {
      id: `lead-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
      text: '', color: BOARD_COLORS[q], x: 60, y: 80, rotation: 0,
      createdAt: Date.now(), updatedAt: Date.now(), zIndex: state.nextZIndex++,
      isLead: true, quadrant: q, name: '', activity: [],
    };
    state.notes.push(person);
    save();
    refreshView(true);
    openDetailModal(person.id);
  });

  let peopleQuery = '';

  function matchesPerson(n: Note, q: string): boolean {
    if (!q) return true;
    return [n.name, n.role, n.company, n.email].some(v => (v || '').toLowerCase().includes(q));
  }

  document.getElementById('people-search')?.addEventListener('input', (e) => {
    peopleQuery = (e.target as HTMLInputElement).value;
    renderPeople();
  });
  document.getElementById('people-search')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Escape') {
      peopleQuery = '';
      (e.target as HTMLInputElement).value = '';
      renderPeople();
    }
  });

  /* Someone added with nothing but a LinkedIn URL is waiting to be hydrated -
     the photo is a phone job, so desktop queues and the PDA finishes it. */
  function isQueued(n: Note): boolean {
    return !!n.isLead && /linkedin\.com\/in\//i.test(n.linkedin || '') && !(n.name || '').trim();
  }

  function queueSlug(n: Note): string {
    const m = (n.linkedin || '').match(/\/in\/([^/?#]+)/);
    return m ? decodeURIComponent(m[1]).replace(/-[a-z0-9]{6,}$/i, '').replace(/-/g, ' ') : (n.linkedin || '');
  }

  document.getElementById('queue-url')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key !== 'Enter') return;
    const input = e.target as HTMLInputElement;
    const url = input.value.trim();
    if (!url) return;
    if (!/linkedin\.com\/in\//i.test(url)) { alert('That does not look like a LinkedIn profile URL.'); return; }
    if (state.notes.some(n => n.isLead && (n.linkedin || '').replace(/\/+$/, '') === url.replace(/\/+$/, ''))) {
      alert('That profile is already here.'); input.value = ''; return;
    }
    const q = state.notes.filter(n => n.isLead).length ? (state.notes.find(n => n.isLead)!.quadrant ?? 0) : 0;
    state.notes.push({
      id: `lead-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
      text: '', color: BOARD_COLORS[q], x: 60, y: 80, rotation: 0,
      createdAt: Date.now(), updatedAt: Date.now(), zIndex: state.nextZIndex++,
      isLead: true, quadrant: q, name: '', linkedin: url, activity: [],
    });
    save();
    input.value = '';
    renderPeople();
  });

  /* ---- Hydrate --------------------------------------------------------
     A queued row is only a LinkedIn URL. Hydrating turns it into a person:
     /hydrate identifies who it is, /enrich-profile goes after the website
     and contact details. Same two calls the phone makes.

     The reason it belongs here and not only on the phone is the dedupe. You
     cannot tell whether you already have someone's company until you know
     what their company is, so the check has to happen after the first call
     and before the person is written. Anyone who clashes stays in the queue
     with the clash named, rather than quietly landing on a board. ---- */
  type Finding = { name: string; role: string; company: string; clashWith: string };
  const queueFindings = new Map<string, Finding>();   // deliberately not persisted
  let hydrating = false;

  const normCo = (s: string) =>
    (s || '').toLowerCase()
      .replace(/\b(limited|ltd|pty|llc|inc|incorporated|company|co|group|holdings|nz|new zealand)\b/g, '')
      .replace(/[^a-z0-9]/g, '');

  function queueMsg(id: string, text: string, isError = false) {
    const el = document.querySelector(`[data-msg="${id}"]`);
    if (!el) return;
    el.textContent = text;
    el.classList.toggle('err', isError);
  }

  /* Does someone already here work at this company? Queued rows are excluded -
     they have no company yet - as is the row being hydrated. */
  function companyClash(company: string, exceptId: string): string | null {
    const key = normCo(company);
    if (!key) return null;
    const hit = state.notes.find(n =>
      n.isLead && n.id !== exceptId && !isQueued(n) && normCo(n.company || '') === key);
    return hit ? (hit.name || 'someone already here') : null;
  }

  async function hydrateOne(id: string, opts: { force?: boolean } = {}): Promise<'added' | 'held' | 'failed'> {
    const pw = getSyncPassword();
    if (!pw) { queueMsg(id, 'No project set', true); return 'failed'; }
    const note = state.notes.find(n => n.id === id);
    if (!note?.linkedin) return 'failed';

    try {
      queueMsg(id, 'Identifying...');
      const res = await fetch(`${WORKER_URL}/hydrate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Sync-Password': pw },
        body: JSON.stringify({ profileUrl: note.linkedin }),
      });
      const p = await res.json();
      if (!res.ok || !p.name) { queueMsg(id, 'Could not identify that profile', true); return 'failed'; }

      const clash = opts.force ? null : companyClash(p.company || '', id);
      if (clash) {
        queueFindings.set(id, { name: p.name, role: p.role || '', company: p.company || '', clashWith: clash });
        renderPeople();
        return 'held';
      }

      // Only now is it safe to write. The contact details are a bonus - if
      // that call fails the person is still correctly identified.
      note.name = p.name;
      note.role = p.role || '';
      note.company = p.company || '';

      queueMsg(id, 'Finding contact details...');
      try {
        const er = await fetch(`${WORKER_URL}/enrich-profile`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Sync-Password': pw },
          body: JSON.stringify({ name: p.name, company: p.company }),
        });
        const d = await er.json();
        if (er.ok) {
          note.website = d.website || note.website || '';
          note.phone = d.phone || note.phone || '';
          note.email = d.email || note.email || '';
        }
      } catch { /* identified is enough; contacts can be filled by hand */ }

      note.updatedAt = Date.now();
      queueFindings.delete(id);
      save();
      renderPeople();
      return 'added';
    } catch {
      queueMsg(id, 'Could not reach the worker', true);
      return 'failed';
    }
  }

  function setHydrateBusy(on: boolean) {
    hydrating = on;
    document.querySelectorAll('.queue-hy, .queue-all').forEach(b => (b as HTMLButtonElement).disabled = on);
  }

  document.getElementById('people-inner')?.addEventListener('click', async (e) => {
    const el = (e.target as HTMLElement).closest('[data-hy], [data-anyway], [data-hydrate-all]') as HTMLElement | null;
    if (!el || hydrating) return;

    if (el.dataset.hydrateAll !== undefined) {
      const ids = state.notes.filter(isQueued).map(n => n.id);
      if (!ids.length) return;
      setHydrateBusy(true);
      let added = 0, held = 0, failed = 0;
      // one at a time on purpose: these calls are slow and the worker is not
      // something to fire fifty requests at
      for (const id of ids) {
        const r = await hydrateOne(id);
        if (r === 'added') added++; else if (r === 'held') held++; else failed++;
      }
      setHydrateBusy(false);
      const hint = document.querySelector('.queue-hint');
      if (hint) hint.textContent =
        `${added} added${held ? `, ${held} held back as duplicate companies` : ''}${failed ? `, ${failed} could not be identified` : ''}.`;
      return;
    }

    const id = el.dataset.hy || el.dataset.anyway!;
    setHydrateBusy(true);
    await hydrateOne(id, { force: el.dataset.anyway !== undefined });
    setHydrateBusy(false);
  });

  function renderPeople() {
    const root = document.getElementById('people-inner');
    const countEl = document.getElementById('people-count');
    if (!root) return;
    const titles = state.boardTitles || DEFAULT_TITLES;

    const all = state.notes.filter(n => n.isLead);
    const q = peopleQuery.trim().toLowerCase();
    const leads = all.filter(n => matchesPerson(n, q));

    if (countEl) {
      const due = leads.filter(playDueToday).length;
      const waiting = all.filter(isQueued).length;
      countEl.textContent = q
        ? `${leads.length} of ${all.length}`
        : `${all.length - waiting} ${all.length - waiting === 1 ? 'person' : 'people'}${due ? ` · ${due} due` : ''}${waiting ? ` · ${waiting} to hydrate` : ''}`;
    }

    if (!all.length) { root.innerHTML = `<div class="people-empty">No people yet.</div>`; return; }
    if (!leads.length) { root.innerHTML = `<div class="people-empty">Nobody matches "${escapeHtml(peopleQuery)}".</div>`; return; }

    const queued = leads.filter(isQueued);
    const placed = leads.filter(n => !isQueued(n));

    const byBoard = new Map<number, Note[]>();
    placed.forEach(n => {
      const q = n.quadrant ?? 0;
      if (!byBoard.has(q)) byBoard.set(q, []);
      byBoard.get(q)!.push(n);
    });

    const queueHtml = queued.length ? `
      <section class="people-section queue-section">
        <header class="people-board">
          <span class="pe-dot queue-dot"></span>
          <h3>Waiting to hydrate</h3>
          <span class="people-n">${queued.length}</span>
          <button class="queue-all" data-hydrate-all title="Hydrate every queued profile, one after another">Hydrate all</button>
        </header>
        <p class="queue-hint">Hydrate fills in who they are and where they work. Anyone whose company you already have is held back here rather than added.</p>
        <div class="queue-rows">${queued.map(n => {
          const f = queueFindings.get(n.id);
          return `
          <div class="queue-row ${f ? 'is-dupe' : ''}" data-id="${n.id}">
            <span class="queue-name">${escapeHtml(f ? f.name : queueSlug(n))}</span>
            ${f ? `<span class="queue-dupe">Already have ${escapeHtml(f.company)} — ${escapeHtml(f.clashWith)}</span>` : ''}
            <span class="queue-msg" data-msg="${n.id}"></span>
            ${f
              ? `<button class="queue-hy" data-anyway="${n.id}">Add anyway</button>`
              : `<button class="queue-hy" data-hy="${n.id}">Hydrate</button>`}
            <a class="queue-open" href="${escapeHtml(n.linkedin!)}" target="_blank" rel="noopener" data-stop title="Open profile">View</a>
            <button class="queue-del" data-del="${n.id}" title="Remove">&times;</button>
          </div>`;
        }).join('')}</div>
      </section>` : '';

    // what needs you first, then who is booked, then who nobody is working
    const rank = (n: Note) => playDueToday(n) ? 0 : n.playId ? 1 : 2;

    root.innerHTML = queueHtml + [...byBoard.entries()].sort((a, b) => a[0] - b[0]).map(([q, list]) => {
        list.sort((a, c) => {
          const d = rank(a) - rank(c);
          if (d) return d;
          if (a.playDueAt && c.playDueAt) return a.playDueAt - c.playDueAt;
          return (a.name || '').localeCompare(c.name || '');
        });
        return `
          <section class="people-section">
            <header class="people-board">
              <span class="pe-dot" style="background:${BOARD_COLORS[q]}"></span>
              <h3>${escapeHtml(titles[q] || DEFAULT_TITLES[q])}</h3>
              <span class="people-n">${list.length}</span>
            </header>
            <div class="people-grid">${list.map(leadCardHtml).join('')}</div>
          </section>`;
      }).join('');

    root.querySelectorAll('[data-del]').forEach(b => b.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = (b as HTMLElement).dataset.del!;
      tombstone(id);
      state.notes = state.notes.filter(n => n.id !== id);
      save();
      renderPeople();
    }));

    root.querySelectorAll('.person').forEach(card => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-stop]')) return;
        openDetailModal((card as HTMLElement).dataset.id!);
      });
    });
  }

  // ============ PLAYS VIEW ============
  /* Today's sequence work, grouped by play - the play is the unit you are
     learning about. Everything here is one click from done. */
  function renderPlaysView() {
    const root = document.getElementById('plays-inner');
    if (!root) return;

    const due = leadsWithStepDue();
    const upcoming = state.notes
      .filter(n => n.isLead && n.playId && n.playDueAt && n.playDueAt > endOfToday() && currentStep(n))
      .sort((a, b) => (a.playDueAt || 0) - (b.playDueAt || 0))
      .slice(0, 8);
    const idle = state.notes.filter(n => n.isLead && !n.playId).length;

    const byPlay = new Map<string, Note[]>();
    due.forEach(l => {
      const key = l.playId!;
      if (!byPlay.has(key)) byPlay.set(key, []);
      byPlay.get(key)!.push(l);
    });

    const row = (l: Note) => {
      const step = currentStep(l)!;
      const overdue = (l.playDueAt || 0) < startOfToday();
      return `
        <div class="pl-row ${overdue ? 'overdue' : ''}" data-lead="${l.id}">
          <span class="pl-icon">${stepIcon(step.type)}</span>
          <div class="pl-main">
            <div class="pl-step">${escapeHtml(stepLabel(step.type))}${step.template ? `<span class="pl-tpl">${escapeHtml(step.template)}</span>` : ''}</div>
            <div class="pl-who">${escapeHtml(l.name || noteHeadline(l))}${l.company ? ` · ${escapeHtml(l.company)}` : ''}</div>
            ${step.note ? `<div class="pl-note">${escapeHtml(step.note)}</div>` : ''}
          </div>
          <div class="pl-actions">
            <button class="pl-do" data-lead="${l.id}">Do</button>
            <button class="pl-skip" data-lead="${l.id}">Skip</button>
          </div>
        </div>`;
    };

    root.innerHTML = `
      <div class="pl-head">
        <span class="pl-count">Today${due.length ? ` · ${due.length}` : ''}</span>
      </div>
      ${due.length ? [...byPlay.entries()].map(([pid, leads]) => `
        <section class="pl-section">
          <h3>${escapeHtml(getPlays().find(p => p.id === pid)?.name || 'Play')}</h3>
          <div class="pl-rows">${leads.map(row).join('')}</div>
        </section>`).join('') : `<div class="pl-empty">Nothing due today.</div>`}

      ${upcoming.length ? `
        <section class="pl-section pl-upcoming">
          <h3>Coming up</h3>
          <div class="pl-rows">${upcoming.map(l => {
            const st = currentStep(l)!;
            return `<div class="pl-row quiet" data-lead="${l.id}">
              <span class="pl-icon">${stepIcon(st.type)}</span>
              <div class="pl-main">
                <div class="pl-step">${escapeHtml(stepLabel(st.type))}</div>
                <div class="pl-who">${escapeHtml(l.name || noteHeadline(l))}</div>
              </div>
              <span class="pl-when">${formatDate(l.playDueAt!)}</span>
            </div>`;
          }).join('')}</div>
        </section>` : ''}

      ${idle ? `<div class="pl-idle">${idle} lead${idle === 1 ? '' : 's'} with no play running</div>` : ''}
    `;

    root.querySelectorAll('.pl-do').forEach(b => b.addEventListener('click', (e) => {
      e.stopPropagation(); doPlayStep((b as HTMLElement).dataset.lead!);
    }));
    root.querySelectorAll('.pl-skip').forEach(b => b.addEventListener('click', (e) => {
      e.stopPropagation(); skipPlayStep((b as HTMLElement).dataset.lead!);
    }));
    root.querySelectorAll('.pl-row').forEach(r => r.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      openDetailModal((r as HTMLElement).dataset.lead!);
    }));
  }

  // ============ LIST VIEW ============
  const LIST_FILTER_KEY = 'stiki-list-filter';
  let listFilter: number | null = (() => {
    const v = localStorage.getItem(LIST_FILTER_KEY);
    const n = v === null ? NaN : parseInt(v, 10);
    return n >= 0 && n <= 5 ? n : null;
  })();

  function setListFilter(q: number | null) {
    listFilter = q;
    if (q === null) localStorage.removeItem(LIST_FILTER_KEY);
    else localStorage.setItem(LIST_FILTER_KEY, String(q));
    renderList();
  }

  const CONTACT_LINKS: { key: keyof Note; href: (v: string) => string; label: string; icon: string }[] = [
    { key: 'email', label: 'Email', href: v => `mailto:${v}`,
      icon: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>' },
    { key: 'phone', label: 'Call', href: v => `tel:${v.replace(/\s+/g, '')}`,
      icon: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>' },
    { key: 'linkedin', label: 'LinkedIn', href: v => v.startsWith('http') ? v : `https://${v}`,
      icon: '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.4v1.6h.05c.5-.9 1.6-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5v6.3zM5.3 7.4a2.1 2.1 0 110-4.2 2.1 2.1 0 010 4.2zM7.1 20.5H3.6V9h3.5v11.5z"/></svg>' },
    { key: 'website', label: 'Website', href: v => v.startsWith('http') ? v : `https://${v}`,
      icon: '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>' },
  ];

  function initials(name: string): string {
    const parts = name.trim().split(/\s+/).filter(Boolean);
    if (!parts.length) return '?';
    return (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
  }

  function listRowHtml(note: Note, goals: Goal[]): string {
    const lines = (note.text || '').split('\n').map(l => l.trim()).filter(Boolean);
    const primary = note.isLead ? (note.name || lines[0] || 'Unnamed lead') : (lines[0] || 'Untitled');
    const secondary = note.isLead
      ? [note.role, note.company].filter(Boolean).join(' · ')
      : lines.slice(1).join(' · ');

    // Leads keep their face; a plain stiki shows its own paper colour
    const avatar = note.isLead
      ? (note.avatar
          ? `<img class="lrow-face" src="${note.avatar}" alt="">`
          : `<span class="lrow-face lrow-initials">${escapeHtml(initials(primary))}</span>`)
      : `<span class="lrow-chip" style="background:${note.color}"></span>`;

    const contacts = note.isLead ? CONTACT_LINKS
      .filter(c => note[c.key])
      .map(c => `<a class="lrow-contact" href="${escapeHtml(c.href(String(note[c.key])))}" target="_blank" rel="noopener" title="${c.label}" data-stop>${c.icon}</a>`)
      .join('') : '';

    const goal = note.goalId ? goals.find(g => g.id === note.goalId) : null;
    const goalHtml = goal
      ? `<span class="lrow-goal ${goal.done ? 'done' : ''}" title="Goal: ${escapeHtml(goal.text || 'Untitled goal')}">◆ ${escapeHtml((goal.text || 'Untitled goal').split('\n')[0])}</span>`
      : '';

    const acts = note.activity?.length || 0;
    const imgs = note.images?.length || 0;
    const counts = [
      imgs ? `<span class="lrow-count" title="${imgs} image${imgs === 1 ? '' : 's'}"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>${imgs}</span>` : '',
      acts ? `<span class="lrow-count" title="${acts} activit${acts === 1 ? 'y' : 'ies'}"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>${acts}</span>` : '',
    ].join('');

    const snooze = note.snoozeUntil
      ? `<span class="lrow-snooze ${note.snoozeUntil <= Date.now() ? 'due' : ''}" title="${note.snoozeAction ? note.snoozeAction : 'Snoozed'} on ${new Date(note.snoozeUntil).toLocaleDateString()}">${note.snoozeAction ? ACTIVITY_ICONS[note.snoozeAction] : ''}${formatDate(note.snoozeUntil)}</span>`
      : '';

    return `
      <div class="lrow" data-id="${note.id}" role="button" tabindex="0">
        <div class="lrow-avatar">${avatar}</div>
        <div class="lrow-main">
          <div class="lrow-primary">${escapeHtml(primary)}</div>
          ${secondary ? `<div class="lrow-secondary">${escapeHtml(secondary)}</div>` : ''}
        </div>
        <div class="lrow-contacts">${contacts}</div>
        <div class="lrow-tags">${goalHtml}${snooze}</div>
        <div class="lrow-counts">${counts}</div>
        <div class="lrow-date">${formatDate(note.updatedAt || note.createdAt)}</div>
      </div>`;
  }

  function renderList() {
    const root = document.getElementById('list-inner');
    if (!root) return;

    const titles = state.boardTitles || DEFAULT_TITLES;
    const goals = getGoals();

    // Counts across every board drive the filter chips, so they stay put
    const tasks = state.notes.filter(n => !n.isLead);
    const totals = [0, 0, 0, 0, 0, 0];
    tasks.forEach(n => { totals[n.quadrant ?? 0]++; });
    if (listFilter !== null && !totals[listFilter]) listFilter = null;

    const shown = listFilter === null ? tasks : tasks.filter(n => (n.quadrant ?? 0) === listFilter);

    // every pending play step, not just today's
    const pending = state.notes
      .filter(n => n.isLead && n.playId && n.playDueAt && currentStep(n))
      .sort((a, b) => (a.playDueAt || 0) - (b.playDueAt || 0));

    const chips = `
      <div class="list-filter">
        <button class="lf-chip lf-all ${listFilter === null ? 'active' : ''}" data-f="all">All</button>
        ${totals.map((c, q) => `<button class="lf-chip ${listFilter === q ? 'active' : ''} ${c ? '' : 'empty'}"
            data-f="${q}" style="--c:${BOARD_COLORS[q]}"
            title="${escapeHtml(titles[q] || DEFAULT_TITLES[q])} · ${c} stiki${c === 1 ? '' : 's'}"
            aria-label="${escapeHtml(titles[q] || DEFAULT_TITLES[q])}"></button>`).join('')}
      </div>`;

    const bar = `
      <div class="list-bar">
        <div class="list-summary">${shown.length} task${shown.length === 1 ? '' : 's'}${pending.length ? ` · ${pending.length} play step${pending.length === 1 ? '' : 's'}` : ''}</div>
        ${chips}
      </div>`;

    const wire = () => {
      root.querySelectorAll('.lf-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const f = (chip as HTMLElement).dataset.f;
          setListFilter(f === 'all' ? null : parseInt(f!, 10));
        });
      });
    };

    const playsHtml = pending.length ? `
      <section class="list-section">
        <header class="list-head"><span class="list-swatch" style="background:#12100e"></span><h3>Plays</h3><span class="list-n">${pending.length}</span></header>
        <div class="list-rows">${pending.map(l => {
          const st = currentStep(l)!;
          const due = playDueToday(l);
          return `<div class="lrow" data-id="${l.id}" role="button" tabindex="0">
            <div class="lrow-avatar"><span class="lrow-face lrow-initials">${stepIcon(st.type)}</span></div>
            <div class="lrow-main">
              <div class="lrow-primary">${escapeHtml(stepLabel(st.type))}</div>
              <div class="lrow-secondary">${escapeHtml(l.name || noteHeadline(l))}${l.company ? ` · ${escapeHtml(l.company)}` : ''}</div>
            </div>
            <div class="lrow-tags"></div><div class="lrow-counts"></div>
            <div class="lrow-date ${due ? 'due' : ''}">${formatDate(l.playDueAt!)}</div>
          </div>`;
        }).join('')}</div>
      </section>` : '';

    if (!tasks.length && !pending.length) {
      root.innerHTML = `<div class="list-empty">Nothing here yet.</div>`;
      return;
    }
    if (!shown.length) {
      root.innerHTML = bar + playsHtml + `<div class="list-empty">No tasks on this board.</div>`;
      wire();
      return;
    }

    const byBoard = new Map<number, Note[]>();
    shown.forEach(n => {
      const q = n.quadrant ?? 0;
      if (!byBoard.has(q)) byBoard.set(q, []);
      byBoard.get(q)!.push(n);
    });

    root.innerHTML = bar + playsHtml + [...byBoard.entries()].sort((a, b) => a[0] - b[0]).map(([q, notes]) => {
        notes.sort((a, b) => (b.updatedAt || b.createdAt) - (a.updatedAt || a.createdAt));
        return `
          <section class="list-section">
            <header class="list-head" data-board="${q}" title="Open this board">
              <span class="list-swatch" style="background:${BOARD_COLORS[q]}"></span>
              <h3>${escapeHtml(titles[q] || DEFAULT_TITLES[q])}</h3>
              <span class="list-n">${notes.length}</span>
            </header>
            <div class="list-rows">${notes.map(n => listRowHtml(n, goals)).join('')}</div>
          </section>`;
      }).join('');

    wire();

    root.querySelectorAll('.lrow').forEach(row => {
      const open = (e: Event) => {
        if ((e.target as HTMLElement).closest('[data-stop]')) return;  // contact links do their own thing
        openDetailModal((row as HTMLElement).dataset.id!);
      };
      row.addEventListener('click', open);
      row.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') { e.preventDefault(); open(e); }
      });
    });

    viewDirty.list = false;

    root.querySelectorAll('.list-head').forEach(head => {
      head.addEventListener('click', () => {
        setViewMode('tasks');
        switchQuadrant(parseInt((head as HTMLElement).dataset.board || '0', 10));
      });
    });
  }

  function populateGoalSelect(note: Note | undefined) {
    const sel = document.getElementById('detail-goal') as HTMLSelectElement;
    if (!sel) return;
    const goals = getGoals();
    sel.innerHTML = `<option value="">No goal</option>` +
      goals.map(g => {
        const label = (g.text || 'Untitled goal').split('\n')[0].slice(0, 40);
        return `<option value="${g.id}">${g.done ? '✓ ' : ''}${escapeHtml(label)}</option>`;
      }).join('');
    sel.value = note?.goalId || '';
    sel.style.display = goals.length ? '' : 'none';
  }

  // Mode toggle wiring
  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const m = (btn as HTMLElement).dataset.mode;
      if (!m) return;   // the Leads segment is a link out to /pda
      setViewMode(m as ViewMode);
    });
  });

  function switchQuadrant(q: number) {
    activeQuadrant = q;
    document.querySelectorAll('.board').forEach(b => {
      b.classList.toggle('active', parseInt((b as HTMLElement).dataset.q || '0') === q);
    });
    updateMinimap();
    render();
  }

  // Update FAB color
  function updateFabColor() {
    const dot = document.getElementById('fab-color-dot');
    const btn = document.getElementById('fab-add-btn');
    if (dot) dot.style.background = currentColor;
    if (btn) btn.style.background = currentColor;
  }

  // Mouse events
  const DRAG_THRESHOLD = 5;
  document.addEventListener('mousemove', e => {
    if (dragTarget && !isDragging) {
      const dx = Math.abs(e.clientX - dragStartX);
      const dy = Math.abs(e.clientY - dragStartY);
      if (dx > DRAG_THRESHOLD || dy > DRAG_THRESHOLD) {
        isDragging = true;
        dragTarget.classList.add('dragging');
      }
    }

    if (!isDragging || !selectedId) return;

    const note = state.notes.find(n => n.id === selectedId);
    if (!note) return;

    const board = document.getElementById(`board-${note.quadrant ?? 0}`)!;
    const rect = board.getBoundingClientRect();
    const x = e.clientX - rect.left - dragOffset.x + board.scrollLeft;
    const y = e.clientY - rect.top - dragOffset.y + board.scrollTop;

    note.x = Math.max(0, x);
    note.y = Math.max(0, y);

    const el = document.querySelector(`[data-id="${selectedId}"]`) as HTMLElement;
    if (el) {
      el.style.left = `${note.x}px`;
      el.style.top = `${note.y}px`;
    }
  });

  document.addEventListener('mouseup', () => {
    if (dragTarget) {
      dragTarget.classList.remove('dragging');
      if (isDragging && selectedId) {
        // Check for overlapping notes and adopt color
        const note = state.notes.find(n => n.id === selectedId);
        if (note) {
          const overlapping = state.notes
            .filter(n => n.id !== selectedId && (n.quadrant ?? 0) === (note.quadrant ?? 0))
            .filter(n => {
              const l1 = note.x, r1 = note.x + 180, t1 = note.y, b1 = note.y + 140;
              const l2 = n.x, r2 = n.x + 180, t2 = n.y, b2 = n.y + 140;
              return l1 < r2 && r1 > l2 && t1 < b2 && b1 > t2;
            })
            .sort((a, b) => b.zIndex - a.zIndex);

          if (overlapping.length > 0 && overlapping[0].color !== note.color) {
            note.color = overlapping[0].color;
          }
        }
        save();
        render();
        updateMinimap();
      }
    }
    dragTarget = null;
    isDragging = false;
  });

  // Click handlers
  document.addEventListener('click', e => {
    const target = e.target as HTMLElement;
    if (!target.closest('.color-picker') && !target.closest('.color-toggle')) {
      hideColorPicker();
    }
  });

  // Board click/double-click
  document.querySelectorAll('.board').forEach(board => {
    board.addEventListener('click', e => {
      // Deselect props when clicking on empty board space
      if (!(e.target as HTMLElement).closest('.device-prop') &&
          !(e.target as HTMLElement).closest('.sticky-note') &&
          !(e.target as HTMLElement).closest('.board-label')) {
        if (selectedPropId) {
          selectedPropId = null;
          renderProps();
        }
      }
    });
    board.addEventListener('dblclick', e => {
      if ((e.target as HTMLElement).closest('.sticky-note')) return;
      if ((e.target as HTMLElement).closest('.device-prop')) return;
      const rect = board.getBoundingClientRect();
      const x = (e as MouseEvent).clientX - rect.left + board.scrollLeft - 90;
      const y = (e as MouseEvent).clientY - rect.top + board.scrollTop - 70;
      const note = createNote(Math.max(0, x), Math.max(0, y), currentColor);
      render();
      setTimeout(() => {
        (document.querySelector(`[data-id="${note.id}"] .sticky-note-content`) as HTMLElement)?.focus();
      }, 50);
    });
  });

  // FAB
  document.getElementById('fab-add-btn')?.addEventListener('click', () => {
    const board = document.getElementById(`board-${activeQuadrant}`)!;
    const x = board.scrollLeft + 100 + Math.random() * 200;
    const y = board.scrollTop + 100 + Math.random() * 200;
    const note = createNote(x, y, currentColor);
    render();
    setTimeout(() => {
      (document.querySelector(`[data-id="${note.id}"] .sticky-note-content`) as HTMLElement)?.focus();
    }, 50);
  });

  document.getElementById('fab-color-btn')?.addEventListener('click', () => {
    document.getElementById('fab-colors')!.classList.toggle('hidden');
  });

  document.querySelectorAll('.fab-color-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      const color = (btn as HTMLElement).dataset.color;
      if (color) {
        currentColor = color;
        updateFabColor();
        document.getElementById('fab-colors')?.classList.add('hidden');
      }
    });
