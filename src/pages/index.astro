  // Keyboard shortcuts
  document.addEventListener('keydown', e => {
    /* Never let a shortcut fire while the user is typing. This used to
       whitelist specific classes, so a newly added editable field (the goal
       "Completed when" box) fell through and every "n" created a new goal.
       isContentEditable covers every one of them, now and later. */
    const active = document.activeElement as HTMLElement | null;
    if (active?.isContentEditable ||
        active?.tagName === 'INPUT' ||
        active?.tagName === 'TEXTAREA' ||
        active?.closest('[contenteditable="true"]')) return;

    // Tab toggles Tasks / Goals
    if (e.key === 'Tab' && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      setViewMode(VIEW_MODES[(VIEW_MODES.indexOf(viewMode) + 1) % VIEW_MODES.length]);
      return;
    }
    if (viewMode === 'goals') {
      if (e.key === 'n' || e.key === 'N') { e.preventDefault(); addGoal(); }
      return;
    }
    if (viewMode === 'list') return;
    if (viewMode === 'scripts') {
      if (e.key === 'n' || e.key === 'N') { e.preventDefault(); addScript(); }
      return;
    }
    if (viewMode === 'opps') {
      if (e.key === 'n' || e.key === 'N') { e.preventDefault(); openDealModal(); }
      return;
    }

    if ((e.key === 't' || e.key === 'T') && selectedId) {
      e.preventDefault();
      toggleToday(selectedId);
      return;
    }

    if (e.key === 'n' || e.key === 'N') {
      document.getElementById('fab-add-btn')?.click();
    }
    // P - toggle props palette
    if (e.key === 'p' || e.key === 'P') {
      togglePropsPalette();
    }
    if (e.key === 'Escape') {
      selectedId = null;
      document.querySelectorAll('.sticky-note.selected').forEach(n => n.classList.remove('selected'));
      hideColorPicker();
      // Exit multi-select mode
      if (multiSelectMode) {
        multiSelectMode = false;
        multiSelected.clear();
        document.body.classList.remove('multi-select-mode');
        document.getElementById('multi-select-indicator')?.classList.remove('visible');
        document.querySelectorAll('.sticky-note.multi-selected').forEach(n => n.classList.remove('multi-selected'));
      }
      // Deselect props and exit arrow mode
      if (selectedPropId) {
        selectedPropId = null;
        renderProps();
      }
      if (arrowMode) {
        exitArrowMode();
      }
      // Close props palette
      if (propsPaletteOpen) {
        propsPaletteOpen = false;
        document.getElementById('props-palette')?.classList.add('hidden');
      }
    }
    // Toggle multi-select mode with S
    if (e.key === 's' || e.key === 'S') {
      multiSelectMode = !multiSelectMode;
      if (multiSelectMode) {
        document.body.classList.add('multi-select-mode');
        document.getElementById('multi-select-indicator')?.classList.add('visible');
      } else {
        document.body.classList.remove('multi-select-mode');
        document.getElementById('multi-select-indicator')?.classList.remove('visible');
        multiSelected.clear();
        document.querySelectorAll('.sticky-note.multi-selected').forEach(n => n.classList.remove('multi-selected'));
      }
    }
    // Number keys 1-6 to move selected cards to that board
    if (multiSelectMode && multiSelected.size > 0 && /^[1-6]$/.test(e.key)) {
      const targetBoard = parseInt(e.key) - 1;
      multiSelected.forEach(noteId => {
        const note = state.notes.find(n => n.id === noteId);
        if (note) {
          note.quadrant = targetBoard;
          // Reset position for the new board
          note.x = 100 + Math.random() * 200;
          note.y = 100 + Math.random() * 200;
        }
      });
      save();
      syncToCloud();
      render();
      // Exit multi-select mode after move
      multiSelectMode = false;
      multiSelected.clear();
      document.body.classList.remove('multi-select-mode');
      document.getElementById('multi-select-indicator')?.classList.remove('visible');
      switchQuadrant(targetBoard);
    }
    if (e.key === 'Delete' || e.key === 'Backspace') {
      if (selectedPropId) {
        deleteProp(selectedPropId);
      } else if (selectedId) {
        deleteNote(selectedId);
      }
    }
    if (e.key === 'u' || e.key === 'U') {
      undoDelete();
    }
    // D - duplicate selected note
    if ((e.key === 'd' || e.key === 'D') && selectedId) {
      const original = state.notes.find(n => n.id === selectedId);
      if (original) {
        const duplicate: Note = {
          ...original,
          id: `note-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
          x: original.x + 30,
          y: original.y + 30,
          createdAt: Date.now(),
          updatedAt: Date.now(),
          zIndex: state.nextZIndex++,
        };
        state.notes.push(duplicate);
        selectedId = duplicate.id;
        save();
        render();
      }
    }
    if (e.key === 'x' || e.key === 'X') {
      const board = document.getElementById(`board-${activeQuadrant}`)!;
      const x = board.scrollLeft + 100 + Math.random() * 200;
      const y = board.scrollTop + 100 + Math.random() * 200;
      const note = createNote(x, y, currentColor, true);
      render();
      setTimeout(() => {
        (document.querySelector(`[data-id="${note.id}"] .sticky-note-content`) as HTMLElement)?.focus();
      }, 50);
    }
    // T - add text label to board
    if (e.key === 't' || e.key === 'T') {
      const board = document.getElementById(`board-${activeQuadrant}`)!;
      const x = board.scrollLeft + 150;
      const y = board.scrollTop + 100;
      createBoardLabel(x, y, activeQuadrant);
    }
    // Board shortcuts: O Y G B I V
    if (e.key === 'o' || e.key === 'O') switchQuadrant(0);
    if (e.key === 'y' || e.key === 'Y') switchQuadrant(1);
    if (e.key === 'g' || e.key === 'G') switchQuadrant(2);
    if (e.key === 'b' || e.key === 'B') switchQuadrant(3);
    if (e.key === 'i' || e.key === 'I') switchQuadrant(4);
    if (e.key === 'v' || e.key === 'V') switchQuadrant(5);
    // M toggles just the minimap
    if (e.key === 'm' || e.key === 'M') {
      const minimap = document.getElementById('minimap')!;
      minimap.classList.toggle('ui-hidden');
    }
    // Spacebar toggles all UI elements (minimap, hints, FAB)
    if (e.key === ' ') {
      e.preventDefault();
      const minimap = document.getElementById('minimap')!;
      const hints = document.getElementById('hints')!;
      const fab = document.getElementById('new-note-fab')!;
      const anyVisible = !minimap.classList.contains('ui-hidden') ||
                         !hints.classList.contains('ui-hidden') ||
                         !fab.classList.contains('ui-hidden');
      if (anyVisible) {
        minimap.classList.add('ui-hidden');
        hints.classList.add('ui-hidden');
        fab.classList.add('ui-hidden');
      } else {
        minimap.classList.remove('ui-hidden');
        hints.classList.remove('ui-hidden');
        fab.classList.remove('ui-hidden');
      }
    }
  });

  // Quadrant buttons
  document.querySelectorAll('.quadrant-btn').forEach(btn => {
