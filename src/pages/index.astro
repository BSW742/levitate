---
// Stiki - Sticky notes board with 4 quadrants
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Stiki</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📝</text></svg>">
  <meta name="theme-color" content="#f5f5f4">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Stiki">
</head>
<body>
  <!-- Password Gate -->
  <div id="login-gate">
    <div class="login-box">
      <h1 class="login-title">Stiki</h1>
      <input type="password" id="password-input" placeholder="Enter password" autocomplete="off">
      <button id="login-btn">Enter</button>
      <p id="login-error">Incorrect password</p>
    </div>
  </div>

  <!-- Main App -->
  <div id="app">
    <div id="multi-select-indicator" class="multi-select-indicator">SELECT MODE: Click cards, press 1-6 to move, ESC to cancel</div>
    <div id="whiteboard">
      <!-- Top-right toolbar -->
      <div id="toolbar">
        <div id="project-badge" title="Current project">No project</div>
        <div id="sync-indicator" title="Cloud sync">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>
        </div>
        <button id="settings-btn" title="Settings">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </button>
      </div>

      <!-- FAB -->
      <div id="new-note-fab">
        <button id="fab-color-btn" title="Change color">
          <span id="fab-color-dot"></span>
        </button>
        <button id="fab-add-btn" title="New sticky (N)">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
        <div id="fab-colors" class="hidden">
          <button class="fab-color-opt" data-color="#fef08a" style="background: #fef08a"></button>
          <button class="fab-color-opt" data-color="#fecaca" style="background: #fecaca"></button>
          <button class="fab-color-opt" data-color="#bfdbfe" style="background: #bfdbfe"></button>
          <button class="fab-color-opt" data-color="#bbf7d0" style="background: #bbf7d0"></button>
          <button class="fab-color-opt" data-color="#e9d5ff" style="background: #e9d5ff"></button>
          <button class="fab-color-opt" data-color="#fed7aa" style="background: #fed7aa"></button>
          <button class="fab-color-opt" data-color="#ffffff" style="background: #ffffff; border: 1px solid #d1d5db"></button>
        </div>
      </div>

      <!-- 6 Color boards (2 rows x 3 cols) -->
      <div id="board-0" class="board active" data-q="0"></div>
      <div id="board-1" class="board" data-q="1"></div>
      <div id="board-2" class="board" data-q="2"></div>
      <div id="board-3" class="board" data-q="3"></div>
      <div id="board-4" class="board" data-q="4"></div>
      <div id="board-5" class="board" data-q="5"></div>

      <!-- Minimap -->
      <div id="minimap">
        <button class="quadrant-btn" data-q="0" title="Orange (O)"></button>
        <button class="quadrant-btn" data-q="1" title="Yellow (Y)"></button>
        <button class="quadrant-btn" data-q="2" title="Green (G)"></button>
        <button class="quadrant-btn" data-q="3" title="Blue (B)"></button>
        <button class="quadrant-btn" data-q="4" title="Indigo (I)"></button>
        <button class="quadrant-btn" data-q="5" title="Violet (V)"></button>
      </div>

      <!-- Props Palette -->
      <div id="props-palette" class="props-palette hidden">
        <div class="palette-header">Props <button class="palette-close">&times;</button></div>
        <div class="palette-items">
          <button data-type="mobile" title="Mobile Phone">📱</button>
          <button data-type="pc" title="PC Monitor">🖥️</button>
          <button data-type="tv" title="TV Screen">📺</button>
        </div>
        <button id="arrow-mode-btn" class="arrow-mode-btn">🔗 Draw Arrow</button>
      </div>

      <!-- Keyboard hints -->
      <div id="hints">
        <span><kbd>O</kbd><kbd>Y</kbd><kbd>G</kbd><kbd>B</kbd><kbd>I</kbd><kbd>V</kbd> boards</span>
        <span><kbd>N</kbd> new</span>
        <span><kbd>X</kbd> lead</span>
        <span><kbd>P</kbd> props</span>
      </div>
    </div>

    <!-- Settings Modal -->
    <div id="settings-modal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Settings</h2>
          <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
          <div class="setting-group">
            <label>Current Project</label>
            <div class="current-project">
              <span id="current-project-name">No project</span>
            </div>
          </div>
          <div class="setting-divider"></div>
          <div class="setting-group">
            <label>Switch Project</label>
            <p class="setting-hint">Enter a project name or select from recent projects</p>
            <input type="text" id="switch-project-input" placeholder="e.g. litebooks-sales">
            <div class="setting-actions">
              <button id="switch-project-btn">Switch Project</button>
            </div>
            <div id="saved-projects-list" class="saved-projects-list"></div>
          </div>
          <div class="setting-divider"></div>
          <div class="setting-group">
            <label>Data</label>
            <div class="setting-actions">
              <button id="export-data">Export</button>
              <button id="import-data" class="secondary">Import</button>
              <button id="clear-all-data" class="danger">Clear All</button>
            </div>
          </div>
          <div class="setting-divider"></div>
          <div class="setting-group">
            <label>Email Templates</label>
            <p class="setting-hint">Create up to 3 email templates for quick outreach</p>
            <div id="email-templates-list" class="email-templates-list"></div>
            <button id="add-email-template" class="add-template-btn">+ Add Template</button>
          </div>
          <div class="setting-divider"></div>
          <div class="setting-group">
            <label>Admin</label>
            <div class="setting-actions">
              <button id="open-admin-btn">Open Admin Panel</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Email Template Editor Modal -->
    <div id="template-modal" class="modal">
      <div class="modal-content template-modal-content">
        <div class="modal-header">
          <h2 id="template-modal-title">New Email Template</h2>
          <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
          <div class="field-group">
            <label>Template Name</label>
            <input type="text" id="template-name" placeholder="e.g. Introduction">
          </div>
          <div class="field-group">
            <label>Subject Line</label>
            <input type="text" id="template-subject" placeholder="e.g. Quick introduction from [company]">
          </div>
          <div class="field-group">
            <label>Email Body</label>
            <textarea id="template-body" rows="8" placeholder="Hi [name],

I noticed your work at [company] and wanted to reach out...

Best regards"></textarea>
          </div>
          <p class="setting-hint">Use [name], [company], [role] as placeholders</p>
          <div class="template-actions">
            <button id="delete-template" class="danger">Delete</button>
            <div class="template-actions-right">
              <button id="cancel-template" class="secondary">Cancel</button>
              <button id="save-template" class="primary">Save</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Template Picker (when sending email to lead) -->
    <div id="template-picker" class="template-picker">
      <div class="template-picker-content">
        <h3>Choose Template</h3>
        <div id="template-picker-list" class="template-picker-list"></div>
        <button id="template-picker-cancel" class="template-picker-cancel">Cancel</button>
      </div>
    </div>

    <!-- Admin Modal -->
    <div id="admin-modal" class="modal">
      <div class="modal-content admin-modal-content">
        <div class="modal-header">
          <h2>Admin Panel</h2>
          <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body">
          <div id="admin-login-view">
            <p class="admin-prompt">Enter admin password to continue</p>
            <div class="admin-login-form">
              <input type="password" id="admin-password" placeholder="Password" autocomplete="off">
              <button id="admin-unlock">Unlock</button>
            </div>
          </div>
          <div id="admin-projects-view" class="hidden">
            <div class="admin-summary">
              <span id="admin-project-count">0 projects</span>
            </div>
            <div id="admin-projects-list" class="admin-projects-list"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Detail Modal -->
    <div id="detail-modal" class="modal">
      <div class="modal-content detail-content">
        <div class="modal-header detail-header">
          <button id="detail-delete" class="header-btn danger" title="Delete">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
          </button>
          <div class="header-spacer"></div>
          <div class="header-actions">
            <div class="header-snooze">
              <button id="snooze-trigger" class="snooze-trigger" title="Snooze with action">
                <span class="snooze-icon">⏰</span>
                <span id="snooze-display" class="snooze-display">Snooze</span>
              </button>
              <div id="snooze-popover" class="snooze-popover">
                <div class="snooze-popover-header">
                  <span>Snooze until</span>
                  <button id="snooze-clear" class="snooze-clear-btn">&times;</button>
                </div>
                <input type="date" id="detail-snooze" class="snooze-date-input">
                <div class="snooze-actions-label">Next action:</div>
                <div class="snooze-action-icons">
                  <button class="snooze-action-btn" data-action="call" title="Call">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                  </button>
                  <button class="snooze-action-btn" data-action="email" title="Email">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
                  </button>
                  <button class="snooze-action-btn" data-action="meeting" title="Meeting">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                  </button>
                  <button class="snooze-action-btn" data-action="linkedin" title="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </button>
                  <button class="snooze-action-btn" data-action="web" title="Research">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                  </button>
                </div>
              </div>
            </div>
            <div class="header-board-picker" id="detail-board-picker">
              <button class="board-opt" data-q="0" style="background: #fed7aa" title="Orange"></button>
              <button class="board-opt" data-q="1" style="background: #fef08a" title="Yellow"></button>
              <button class="board-opt" data-q="2" style="background: #bbf7d0" title="Green"></button>
              <button class="board-opt" data-q="3" style="background: #93c5fd" title="Blue"></button>
              <button class="board-opt" data-q="4" style="background: #c7d2fe" title="Indigo"></button>
              <button class="board-opt" data-q="5" style="background: #ddd6fe" title="Violet"></button>
            </div>
            <button id="detail-save" class="header-btn primary" title="Save">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
            </button>
            <button class="modal-close">&times;</button>
          </div>
        </div>
        <div class="modal-body">
          <!-- Note View (for regular stikis) -->
          <div class="detail-note-view" id="detail-note-view">
            <div class="note-main-area">
              <textarea id="detail-note-content" class="note-textarea" placeholder="Write your note..."></textarea>
            </div>
            <div class="note-sidebar">
              <!-- Attachments Panel -->
              <div class="sidebar-panel" id="attachments-panel">
                <button class="panel-toggle" id="attachments-toggle">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  <span>Attachments</span>
                  <span class="panel-count" id="attachments-count"></span>
                </button>
                <div class="panel-content" id="attachments-content">
                  <div id="note-images" class="note-images-grid"></div>
                  <button id="add-note-image" class="add-attachment-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Add image
                  </button>
                  <input type="file" id="note-image-upload" accept="image/*" style="display: none" multiple>
                </div>
              </div>
              <!-- Activity Panel -->
              <div class="sidebar-panel expanded" id="activity-panel">
                <button class="panel-toggle" id="activity-toggle">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
                  <span>Activity</span>
                  <span class="panel-count" id="activity-count"></span>
                </button>
                <div class="panel-content">
                  <div id="note-activity-list" class="activity-thread"></div>
                  <div class="activity-actions">
                    <button class="note-activity-btn" data-type="note" title="Add note">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    </button>
                    <button class="note-activity-btn" data-type="link" title="Add link">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                    </button>
                    <button class="note-activity-btn" data-type="reminder" title="Add reminder">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
                    </button>
                  </div>
                  <div id="note-activity-input" class="activity-input-row hidden">
                    <input type="text" id="note-activity-text" placeholder="Add note..." class="activity-text-input">
                    <button id="note-activity-add" class="activity-add-btn">Add</button>
                    <button id="note-activity-cancel" class="activity-cancel-btn">✕</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Lead View (for lead cards) -->
          <div class="detail-lead-view" id="detail-lead-view">
          <div class="detail-two-col">
            <!-- Left Column: Profile Card -->
            <div class="detail-left-col">
              <!-- Profile Card - Centered -->
              <div class="profile-card-centered">
                <div class="profile-avatar-wrapper-centered">
                  <div class="profile-avatar-ring"></div>
                  <div class="profile-avatar" id="detail-avatar">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="8" r="4"/><path d="M12 14c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z"/></svg>
                  </div>
                  <button id="detail-avatar-btn" class="avatar-edit-btn" title="Change photo">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
                  </button>

                  <!-- Contact Popover (appears on hover) -->
                  <div class="contact-popover" id="contact-popover">
                    <div class="popover-arrow"></div>
                    <div class="popover-content">
                      <div class="popover-row">
                        <button class="popover-action-icon phone" id="action-phone" title="Call">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
                        </button>
                        <input type="tel" id="detail-phone" placeholder="Phone" class="popover-input">
                      </div>
                      <div class="popover-row">
                        <button class="popover-action-icon email" id="action-email" title="Send email">
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        </button>
                        <input type="email" id="detail-email" placeholder="Email" class="popover-input">
                      </div>
                      <div class="popover-row">
                        <button class="popover-action-icon linkedin" id="action-linkedin" title="Open LinkedIn">
