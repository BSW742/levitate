<script>
  const PASSWORD = 'Ben123';
  const AUTH_KEY = 'stiki-auth';
  /* Local state is keyed BY PROJECT. It used to be one shared key, which meant
     the notes left in localStorage by the last project you had open were the
     notes init() merged into the next one - so opening a new project could
     silently fill it with the previous project's data and push that up as its
     own. Nothing here migrates the old shared key forward: doing so would copy
     whichever project happened to be last into every project. The cloud is the
     source of truth, and syncFromCloud fills a project the first time you open
     it on a device. The old key is left untouched on disk. */
  const SYNC_PASSWORD_KEY = 'stiki-sync-password';
  const STORAGE_KEY_BASE = 'stiki-notes-v2';
  function storageKey(): string {
    const project = localStorage.getItem(SYNC_PASSWORD_KEY);
    return project ? `${STORAGE_KEY_BASE}::${project}` : STORAGE_KEY_BASE;
  }
  const SAVED_PROJECTS_KEY = 'stiki-saved-projects';
  const WORKER_URL = 'https://levitate-sync.ben-6a6.workers.dev';

  function getSavedProjects(): string[] {
    try {
      const saved = localStorage.getItem(SAVED_PROJECTS_KEY);
      return saved ? JSON.parse(saved) : [];
    } catch { return []; }
  }

  function saveProjectToList(projectName: string) {
    const projects = getSavedProjects().filter(p => p !== projectName);
    projects.unshift(projectName); // Add to front
    if (projects.length > 10) projects.pop(); // Keep max 10
    localStorage.setItem(SAVED_PROJECTS_KEY, JSON.stringify(projects));
  }

  function removeProjectFromList(projectName: string) {
    const projects = getSavedProjects().filter(p => p !== projectName);
    localStorage.setItem(SAVED_PROJECTS_KEY, JSON.stringify(projects));
  }

  function renderSavedProjects() {
    const container = document.getElementById('saved-projects-list');
    if (!container) return;

    const projects = getSavedProjects();
    const currentProject = getSyncPassword();

    if (projects.length === 0) {
      container.innerHTML = '';
      return;
    }

    container.innerHTML = projects.map(p => `
      <div class="saved-project-chip ${p === currentProject ? 'active' : ''}" data-project="${p}">
        <span class="project-name">${p}</span>
        <button class="remove-project" data-project="${p}" title="Remove">&times;</button>
      </div>
    `).join('');

    // Click on chip to switch
    container.querySelectorAll('.saved-project-chip').forEach(chip => {
      chip.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).classList.contains('remove-project')) return;
        const project = (chip as HTMLElement).dataset.project;
        if (project) {
          (document.getElementById('switch-project-input') as HTMLInputElement).value = project;
          document.getElementById('switch-project-btn')?.click();
        }
      });
    });

    // Remove button
    container.querySelectorAll('.remove-project').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const project = (btn as HTMLElement).dataset.project;
        if (project && confirm(`Remove "${project}" from the list?`)) {
          removeProjectFromList(project);
          renderSavedProjects();
        }
      });
    });
  }

  interface Activity {
    id: string;
    timestamp: number;
    type: 'call' | 'email' | 'meeting' | 'note' | 'linkedin' | 'web';
    text: string;
  }

  interface Note {
    id: string;
    text: string;
    color: string;
    x: number;
    y: number;
    rotation: number;
    createdAt: number;
    updatedAt: number;
    zIndex: number;
    isLead: boolean;
    quadrant: number;
    avatar?: string;
    // Lead details
    name?: string;
    role?: string;
    company?: string;
    phone?: string;
    email?: string;
    linkedin?: string;
    website?: string;
    notes?: string;
    activity?: Activity[];
    snoozeUntil?: number;
    snoozeAction?: 'call' | 'email' | 'meeting' | 'linkedin' | 'web';
    images?: string[]; // Base64 encoded images for notes
    goalId?: string; // Optional link to a Goal
    todayOn?: number; // flagged for today; only counts on the day it was set
    // On a LEAD: the play it is running, and which step is open
    playId?: string;
    playStep?: number;
    playDueAt?: number;
    lastPostAt?: number;    // when they last posted on LinkedIn, read from a screenshot
    lastPostNote?: string;  // when the open step is due. Separate from snoozeUntil:
                         // snooze is you saying "later", this is the play scheduling
  }

  type StepType = 'email' | 'email_fup' | 'call' | 'f2f' | 'li_connect' | 'li_comment' | 'li_like' | 'text';

  interface PlayStep {
    type: StepType;
    offsetDays: number;   // days after the PREVIOUS step is done (first step: after applying)
    template?: string;    // email template name, email steps only
    note?: string;
  }

  interface Play {
    id: string;
    name: string;
    steps: PlayStep[];
  }

  /* A quote is a hosted document behind credentials. The hard part is not the
     number, it is getting back into it - so a deal is really a key. */
  interface Deal {
    id: string;
    title: string;         // the client, or the work
    personId?: string;     // who it is for
    goalId?: string;       // which outcome it feeds
    capex?: number;      // one-off: build, setup, implementation
    ongoing?: number;    // per month: the part that feeds a recurring goal
    value?: number;      // legacy single figure, read as capex
    url?: string;
    username?: string;
    password?: string;
    sentAt?: number;
    wonAt?: number;
    lostAt?: number;
    notes?: string;    // where it is at, while it is still only a conversation
    createdAt?: number;
  }

  /* What to say, and the moment it is for. Two fields because that is the
     whole job: open the page mid-call, find the moment, read the words. */
  interface Script {
    id: string;
    when: string;      // "Cold call, first ten seconds"
    body: string;
    createdAt: number;
    updatedAt?: number;
  }

  interface EmailTemplate {
    name: string;
    subject: string;
    body: string;
  }

  interface BoardLabel {
    id: string;
    text: string;
    x: number;
    y: number;
    quadrant: number;
  }

  interface Prop {
    id: string;
    type: 'mobile' | 'tv' | 'pc';
    x: number;
    y: number;
    width: number;
    height: number;
    label: string;
    quadrant: number;
    zIndex: number;
    createdAt: number;
    image?: string; // Base64 encoded image for screen
  }

  interface Arrow {
    id: string;
    fromPropId: string;
    toPropId: string;
    fromAnchor: 'top' | 'right' | 'bottom' | 'left';
    toAnchor: 'top' | 'right' | 'bottom' | 'left';
    label?: string;
    quadrant: number;
  }

  interface Goal {
    id: string;
    text: string;
    doneWhen?: string;   // concrete definition of done
    done: boolean;
    createdAt: number;
    completedAt?: number;
  }


  /* One typed figure, addressed by month and line. A cell rather than a
     row of six, so two devices editing different months of the same line
     merge instead of one overwriting the other. The id is derived from
     that address, so the same cell edited in two places converges on one
     row rather than forking into two. */
  /* One piece of the work behind a figure - a project, a retainer, a job
     you can already see. Revenue and Passive are assembled out of these
     rather than keyed, so the forecast says what it is made of. */
  interface SalesItem {
    id: string;
    label: string;
    value: number;
  }

  interface SalesCell {
    id: string;
    month: string;          // '2026-04'
    line: string;           // one of SALES_LINES[].key
    value: number;
    /* Only on the assembled lines, and always summing to value. Absent
       means a figure that was simply typed - older cells, and the three
       lines that are still keyed. */
    items?: SalesItem[];
    createdAt: number;
    updatedAt?: number;
  }

  /* The one number the Funnel view is measured against. Carries its own
     timestamp because it is a scalar, not an id-keyed row: mergeFromCloud
     only adopts unknown keys, so without a stamp to compare, a target
     retyped on the laptop could never reach the phone. */
  interface PassiveTarget {
    value: number;
    updatedAt: number;
  }

  interface State {
    notes: Note[];
    goals?: Goal[];
    passiveTarget?: PassiveTarget;
    props?: Prop[];
    arrows?: Arrow[];
    nextZIndex: number;
    boardTitles?: string[];
    emailTemplates?: EmailTemplate[];
    plays?: Play[];
    deals?: Deal[];
    scripts?: Script[];
    sales?: SalesCell[];
    // ids of things deleted here, so a delete survives a merge from another device
    tombs?: { id: string; at: number }[];
    boardLabels?: BoardLabel[];
  }

  const DEFAULT_TITLES = ['Orange', 'Yellow', 'Green', 'Blue', 'Indigo', 'Violet'];
  const BOARD_COLORS = ['#fed7aa', '#fef08a', '#bbf7d0', '#93c5fd', '#c7d2fe', '#ddd6fe'];
  const ACTIVITY_ICONS: Record<string, string> = {
