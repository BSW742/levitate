    // Update text to show name/role/company on card
    let displayText = name;
    if (role) displayText += `\n${role}`;
    if (company) displayText += `\n${company}`;

    // Preserve isLead state - only leads get the lead-specific fields
    const currentNote = state.notes.find(n => n.id === detailNoteId);
    const isLead = currentNote?.isLead || false;

    if (isLead) {
      // Lead mode: update lead-specific fields
      let displayText = name;
      if (role) displayText += `\n${role}`;
      if (company) displayText += `\n${company}`;

      updateNote(detailNoteId, {
        text: displayText,
