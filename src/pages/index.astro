<script>
  const PASSWORD = 'Ben123';
  const AUTH_KEY = 'stiki-auth';
  const STORAGE_KEY = 'stiki-notes-v2';
  const SYNC_PASSWORD_KEY = 'stiki-sync-password';
  const SAVED_PROJECTS_KEY = 'stiki-saved-projects';
  const WORKER_URL = 'https://levitate-sync.ben-6a6.workers.dev';

  function getSavedProjects(): string[] {
    try {
      const saved = localStorage.getItem(SAVED_PROJECTS_KEY);
      return saved ? JSON.parse(saved) : [];
    } catch { return []; }
  }

  function saveProjectToList(projectName: string) {
    const projects = getSavedProjects().filter(p => p !== projectName);
    projects.unshift(projectName); // Add to front
    if (projects.length > 10) projects.pop(); // Keep max 10
    localStorage.setItem(SAVED_PROJECTS_KEY, JSON.stringify(projects));
  }

  function removeProjectFromList(projectName: string) {
    const projects = getSavedProjects().filter(p => p !== projectName);
    localStorage.setItem(SAVED_PROJECTS_KEY, JSON.stringify(projects));
  }

  function renderSavedProjects() {
    const container = document.getElementById('saved-projects-list');
    if (!container) return;

    const projects = getSavedProjects();
    const currentProject = getSyncPassword();

    if (projects.length === 0) {
      container.innerHTML = '';
      return;
    }

    container.innerHTML = projects.map(p => `
      <div class="saved-project-chip ${p === currentProject ? 'active' : ''}" data-project="${p}">
        <span class="project-name">${p}</span>
        <button class="remove-project" data-project="${p}" title="Remove">&times;</button>
      </div>
    `).join('');

    // Click on chip to switch
    container.querySelectorAll('.saved-project-chip').forEach(chip => {
      chip.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).classList.contains('remove-project')) return;
        const project = (chip as HTMLElement).dataset.project;
        if (project) {
          (document.getElementById('switch-project-input') as HTMLInputElement).value = project;
          document.getElementById('switch-project-btn')?.click();
        }
      });
    });

    // Remove button
    container.querySelectorAll('.remove-project').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const project = (btn as HTMLElement).dataset.project;
        if (project && confirm(`Remove "${project}" from the list?`)) {
          removeProjectFromList(project);
          renderSavedProjects();
        }
      });
    });
  }

  interface Activity {
    id: string;
    timestamp: number;
    type: 'call' | 'email' | 'meeting' | 'note' | 'linkedin' | 'web';
    text: string;
  }

  interface Note {
    id: string;
    text: string;
    color: string;
    x: number;
    y: number;
    rotation: number;
    createdAt: number;
    updatedAt: number;
    zIndex: number;
    isLead: boolean;
    quadrant: number;
    avatar?: string;
    // Lead details
    name?: string;
    role?: string;
    company?: string;
    phone?: string;
    email?: string;
    linkedin?: string;
    website?: string;
    notes?: string;
    activity?: Activity[];
    snoozeUntil?: number;
    snoozeAction?: 'call' | 'email' | 'meeting' | 'linkedin' | 'web';
    images?: string[]; // Base64 encoded images for notes
    goalId?: string; // Optional link to a Goal
    todayOn?: number; // flagged for today; only counts on the day it was set
    // On a LEAD: the play it is running, and which step is open
    playId?: string;
    playStep?: number;
    playDueAt?: number;
    lastPostAt?: number;    // when they last posted on LinkedIn, read from a screenshot
    lastPostNote?: string;  // when the open step is due. Separate from snoozeUntil:
                         // snooze is you saying "later", this is the play scheduling
  }

  type StepType = 'email' | 'email_fup' | 'call' | 'f2f' | 'li_connect' | 'li_comment' | 'li_like' | 'text';

  interface PlayStep {
    type: StepType;
    offsetDays: number;   // days after the PREVIOUS step is done (first step: after applying)
    template?: string;    // email template name, email steps only
    note?: string;
  }

  interface Play {
    id: string;
    name: string;
    steps: PlayStep[];
  }

  /* A quote is a hosted document behind credentials. The hard part is not the
     number, it is getting back into it - so a deal is really a key. */
  interface Deal {
    id: string;
    title: string;         // the client, or the work
    personId?: string;     // who it is for
    goalId?: string;       // which outcome it feeds
    capex?: number;      // one-off: build, setup, implementation
    ongoing?: number;    // per month: the part that feeds a recurring goal
    value?: number;      // legacy single figure, read as capex
    url?: string;
    username?: string;
    password?: string;
    sentAt?: number;
    wonAt?: number;
    lostAt?: number;
    notes?: string;
  }

  interface EmailTemplate {
    name: string;
    subject: string;
    body: string;
  }

  interface BoardLabel {
    id: string;
    text: string;
    x: number;
    y: number;
    quadrant: number;
  }

  interface Prop {
    id: string;
    type: 'mobile' | 'tv' | 'pc';
    x: number;
    y: number;
    width: number;
    height: number;
    label: string;
    quadrant: number;
    zIndex: number;
    createdAt: number;
    image?: string; // Base64 encoded image for screen
  }

  interface Arrow {
    id: string;
    fromPropId: string;
    toPropId: string;
    fromAnchor: 'top' | 'right' | 'bottom' | 'left';
    toAnchor: 'top' | 'right' | 'bottom' | 'left';
    label?: string;
    quadrant: number;
  }

  interface Goal {
    id: string;
    text: string;
    doneWhen?: string;   // concrete definition of done
    done: boolean;
    createdAt: number;
    completedAt?: number;
  }


  interface State {
    notes: Note[];
    goals?: Goal[];
    props?: Prop[];
    arrows?: Arrow[];
    nextZIndex: number;
    boardTitles?: string[];
    emailTemplates?: EmailTemplate[];
    plays?: Play[];
    deals?: Deal[];
    // ids of things deleted here, so a delete survives a merge from another device
    tombs?: { id: string; at: number }[];
    boardLabels?: BoardLabel[];
  }

  const DEFAULT_TITLES = ['Orange', 'Yellow', 'Green', 'Blue', 'Indigo', 'Violet'];
  const BOARD_COLORS = ['#fed7aa', '#fef08a', '#bbf7d0', '#93c5fd', '#c7d2fe', '#ddd6fe'];
  const ACTIVITY_ICONS: Record<string, string> = {
    call: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>',
    email: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>',
    meeting: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>',
    linkedin: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
    web: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>',
    note: '📝',
    link: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>',
    reminder: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  };
  let state: State = { notes: [], nextZIndex: 1, boardTitles: [...DEFAULT_TITLES] };
  let selectedId: string | null = null;
  let isDragging = false;
  let dragTarget: HTMLElement | null = null;
  let dragStartX = 0;
  let dragStartY = 0;
  let dragOffset = { x: 0, y: 0 };
  let syncStatus: 'none' | 'syncing' | 'success' | 'error' = 'none';
  let currentColor = '#fed7aa';
  let lastDeleted: Note | null = null;
  let avatarTargetId: string | null = null;
  let editingActivities: Activity[] = [];
  let currentActivityType: 'call' | 'email' | 'meeting' | 'note' | 'linkedin' | 'web' = 'note';
  let editingNoteQuadrant: number = 0;
  let activeQuadrant = 0;
  let detailNoteId: string | null = null;
  let selectedSnoozeAction: 'call' | 'email' | 'meeting' | 'linkedin' | 'web' | null = null;
  let multiSelectMode = false;
  let multiSelected: Set<string> = new Set();

  // Props state
  let selectedPropId: string | null = null;
  let propsPaletteOpen = false;
  let arrowMode = false;
  let arrowFromProp: { id: string; anchor: 'top' | 'right' | 'bottom' | 'left' } | null = null;
  let resizingProp: { id: string; handle: string; startX: number; startY: number; startWidth: number; startHeight: number } | null = null;
  let draggingProp: HTMLElement | null = null;
  let propDragOffset = { x: 0, y: 0 };
  let editingPropId: string | null = null;

  // Auth
  function checkAuth(): boolean {
    const authed = localStorage.getItem(AUTH_KEY) === 'true';
    const loginGate = document.getElementById('login-gate')!;
    const app = document.getElementById('app')!;

    if (authed) {
      loginGate.classList.add('hidden');
      app.classList.add('visible');
      return true;
    } else {
      loginGate.classList.remove('hidden');
      app.classList.remove('visible');
      (document.getElementById('password-input') as HTMLInputElement)?.focus();
      return false;
    }
  }

  function attemptLogin() {
    const input = document.getElementById('password-input') as HTMLInputElement;
    const error = document.getElementById('login-error')!;

    if (input.value === PASSWORD) {
      localStorage.setItem(AUTH_KEY, 'true');
      checkAuth();
      init();
    } else {
      error.style.display = 'block';
      input.value = '';
      input.focus();
    }
  }

  document.getElementById('login-btn')?.addEventListener('click', attemptLogin);
  document.getElementById('password-input')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') attemptLogin();
  });

  // Storage
  function save() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    markViewsDirty();
    syncToCloud();
  }

  function saveBoardTitle(q: number, title: string) {
    if (!state.boardTitles) state.boardTitles = [...DEFAULT_TITLES];
    state.boardTitles[q] = title || DEFAULT_TITLES[q];
    save();
  }

  /* Merging by id alone cannot express a deletion: the other device simply
     has no row for it, which is indistinguishable from never having seen it.
     So a delete leaves a marker, and the merge honours it. Kept for 90 days,
     which is far longer than any device stays offline. */
  const TOMB_TTL = 90 * 86400000;

  function tombstone(...ids: string[]) {
    if (!state.tombs) state.tombs = [];
    const now = Date.now();
    ids.filter(Boolean).forEach(id => {
      state.tombs = state.tombs!.filter(t => t.id !== id);
      state.tombs!.push({ id, at: now });
    });
    state.tombs = state.tombs.filter(t => now - t.at < TOMB_TTL);
  }

  function emptyState(): State {
    return { notes: [], nextZIndex: 1, boardTitles: [...DEFAULT_TITLES], props: [], arrows: [], goals: [], boardLabels: [], plays: [], deals: [], tombs: [] };
  }

  /* Any blob becoming `state` goes through here. Older projects predate
     props/arrows/goals/boardLabels, and assigning one raw leaves those
     undefined, which breaks renderProps/renderBoardLabels downstream. */
  function normalizeState(raw: any): State {
    if (!raw || typeof raw !== 'object') return emptyState();
    return {
      ...raw,
      notes: Array.isArray(raw.notes) ? raw.notes : [],
      nextZIndex: typeof raw.nextZIndex === 'number' ? raw.nextZIndex : 1,
      boardTitles: Array.isArray(raw.boardTitles) ? raw.boardTitles : [...DEFAULT_TITLES],
      props: Array.isArray(raw.props) ? raw.props : [],
      arrows: Array.isArray(raw.arrows) ? raw.arrows : [],
      goals: Array.isArray(raw.goals) ? raw.goals : [],
      plays: Array.isArray(raw.plays) ? raw.plays : [],
      deals: Array.isArray(raw.deals) ? raw.deals : [],
      tombs: Array.isArray(raw.tombs) ? raw.tombs : [],
      boardLabels: Array.isArray(raw.boardLabels) ? raw.boardLabels : [],
    };
  }

  /* Re-render whatever the user is actually looking at. render() only fills
     the .board elements, and those are display:none in Goals and List mode -
     so calling it alone leaves those views showing the previous project. */
  const viewDirty = { tasks: true, goals: true, list: true };
  function markViewsDirty() { viewDirty.tasks = viewDirty.goals = viewDirty.list = true; }

  function refreshView(force = false) {
    if (viewMode === 'goals') {
      if (force || viewDirty.goals) { renderGoals(); viewDirty.goals = false; }
    } else if (viewMode === 'list') {
      if (force || viewDirty.list) { renderList(); viewDirty.list = false; }
    } else if (viewMode === 'plays') {
      renderPlaysView();
    } else if (viewMode === 'deals') {
      renderDeals();
    } else if (viewMode === 'people') {
      renderPeople();
    } else {
      if (force || viewDirty.tasks) { render(); viewDirty.tasks = false; }
      updateMinimap();
    }
  }

  /* Bring the cloud copy into the local one.
     This used to name notes, boardTitles and goals by hand, so anything added
     later - plays, email templates, props, arrows, board labels - was simply
     never read, and a device would sit there insisting it had none. Keys are
     discovered rather than listed, so a new one works without touching this. */
  const ID_COLLECTIONS = ['notes', 'goals', 'props', 'arrows', 'boardLabels', 'plays', 'deals'];

  function mergeFromCloud(local: State, cloud: any): State {
    const out: any = { ...local };

    // adopt any key this client has never heard of
    for (const k of Object.keys(cloud)) if (!(k in out)) out[k] = cloud[k];

    /* id-keyed collections: take whichever copy was touched last. This used
       to keep the local one unconditionally, which meant an edit made on
       another device - hydrating someone on the phone, say - could never
       reach this browser, even after a reload. */
    // when the cloud copy was last written - lets us tell "deleted" from "not yet synced"
    const cloudSavedAt: number = typeof cloud.savedAt === 'number' ? cloud.savedAt : 0;

    // deletions from either side, newest marker wins
    const tombs = new Map<string, number>();
    [...(Array.isArray(out.tombs) ? out.tombs : []), ...(Array.isArray(cloud.tombs) ? cloud.tombs : [])]
      .forEach((t: any) => {
        if (!t || !t.id) return;
        if (!tombs.has(t.id) || t.at > tombs.get(t.id)!) tombs.set(t.id, t.at);
      });
    const now = Date.now();
    out.tombs = [...tombs.entries()]
      .filter(([, at]) => now - at < TOMB_TTL)
      .map(([id, at]) => ({ id, at }));

    for (const k of ID_COLLECTIONS) {
      const mine = Array.isArray(out[k]) ? out[k] : [];
      const theirs = Array.isArray(cloud[k]) ? cloud[k] : [];
      const map = new Map<string, any>(mine.filter((x: any) => x && x.id).map((x: any) => [x.id, x]));
      theirs.forEach((t: any) => {
        if (!t || !t.id) return;
        const m = map.get(t.id);
        if (!m || (t.updatedAt || 0) > (m.updatedAt || 0)) map.set(t.id, t);
      });
      /* Two ways an item can be gone.
         1. An explicit tombstone, which beats any copy not touched since.
         2. It is simply absent from a cloud copy that was written AFTER this
            item was last touched. That means some other device removed it -
            "absent from a newer cloud" is a deletion, whereas "absent from an
            older cloud" just means the cloud has not caught up yet. Without
            this, any client that deletes without writing a tombstone leaves
            ghosts on every other device, forever. */
      const cloudIds = new Set(theirs.filter((x: any) => x && x.id).map((x: any) => x.id));
      out[k] = [...map.values()].filter((x: any) => {
        const at = tombs.get(x.id);
        if (at !== undefined && (x.updatedAt || 0) <= at) return false;
        if (!cloudIds.has(x.id) && cloudSavedAt && (x.updatedAt || 0) < cloudSavedAt) return false;
        return true;
      });
    }

    // templates are keyed by name rather than id
    const mineT = Array.isArray(out.emailTemplates) ? out.emailTemplates : [];
    const theirsT = Array.isArray(cloud.emailTemplates) ? cloud.emailTemplates : [];
    const names = new Set(mineT.map((t: any) => t && t.name));
    out.emailTemplates = [...mineT, ...theirsT.filter((t: any) => t && !names.has(t.name))];

    if (cloud.boardTitles) out.boardTitles = cloud.boardTitles;
    out.nextZIndex = Math.max(out.nextZIndex || 1, cloud.nextZIndex || 1);
    return normalizeState(out);
  }

  function load(): State {
    const data = localStorage.getItem(STORAGE_KEY);
    if (!data) return emptyState();
    try { return normalizeState(JSON.parse(data)); }
    catch { return emptyState(); }
  }

  // Sync
  function getSyncPassword(): string | null {
    return localStorage.getItem(SYNC_PASSWORD_KEY);
  }

  function updateSyncIndicator() {
    const indicator = document.getElementById('sync-indicator');
    if (!indicator) return;

    const pw = getSyncPassword();
    indicator.className = '';

    if (!pw) {
      indicator.title = 'Cloud sync disabled - set password in settings';
      indicator.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>';
      return;
    }

    switch (syncStatus) {
      case 'syncing':
        indicator.className = 'syncing';
        indicator.title = 'Syncing...';
        indicator.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9"></path></svg>';
        break;
      case 'success':
        indicator.className = 'success';
        indicator.title = 'Synced to cloud';
        indicator.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path><polyline points="8 14 11 17 16 12"></polyline></svg>';
        break;
      case 'error':
        indicator.className = 'error';
        indicator.title = 'Sync failed - click to retry';
        indicator.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
        break;
      default:
        indicator.title = 'Cloud sync ready';
        indicator.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>';
    }
  }

  let syncTimeout: ReturnType<typeof setTimeout> | null = null;
  async function syncToCloud() {
    const pw = getSyncPassword();
    if (!pw) { syncStatus = 'none'; updateSyncIndicator(); return; }

    if (syncTimeout) clearTimeout(syncTimeout);
    syncTimeout = setTimeout(async () => {
      syncStatus = 'syncing';
      updateSyncIndicator();
      try {
        const res = await fetch(WORKER_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Sync-Password': pw },
          body: JSON.stringify(state)
        });
        syncStatus = res.ok ? 'success' : 'error';
      } catch {
        syncStatus = 'error';
      }
      updateSyncIndicator();
    }, 1000);
  }

  async function syncFromCloud(): Promise<State | null> {
    const pw = getSyncPassword();
    if (!pw) return null;

    try {
      const res = await fetch(WORKER_URL, {
        method: 'GET',
        headers: { 'X-Sync-Password': pw }
      });
      if (res.ok) {
        syncStatus = 'success';
        updateSyncIndicator();
        return await res.json();
      }
      if (res.status === 404) {
        syncStatus = 'success';
        updateSyncIndicator();
        return null;
      }
    } catch {
      syncStatus = 'error';
      updateSyncIndicator();
    }
    return null;
  }

  // Notes
  function createNote(x: number, y: number, color = currentColor, isLead = false): Note {
    const rotation = (Math.random() - 0.5) * 6;
    const note: Note = {
      id: `note-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      text: isLead ? '' : '',
      color,
      x,
      y: isLead ? Math.max(60, y) : y,
      rotation,
      createdAt: Date.now(),
      updatedAt: Date.now(),
      zIndex: state.nextZIndex++,
      isLead,
      quadrant: activeQuadrant
    };
    state.notes.push(note);
    save();
    return note;
  }

  function updateNote(id: string, updates: Partial<Note>) {
    const note = state.notes.find(n => n.id === id);
    if (note) {
      Object.assign(note, updates, { updatedAt: Date.now() });
      save();
    }
  }

  function deleteNote(id: string) {
    const note = state.notes.find(n => n.id === id);
    if (note) lastDeleted = { ...note };
    tombstone(id);
    state.notes = state.notes.filter(n => n.id !== id);
    if (selectedId === id) selectedId = null;
    save();
    render();
  }

  function undoDelete() {
    if (lastDeleted) {
      state.notes.push(lastDeleted);
      lastDeleted = null;
      save();
      render();
    }
  }

  function bringToFront(id: string) {
    const note = state.notes.find(n => n.id === id);
    if (note) {
      note.zIndex = state.nextZIndex++;
      save();
    }
  }

  // Confetti
  function showConfetti(el: HTMLElement) {
    const rect = el.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;

    const container = document.createElement('div');
    container.className = 'confetti';
    document.body.appendChild(container);

    const colors = ['#ff0000', '#ff8800', '#ffff00', '#00ff00', '#00ffff', '#0088ff', '#8800ff', '#ff00ff'];

    for (let i = 0; i < 100; i++) {
      const piece = document.createElement('div');
      piece.className = 'confetti-piece';
      piece.style.left = `${x}px`;
      piece.style.top = `${y}px`;

      const angle = Math.random() * Math.PI * 2;
      const velocity = 150 + Math.random() * 350;
      const tx = Math.cos(angle) * velocity;
      const ty = Math.sin(angle) * velocity - 150;

      piece.style.setProperty('--tx', `${tx}px`);
      piece.style.setProperty('--ty', `${ty}px`);
      piece.style.background = colors[Math.floor(Math.random() * colors.length)];
      piece.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      piece.style.animation = `confetti-explode ${1.2 + Math.random() * 1}s ease-out forwards`;
      piece.style.animationDelay = `${Math.random() * 0.15}s`;

      container.appendChild(piece);
    }

    setTimeout(() => container.remove(), 3000);
  }

  // Format date
  function formatDate(ts: number): string {
    const d = new Date(ts);
    return `${d.getDate()} ${d.toLocaleString('default', { month: 'short' })}`;
  }

  // Board Labels
  let draggingLabel: HTMLElement | null = null;
  let labelDragOffset = { x: 0, y: 0 };

  function createBoardLabel(x: number, y: number, quadrant: number) {
    const label: BoardLabel = {
      id: `label-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      text: 'Label',
      x,
      y,
      quadrant
    };

    if (!state.boardLabels) state.boardLabels = [];
    state.boardLabels.push(label);
    save();
    renderBoardLabels();

    // Focus the new label for editing
    setTimeout(() => {
      const el = document.querySelector(`.board-label[data-id="${label.id}"] .board-label-text`) as HTMLElement;
      if (el) {
        el.focus();
        // Select all text
        const range = document.createRange();
        range.selectNodeContents(el);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }, 50);
  }

  function updateBoardLabel(id: string, updates: Partial<BoardLabel>) {
    if (!state.boardLabels) return;
    const label = state.boardLabels.find(l => l.id === id);
    if (label) {
      Object.assign(label, updates);
      save();
    }
  }

  function deleteBoardLabel(id: string) {
    if (!state.boardLabels) return;
    state.boardLabels = state.boardLabels.filter(l => l.id !== id);
    save();
    renderBoardLabels();
  }

  function renderBoardLabels() {
    // Remove existing labels
    document.querySelectorAll('.board-label').forEach(l => l.remove());

    if (!state.boardLabels) return;

    state.boardLabels.forEach(label => {
      const board = document.getElementById(`board-${label.quadrant}`);
      if (!board) return;

      const el = document.createElement('div');
      el.className = 'board-label';
      el.dataset.id = label.id;
      el.style.left = `${label.x}px`;
      el.style.top = `${label.y}px`;
      el.innerHTML = `
        <span class="board-label-text" contenteditable="true">${escapeHtml(label.text)}</span>
        <button class="board-label-delete" title="Delete">&times;</button>
      `;

      const textEl = el.querySelector('.board-label-text') as HTMLElement;
      const deleteBtn = el.querySelector('.board-label-delete') as HTMLButtonElement;

      // Edit text
      textEl.addEventListener('blur', () => {
        el.classList.remove('editing');
        const newText = textEl.textContent?.trim() || 'Label';
        updateBoardLabel(label.id, { text: newText });
      });

      textEl.addEventListener('focus', () => {
        el.classList.add('editing');
      });

      textEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          textEl.blur();
        }
      });

      // Delete
      deleteBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteBoardLabel(label.id);
      });

      // Drag
      el.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement).classList.contains('board-label-text') && el.classList.contains('editing')) {
          return; // Don't drag while editing
        }
        if ((e.target as HTMLElement).classList.contains('board-label-delete')) return;

        e.preventDefault();
        draggingLabel = el;
        const rect = el.getBoundingClientRect();
        labelDragOffset = {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top
        };
        el.style.zIndex = '1000';
      });

      board.appendChild(el);
    });
  }

  // Label drag handlers
  document.addEventListener('mousemove', (e) => {
    if (!draggingLabel) return;

    const board = draggingLabel.closest('.board') as HTMLElement;
    if (!board) return;

    const boardRect = board.getBoundingClientRect();
    const x = e.clientX - boardRect.left + board.scrollLeft - labelDragOffset.x;
    const y = e.clientY - boardRect.top + board.scrollTop - labelDragOffset.y;

    draggingLabel.style.left = `${Math.max(0, x)}px`;
    draggingLabel.style.top = `${Math.max(0, y)}px`;
  });

  document.addEventListener('mouseup', () => {
    if (draggingLabel) {
      const id = draggingLabel.dataset.id;
      const x = parseInt(draggingLabel.style.left);
      const y = parseInt(draggingLabel.style.top);
      draggingLabel.style.zIndex = '100';

      if (id) {
        updateBoardLabel(id, { x, y });
      }
      draggingLabel = null;
    }
  });

  // Props System
  const PROP_SIZES: Record<string, { width: number; height: number; ratio: number }> = {
    mobile: { width: 140, height: 280, ratio: 9 / 19 },
    pc: { width: 320, height: 200, ratio: 16 / 10 },
    tv: { width: 400, height: 225, ratio: 16 / 9 }
  };

  function createProp(type: 'mobile' | 'tv' | 'pc', x: number, y: number): Prop {
    const size = PROP_SIZES[type];
    const prop: Prop = {
      id: `prop-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      type,
      x,
      y,
      width: size.width,
      height: size.height,
      label: type.charAt(0).toUpperCase() + type.slice(1),
      quadrant: activeQuadrant,
      zIndex: state.nextZIndex++,
      createdAt: Date.now()
    };

    if (!state.props) state.props = [];
    state.props.push(prop);
    save();
    renderProps();
    return prop;
  }

  function updateProp(id: string, updates: Partial<Prop>) {
    if (!state.props) return;
    const prop = state.props.find(p => p.id === id);
    if (prop) {
      Object.assign(prop, updates);
      save();
    }
  }

  function deleteProp(id: string) {
    if (!state.props) return;
    state.props = state.props.filter(p => p.id !== id);
    // Remove connected arrows
    if (state.arrows) {
      state.arrows = state.arrows.filter(a => a.fromPropId !== id && a.toPropId !== id);
    }
    if (selectedPropId === id) selectedPropId = null;
    save();
    renderProps();
    renderArrows();
  }

  function bringPropToFront(id: string) {
    if (!state.props) return;
    const prop = state.props.find(p => p.id === id);
    if (prop) {
      prop.zIndex = state.nextZIndex++;
      save();
    }
  }

  function renderProps() {
    // Remove existing props
    document.querySelectorAll('.device-prop').forEach(p => p.remove());

    if (!state.props) return;

    state.props.forEach(prop => {
      const board = document.getElementById(`board-${prop.quadrant}`);
      if (!board) return;

      const el = document.createElement('div');
      el.className = `device-prop device-${prop.type} ${selectedPropId === prop.id ? 'selected' : ''}`;
      el.dataset.id = prop.id;
      el.style.cssText = `
        left: ${prop.x}px;
        top: ${prop.y}px;
        width: ${prop.width}px;
        height: ${prop.height}px;
        z-index: ${prop.zIndex};
      `;

      const screenContent = prop.image ? `<img src="${prop.image}" alt="Screen">` : '';
      let innerHtml = '';
      if (prop.type === 'mobile') {
        innerHtml = `
          <div class="device-screen">
            ${screenContent}
            <div class="device-notch"></div>
          </div>
        `;
      } else if (prop.type === 'pc') {
        innerHtml = `
          <div class="device-screen">${screenContent}</div>
          <div class="device-stand"></div>
        `;
      } else if (prop.type === 'tv') {
        innerHtml = `
          <div class="device-screen">${screenContent}</div>
          <div class="device-led"></div>
        `;
      }

      el.innerHTML = `
        ${innerHtml}
        <div class="device-label" contenteditable="true">${escapeHtml(prop.label)}</div>
        <button class="prop-delete" title="Delete">&times;</button>
        <div class="resize-handle nw" data-handle="nw"></div>
        <div class="resize-handle ne" data-handle="ne"></div>
        <div class="resize-handle sw" data-handle="sw"></div>
        <div class="resize-handle se" data-handle="se"></div>
        <div class="arrow-anchor top" data-anchor="top"></div>
        <div class="arrow-anchor right" data-anchor="right"></div>
        <div class="arrow-anchor bottom" data-anchor="bottom"></div>
        <div class="arrow-anchor left" data-anchor="left"></div>
      `;

      // Label editing
      const labelEl = el.querySelector('.device-label') as HTMLElement;
      labelEl.addEventListener('blur', () => {
        updateProp(prop.id, { label: labelEl.textContent?.trim() || prop.type });
      });
      labelEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          labelEl.blur();
        }
      });
      labelEl.addEventListener('mousedown', (e) => e.stopPropagation());

      // Delete button
      const deleteBtn = el.querySelector('.prop-delete') as HTMLButtonElement;
      deleteBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteProp(prop.id);
      });

      // Resize handles
      el.querySelectorAll('.resize-handle').forEach(handle => {
        handle.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          e.preventDefault();
          const h = (handle as HTMLElement).dataset.handle!;
          resizingProp = {
            id: prop.id,
            handle: h,
            startX: (e as MouseEvent).clientX,
            startY: (e as MouseEvent).clientY,
            startWidth: prop.width,
            startHeight: prop.height
          };
          selectedPropId = prop.id;
          document.querySelectorAll('.device-prop.selected').forEach(p => p.classList.remove('selected'));
          el.classList.add('selected');
        });
      });

      // Arrow anchors
      el.querySelectorAll('.arrow-anchor').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          e.stopPropagation();
          const anchorType = (anchor as HTMLElement).dataset.anchor as 'top' | 'right' | 'bottom' | 'left';
          handleAnchorClick(prop.id, anchorType);
        });
      });

      // Prop drag
      el.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement).closest('.device-label') ||
            (e.target as HTMLElement).closest('.prop-delete') ||
            (e.target as HTMLElement).closest('.resize-handle') ||
            (e.target as HTMLElement).closest('.arrow-anchor')) return;

        e.preventDefault(); // Prevent text selection during drag

        selectedPropId = prop.id;
        selectedId = null; // Deselect any sticky note
        draggingProp = el;
        bringPropToFront(prop.id);

        const rect = el.getBoundingClientRect();
        propDragOffset = { x: e.clientX - rect.left, y: e.clientY - rect.top };

        // Update visual state without re-rendering (which would destroy our reference)
        document.querySelectorAll('.device-prop.selected').forEach(p => p.classList.remove('selected'));
        el.classList.add('selected', 'dragging');
        el.style.zIndex = '9999';
      });

      // Double-click to open image modal
      el.addEventListener('dblclick', (e) => {
        if ((e.target as HTMLElement).closest('.device-label')) return;
        openPropImageModal(prop.id);
      });

      board.appendChild(el);
    });

    // Render arrows after props are in place
    renderArrows();
  }

  // Arrow System
  function handleAnchorClick(propId: string, anchor: 'top' | 'right' | 'bottom' | 'left') {
    if (!arrowFromProp) {
      // First click - set source and enter arrow mode
      arrowFromProp = { id: propId, anchor };
      enterArrowMode();
      // Highlight the selected anchor
      const el = document.querySelector(`[data-id="${propId}"] .arrow-anchor.${anchor}`);
      el?.classList.add('active');
    } else {
      // Second click - create arrow
      if (arrowFromProp.id !== propId) {
        createArrow(arrowFromProp.id, propId, arrowFromProp.anchor, anchor);
      }
      // Clear selection
      document.querySelectorAll('.arrow-anchor.active').forEach(a => a.classList.remove('active'));
      arrowFromProp = null;
      exitArrowMode();
    }
  }

  function createArrow(fromId: string, toId: string, fromAnchor: 'top' | 'right' | 'bottom' | 'left', toAnchor: 'top' | 'right' | 'bottom' | 'left') {
    if (!state.props) return;

    const fromProp = state.props.find(p => p.id === fromId);
    const toProp = state.props.find(p => p.id === toId);
    if (!fromProp || !toProp) return;

    // Only allow arrows on same board
    if (fromProp.quadrant !== toProp.quadrant) return;

    const arrow: Arrow = {
      id: `arrow-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      fromPropId: fromId,
      toPropId: toId,
      fromAnchor,
      toAnchor,
      quadrant: fromProp.quadrant
    };

    if (!state.arrows) state.arrows = [];
    state.arrows.push(arrow);
    save();
    renderArrows();
  }

  function deleteArrow(id: string) {
    if (!state.arrows) return;
    state.arrows = state.arrows.filter(a => a.id !== id);
    save();
    renderArrows();
  }

  function getAnchorPosition(prop: Prop, anchor: 'top' | 'right' | 'bottom' | 'left'): { x: number; y: number } {
    switch (anchor) {
      case 'top':
        return { x: prop.x + prop.width / 2, y: prop.y };
      case 'right':
        return { x: prop.x + prop.width, y: prop.y + prop.height / 2 };
      case 'bottom':
        return { x: prop.x + prop.width / 2, y: prop.y + prop.height };
      case 'left':
        return { x: prop.x, y: prop.y + prop.height / 2 };
    }
  }

  function renderArrows() {
    // Remove existing SVG layers
    document.querySelectorAll('.arrow-layer').forEach(l => l.remove());

    if (!state.arrows || !state.props) return;

    // Group arrows by quadrant
    const arrowsByQuadrant: Record<number, Arrow[]> = {};
    state.arrows.forEach(arrow => {
      if (!arrowsByQuadrant[arrow.quadrant]) arrowsByQuadrant[arrow.quadrant] = [];
      arrowsByQuadrant[arrow.quadrant].push(arrow);
    });

    // Create SVG layer for each board that has arrows
    Object.entries(arrowsByQuadrant).forEach(([q, arrows]) => {
      const board = document.getElementById(`board-${q}`);
      if (!board) return;

      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('class', 'arrow-layer');
      svg.setAttribute('width', '100%');
      svg.setAttribute('height', '100%');
      svg.style.position = 'absolute';
      svg.style.top = '0';
      svg.style.left = '0';
      svg.style.overflow = 'visible';

      // Add arrowhead marker
      const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
      defs.innerHTML = `
        <marker id="arrowhead-${q}" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
          <polygon points="0 0, 10 3.5, 0 7" fill="#6b7280" />
        </marker>
      `;
      svg.appendChild(defs);

      arrows.forEach(arrow => {
        const fromProp = state.props!.find(p => p.id === arrow.fromPropId);
        const toProp = state.props!.find(p => p.id === arrow.toPropId);
        if (!fromProp || !toProp) return;

        const start = getAnchorPosition(fromProp, arrow.fromAnchor);
        const end = getAnchorPosition(toProp, arrow.toAnchor);

        // Calculate control points for curved line
        const dx = end.x - start.x;
        const dy = end.y - start.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const curveOffset = Math.min(dist * 0.3, 80);

        let cp1x = start.x, cp1y = start.y, cp2x = end.x, cp2y = end.y;

        // Adjust control points based on anchor direction
        if (arrow.fromAnchor === 'top') cp1y -= curveOffset;
        else if (arrow.fromAnchor === 'bottom') cp1y += curveOffset;
        else if (arrow.fromAnchor === 'left') cp1x -= curveOffset;
        else if (arrow.fromAnchor === 'right') cp1x += curveOffset;

        if (arrow.toAnchor === 'top') cp2y -= curveOffset;
        else if (arrow.toAnchor === 'bottom') cp2y += curveOffset;
        else if (arrow.toAnchor === 'left') cp2x -= curveOffset;
        else if (arrow.toAnchor === 'right') cp2x += curveOffset;

        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        path.setAttribute('d', `M ${start.x} ${start.y} C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${end.x} ${end.y}`);
        path.setAttribute('marker-end', `url(#arrowhead-${q})`);
        path.setAttribute('data-id', arrow.id);
        path.style.pointerEvents = 'stroke';
        path.style.cursor = 'pointer';

        // Click to delete arrow
        path.addEventListener('click', () => {
          if (confirm('Delete this arrow?')) {
            deleteArrow(arrow.id);
          }
        });

        svg.appendChild(path);
      });

      // Insert SVG at the beginning of board (behind props)
      board.insertBefore(svg, board.firstChild?.nextSibling || null);
    });
  }

  function togglePropsPalette() {
    propsPaletteOpen = !propsPaletteOpen;
    const palette = document.getElementById('props-palette');
    if (palette) {
      palette.classList.toggle('hidden', !propsPaletteOpen);
    }
  }

  function enterArrowMode() {
    arrowMode = true;
    arrowFromProp = null;
    document.body.classList.add('arrow-mode');
    document.getElementById('arrow-mode-btn')?.classList.add('active');
  }

  function exitArrowMode() {
    arrowMode = false;
    arrowFromProp = null;
    document.body.classList.remove('arrow-mode');
    document.getElementById('arrow-mode-btn')?.classList.remove('active');
  }

  // Prop drag/resize handlers
  document.addEventListener('mousemove', (e) => {
    // Prop dragging
    if (draggingProp && selectedPropId) {
      const prop = state.props?.find(p => p.id === selectedPropId);
      if (!prop) return;

      const board = document.getElementById(`board-${prop.quadrant}`)!;
      const rect = board.getBoundingClientRect();
      const x = e.clientX - rect.left - propDragOffset.x + board.scrollLeft;
      const y = e.clientY - rect.top - propDragOffset.y + board.scrollTop;

      prop.x = Math.max(0, x);
      prop.y = Math.max(0, y);

      draggingProp.style.left = `${prop.x}px`;
      draggingProp.style.top = `${prop.y}px`;

      // Update arrows in real-time
      renderArrows();
    }

    // Prop resizing
    if (resizingProp) {
      const prop = state.props?.find(p => p.id === resizingProp!.id);
      if (!prop) return;

      const dx = e.clientX - resizingProp.startX;
      const dy = e.clientY - resizingProp.startY;
      const size = PROP_SIZES[prop.type];

      let newWidth = resizingProp.startWidth;
      let newHeight = resizingProp.startHeight;

      // Calculate new dimensions based on handle
      if (resizingProp.handle.includes('e')) {
        newWidth = Math.max(80, resizingProp.startWidth + dx);
      }
      if (resizingProp.handle.includes('w')) {
        newWidth = Math.max(80, resizingProp.startWidth - dx);
        prop.x = prop.x + (resizingProp.startWidth - newWidth);
      }
      if (resizingProp.handle.includes('s')) {
        newHeight = Math.max(60, resizingProp.startHeight + dy);
      }
      if (resizingProp.handle.includes('n')) {
        newHeight = Math.max(60, resizingProp.startHeight - dy);
        prop.y = prop.y + (resizingProp.startHeight - newHeight);
      }

      // Maintain aspect ratio
      if (resizingProp.handle === 'se' || resizingProp.handle === 'nw') {
        newHeight = newWidth / size.ratio;
      } else if (resizingProp.handle === 'sw' || resizingProp.handle === 'ne') {
        newWidth = newHeight * size.ratio;
      }

      prop.width = newWidth;
      prop.height = newHeight;

      const el = document.querySelector(`[data-id="${prop.id}"]`) as HTMLElement;
      if (el) {
        el.style.width = `${newWidth}px`;
        el.style.height = `${newHeight}px`;
        el.style.left = `${prop.x}px`;
        el.style.top = `${prop.y}px`;
      }

      renderArrows();
    }
  });

  document.addEventListener('mouseup', () => {
    if (draggingProp && selectedPropId) {
      const prop = state.props?.find(p => p.id === selectedPropId);
      if (prop) {
        save();
        renderArrows();
      }
      draggingProp.classList.remove('dragging');
      draggingProp = null;
    }

    if (resizingProp) {
      save();
      resizingProp = null;
      renderProps();
    }
  });

  // Props palette event listeners
  document.getElementById('props-palette')?.querySelector('.palette-close')?.addEventListener('click', () => {
    propsPaletteOpen = false;
    document.getElementById('props-palette')?.classList.add('hidden');
