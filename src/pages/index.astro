    if (noteContent) {
      noteContent.value = note.text || '';
    }
    renderNoteImages(note);
    populateGoalSelect(note);

    renderPlayControl(note);
    renderLastPost(note);
    detailTodayOn = isFlaggedToday(note) ? (note.todayOn as number) : undefined;
    document.getElementById('detail-today')?.classList.toggle('on', !!detailTodayOn);

    // Populate lead view fields
