  transition: transform 0.15s, box-shadow 0.15s;
}
#fab-add-btn { background: #fef08a; color: #78716c; }
#fab-add-btn:hover { transform: scale(1.05); box-shadow: 0 4px 14px rgba(0,0,0,0.15); }
#fab-color-btn {
  width: 36px;
