  // Template picker for sending email
  function showTemplatePicker(note: Note) {
    const templates = getTemplates();
    if (templates.length === 0) {
      alert('No email templates. Create one in Settings first.');
      return;
    }

    pendingEmailLead = note;
    templatePickerList.innerHTML = templates.map((t, i) => `
      <button class="template-picker-item" data-index="${i}">
        <div class="name">${escapeHtml(t.name)}</div>
      </button>
    `).join('');

    templatePickerList.querySelectorAll('.template-picker-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.index || '0');
        sendEmailWithTemplate(idx);
      });
    });

    templatePicker.classList.add('visible');
  }

  function sendEmailWithTemplate(templateIndex: number) {
    const templates = getTemplates();
    const template = templates[templateIndex];
    if (!template || !pendingEmailLead) return;

    const lead = pendingEmailLead;
    const replacePlaceholders = (text: string) => {
      return text
        .replace(/\[name\]/gi, lead.name || lead.text?.split('\n')[0] || '')
        .replace(/\[company\]/gi, lead.company || '')
        .replace(/\[role\]/gi, lead.role || '');
    };

    const subject = encodeURIComponent(replacePlaceholders(template.subject));
    const body = encodeURIComponent(replacePlaceholders(template.body));
    const email = lead.email || '';

    const mailtoUrl = `mailto:${email}?subject=${subject}&body=${body}`;
    window.open(mailtoUrl, '_blank');

    templatePicker.classList.remove('visible');
    pendingEmailLead = null;
  }

