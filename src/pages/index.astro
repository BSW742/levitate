  function formatActivityTime(timestamp: number): string {
    const now = Date.now();
    const diff = now - timestamp;
    const mins = Math.floor(diff / 60000);
    const hours = Math.floor(diff / 3600000);
    const days = Math.floor(diff / 86400000);

    if (mins < 1) return 'Just now';
    if (mins < 60) return `${mins}m ago`;
    if (hours < 24) return `${hours}h ago`;
    if (days < 7) return `${days}d ago`;

    const date = new Date(timestamp);
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function closeDetailModal() {
    document.getElementById('detail-modal')!.classList.remove('visible');

    // A task added from a goal card but never written into is litter
    if (pendingEmptyNoteId) {
      const n = state.notes.find(x => x.id === pendingEmptyNoteId);
      if (n && !(n.text || '').trim() && !n.images?.length && !n.activity?.length) {
        tombstone(pendingEmptyNoteId);
        state.notes = state.notes.filter(x => x.id !== pendingEmptyNoteId);
        save();
      }
      pendingEmptyNoteId = null;
      if (viewMode === 'goals') renderGoals();
    } else if (viewMode === 'goals') {
      renderGoals();   // status may have changed
    }

    detailNoteId = null;
  }

