  function openTemplateEditor(index: number | null) {
    editingTemplateIndex = index;
    const templates = getTemplates();
    const template = index !== null ? templates[index] : null;

    (document.getElementById('template-modal-title') as HTMLElement).textContent = template ? 'Edit Template' : 'New Template';
    (document.getElementById('template-name') as HTMLInputElement).value = template?.name || '';
    (document.getElementById('template-subject') as HTMLInputElement).value = template?.subject || '';
