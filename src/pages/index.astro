/* Sticky notes */
.sticky-note {
  position: absolute;
  width: 180px;
  min-height: 140px;
  padding: 12px;
  border-radius: 2px;
  box-shadow: 2px 3px 12px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.06);
