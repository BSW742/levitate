}

/* Template Editor Modal */
.template-modal-content {
  max-width: 500px;
}
.template-modal-content .field-group {
  margin-bottom: 16px;
}
.template-modal-content label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: #374151;
  margin-bottom: 6px;
}
.template-modal-content input,
.template-modal-content textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
}
.template-modal-content input:focus,
.template-modal-content textarea:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}
.template-modal-content textarea {
  resize: vertical;
  min-height: 120px;
}
.template-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid #e5e7eb;
}
.template-actions-right {
  display: flex;
  gap: 8px;
}
.template-actions button {
  padding: 10px 20px;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
}
.template-actions button.primary {
  background: #4f46e5;
  color: white;
}
.template-actions button.primary:hover { background: #4338ca; }
.template-actions button.secondary {
  background: #f3f4f6;
  color: #374151;
}
.template-actions button.secondary:hover { background: #e5e7eb; }
.template-actions button.danger {
  background: transparent;
  color: #dc2626;
}
.template-actions button.danger:hover { background: #fef2f2; }

/* Template Picker (when clicking email on lead) */
.template-picker {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s;
}
.template-picker.visible {
  opacity: 1;
  visibility: visible;
}
.template-picker-content {
  background: white;
  border-radius: 12px;
  padding: 20px;
  width: 90%;
  max-width: 320px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.2);
}
.template-picker h3 {
  font-size: 16px;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16px;
}
.template-picker-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.template-picker-item {
  padding: 12px 16px;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  text-align: left;
  cursor: pointer;
  transition: all 0.15s;
}
.template-picker-item:hover {
  background: #eff6ff;
  border-color: #6366f1;
}
.template-picker-item .name {
  font-weight: 500;
  color: #374151;
}
.template-picker-cancel {
  width: 100%;
  padding: 10px;
  margin-top: 12px;
  background: transparent;
  border: none;
  color: #6b7280;
  font-size: 14px;
  cursor: pointer;
}
.template-picker-cancel:hover { color: #374151; }

/* Admin Modal */
.admin-modal-content {
  max-width: 600px;
}
.admin-prompt {
  text-align: center;
  color: #6b7280;
  margin-bottom: 20px;
}
.admin-login-form {
  display: flex;
  gap: 10px;
  max-width: 300px;
  margin: 0 auto;
}
.admin-login-form input {
  flex: 1;
  padding: 12px 16px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  font-size: 15px;
}
.admin-login-form input:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}
.admin-login-form button {
  padding: 12px 24px;
  background: #4f46e5;
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s;
}
.admin-login-form button:hover { background: #4338ca; }
.admin-summary {
  padding: 12px 16px;
  background: #f3f4f6;
  border-radius: 8px;
  margin-bottom: 16px;
  font-size: 14px;
  color: #374151;
  font-weight: 500;
}
.admin-projects-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 400px;
  overflow-y: auto;
}
.admin-project-card {
  background: white;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.admin-project-card:hover {
  border-color: #d1d5db;
