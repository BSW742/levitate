    } else {
      // Note mode: update note-specific fields
      const noteContent = (document.getElementById('detail-note-content') as HTMLTextAreaElement)?.value || '';

      updateNote(detailNoteId, {
        text: noteContent,
        activity: editingActivities,
        isLead: false,
        goalId,
        todayOn: detailTodayOn,
        quadrant,
        color: colors[quadrant],
        snoozeUntil,
        snoozeAction,
        images: editingNoteImages
