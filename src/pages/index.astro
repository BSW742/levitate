  document.querySelectorAll('.snooze-action-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const action = (btn as HTMLElement).dataset.action as 'call' | 'email' | 'meeting' | 'linkedin' | 'web';

      // Toggle selection
      if (selectedSnoozeAction === action) {
        selectedSnoozeAction = null;
        btn.classList.remove('active');
      } else {
        selectedSnoozeAction = action;
        document.querySelectorAll('.snooze-action-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      }

      updateSnoozeDisplay();
    });
  });

  // Update display when date changes
  document.getElementById('detail-snooze')?.addEventListener('change', () => {
    updateSnoozeDisplay();
  });

  // Clear snooze button
  document.getElementById('snooze-clear')?.addEventListener('click', () => {
    const input = document.getElementById('detail-snooze') as HTMLInputElement;
    if (input) input.value = '';
    selectedSnoozeAction = null;
    document.querySelectorAll('.snooze-action-btn').forEach(b => b.classList.remove('active'));
    updateSnoozeDisplay();
  });

  // Board picker in detail modal
  document.querySelectorAll('#detail-board-picker .board-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#detail-board-picker .board-opt').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      editingNoteQuadrant = parseInt((btn as HTMLElement).dataset.q || '0');
      updateSelectedBoardName();
      updateAvatarRingColor();
    });
  });

  // Avatar lightbox
  document.querySelector('.profile-avatar')?.addEventListener('click', openAvatarLightbox);
  document.querySelector('.lightbox-backdrop')?.addEventListener('click', closeAvatarLightbox);
  document.querySelector('.lightbox-close')?.addEventListener('click', closeAvatarLightbox);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAvatarLightbox();
  });

  // Activity type buttons
  document.querySelectorAll('.activity-type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const type = (btn as HTMLElement).dataset.type as 'call' | 'email' | 'meeting' | 'note' | 'linkedin' | 'web';
      currentActivityType = type;

      document.querySelectorAll('.activity-type-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const inputEl = document.getElementById('activity-input')!;
      const textEl = document.getElementById('activity-text') as HTMLInputElement;
      inputEl.classList.remove('hidden');
      textEl.placeholder = `Add ${type}...`;
      textEl.focus();
    });
  });

  // Add activity
  document.getElementById('activity-add')?.addEventListener('click', () => {
    const textEl = document.getElementById('activity-text') as HTMLInputElement;
    const text = textEl.value.trim();

    if (!text) return;

    const activity: Activity = {
      id: `act-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,
      timestamp: Date.now(),
      type: currentActivityType,
      text,
    };

    editingActivities.push(activity);
    renderActivities();

    textEl.value = '';
    document.getElementById('activity-input')?.classList.add('hidden');
    document.querySelectorAll('.activity-type-btn').forEach(b => b.classList.remove('active'));
  });

  // Cancel activity input
  document.getElementById('activity-cancel')?.addEventListener('click', () => {
    document.getElementById('activity-input')?.classList.add('hidden');
    (document.getElementById('activity-text') as HTMLInputElement).value = '';
    document.querySelectorAll('.activity-type-btn').forEach(b => b.classList.remove('active'));
  });

  // Enter key to add activity
  document.getElementById('activity-text')?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      document.getElementById('activity-add')?.click();
    }
  });

  document.getElementById('detail-avatar-btn')?.addEventListener('click', () => {
    document.getElementById('detail-avatar-upload')?.click();
  });

  document.getElementById('detail-avatar-upload')?.addEventListener('change', e => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file || !detailNoteId) return;

    const reader = new FileReader();
    reader.onload = ev => {
      const dataUrl = ev.target?.result as string;
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const size = 200;
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d')!;
        const minDim = Math.min(img.width, img.height);
        const sx = (img.width - minDim) / 2;
        const sy = (img.height - minDim) / 2;
        ctx.drawImage(img, sx, sy, minDim, minDim, 0, 0, size, size);
        const compressed = canvas.toDataURL('image/jpeg', 0.8);

        updateNote(detailNoteId!, { avatar: compressed });
        document.getElementById('detail-avatar')!.innerHTML = `<img src="${compressed}" alt="" />`;
        render();
      };
      img.src = dataUrl;
    };
    reader.readAsDataURL(file);
    (e.target as HTMLInputElement).value = '';
  });

  // Avatar upload on card
  document.getElementById('avatar-upload')?.addEventListener('change', e => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file || !avatarTargetId) return;

    const reader = new FileReader();
    reader.onload = ev => {
      const dataUrl = ev.target?.result as string;
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const size = 150;
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d')!;
        const minDim = Math.min(img.width, img.height);
        const sx = (img.width - minDim) / 2;
        const sy = (img.height - minDim) / 2;
        ctx.drawImage(img, sx, sy, minDim, minDim, 0, 0, size, size);
        const compressed = canvas.toDataURL('image/jpeg', 0.8);

        updateNote(avatarTargetId!, { avatar: compressed });
        render();
        avatarTargetId = null;
      };
      img.src = dataUrl;
    };
    reader.readAsDataURL(file);
    (e.target as HTMLInputElement).value = '';
  });

  // Sync indicator click
  document.getElementById('sync-indicator')?.addEventListener('click', () => {
    if (syncStatus === 'error') {
      syncToCloud();
    } else if (!getSyncPassword()) {
      document.getElementById('settings-btn')?.click();
    }
  });

  // Init
  async function init() {
    state = load();
    const cloudData = await syncFromCloud();
    if (cloudData && cloudData.notes) {
      // Merge: keep local notes + add any cloud notes not in local
      const localIds = new Set(state.notes.map(n => n.id));
      const newFromCloud = cloudData.notes.filter(n => !localIds.has(n.id));
      if (newFromCloud.length > 0) {
        state.notes.push(...newFromCloud);
        state.nextZIndex = Math.max(state.nextZIndex, cloudData.nextZIndex || 1);
      }
      // Merge board titles from cloud if present
      if (cloudData.boardTitles) {
        state.boardTitles = cloudData.boardTitles;
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }
    render();
    updateSyncIndicator();
    updateFabColor();
    updateMinimap();
    updateCurrentProjectDisplay();

    // Save current project to list on init
    const currentProject = getSyncPassword();
    if (currentProject) saveProjectToList(currentProject);
  }

  // Start
  if (checkAuth()) {
    init();
  }
</script>
</body>
</html>
