  function renderPlaySteps() {
    const box = document.getElementById('play-steps');
    if (!box || !editingPlay) return;
    const templates = state.emailTemplates || [];

    box.innerHTML = editingPlay.steps.map((st, i) => `
      <div class="play-step" data-i="${i}">
        <select class="ps-type">
          ${STEP_TYPES.map(t => `<option value="${t.id}" ${t.id === st.type ? 'selected' : ''}>${t.icon} ${t.label}</option>`).join('')}
        </select>
        <span class="ps-when">
          ${i === 0 ? 'when applied' : `+<input type="number" class="ps-offset" min="0" max="365" value="${st.offsetDays}"> days after`}
        </span>
        <select class="ps-template" ${st.type === 'email' || st.type === 'email_fup' ? '' : 'style="display:none"'}>
          <option value="">No template</option>
          ${templates.map(t => `<option value="${escapeHtml(t.name)}" ${t.name === st.template ? 'selected' : ''}>${escapeHtml(t.name)}</option>`).join('')}
        </select>
        <button class="ps-remove" title="Remove step">&times;</button>
        <input type="text" class="ps-note" placeholder="Why this step, or what to say" value="${escapeHtml(st.note || '')}">
      </div>`).join('') || '<p class="setting-hint">No steps yet.</p>';

    box.querySelectorAll('.play-step').forEach(row => {
      const i = parseInt((row as HTMLElement).dataset.i!, 10);
      row.querySelector('.ps-type')?.addEventListener('change', (e) => {
        editingPlay!.steps[i].type = (e.target as HTMLSelectElement).value as StepType;
        renderPlaySteps();
      });
      row.querySelector('.ps-offset')?.addEventListener('change', (e) => {
        editingPlay!.steps[i].offsetDays = Math.max(0, parseInt((e.target as HTMLInputElement).value, 10) || 0);
      });
      row.querySelector('.ps-template')?.addEventListener('change', (e) => {
        editingPlay!.steps[i].template = (e.target as HTMLSelectElement).value || undefined;
      });
      row.querySelector('.ps-note')?.addEventListener('change', (e) => {
        editingPlay!.steps[i].note = (e.target as HTMLInputElement).value.trim() || undefined;
      });
      row.querySelector('.ps-remove')?.addEventListener('click', () => {
        editingPlay!.steps.splice(i, 1);
        renderPlaySteps();
      });
    });
  }

  document.getElementById('add-play')?.addEventListener('click', () => openPlayModal());
  document.getElementById('play-add-step')?.addEventListener('click', () => {
    editingPlay?.steps.push({ type: 'email', offsetDays: editingPlay.steps.length ? 3 : 0 });
    renderPlaySteps();
  });
  document.getElementById('play-save')?.addEventListener('click', () => {
    if (!editingPlay) return;
    editingPlay.name = (document.getElementById('play-name') as HTMLInputElement).value.trim() || 'Untitled play';
    const plays = getPlays();
    const i = plays.findIndex(p => p.id === editingPlay!.id);
    if (i >= 0) plays[i] = editingPlay; else plays.push(editingPlay);
    save();
    renderPlaysList();
    document.getElementById('play-modal')!.classList.remove('visible');
    editingPlay = null;
