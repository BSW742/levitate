.quadrant-btn[data-q="3"] { background: #93c5fd; } /* Blue */
.quadrant-btn[data-q="4"] { background: #e0e7ff; } /* Indigo */
.quadrant-btn[data-q="5"] { background: #ede9fe; } /* Violet */
.minimap-note {
