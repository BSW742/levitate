    const snoozeValue = (document.getElementById('detail-snooze') as HTMLInputElement).value;
    const snoozeUntil = snoozeValue ? new Date(snoozeValue + 'T00:00:00').getTime() : undefined;
    const snoozeAction = snoozeUntil ? selectedSnoozeAction : undefined;

    const goalId = ((document.getElementById('detail-goal') as HTMLSelectElement)?.value) || undefined;

    // Get selected board
