  function saveDetailModal() {
    if (!detailNoteId) return;

    const name = (document.getElementById('detail-name') as HTMLInputElement).value;
    const role = (document.getElementById('detail-role') as HTMLInputElement).value;
    const company = (document.getElementById('detail-company') as HTMLInputElement).value;
    const phone = (document.getElementById('detail-phone') as HTMLInputElement).value;
    const email = (document.getElementById('detail-email') as HTMLInputElement).value;
