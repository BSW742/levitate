  // Init
  /* ---- Find -----------------------------------------------------------
     The PDA's lead search, on the desktop. Same three worker endpoints it
     has always used - /search by criteria, /enrich-url for a company, and
     /lookup for the web shortcuts - so there is one implementation of the
     searching and two front ends onto it.

     Everything reports into one status line inside the modal rather than a
     toast: these calls take seconds, and the answer belongs next to the
     button you pressed. ---- */
  const findModal = document.getElementById('find-modal');
  let findBoard = 0;
  let findBusy = false;

  function findEl<T extends HTMLElement>(id: string) {
    return document.getElementById(id) as T | null;
  }
  const findVal = (id: string) => (findEl<HTMLInputElement>(id)?.value || '').trim();

  function findSay(msg: string, isError = false) {
    const box = findEl('find-status');
    if (!box) return;
    box.hidden = !msg;
    box.textContent = msg;
    box.classList.toggle('err', isError);
  }

  function findClearResults() {
    const box = findEl('find-results');
    if (box) box.innerHTML = '';
  }

  function renderFindBoards() {
    const wrap = document.querySelector('.find-board-dots');
    if (!wrap) return;
    wrap.innerHTML = BOARD_COLORS.map((c, i) =>
      `<button data-b="${i}" class="${i === findBoard ? 'active' : ''}" style="background:${c}"
         title="${escapeHtml((state.boardTitles || DEFAULT_TITLES)[i])}"
         aria-label="${escapeHtml((state.boardTitles || DEFAULT_TITLES)[i])}"></button>`).join('');
    wrap.querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
      findBoard = Number((b as HTMLElement).dataset.b);
      renderFindBoards();
    }));
  }

  function findBusyState(on: boolean) {
    findBusy = on;
    const run = findEl<HTMLButtonElement>('find-run');
    if (run) run.disabled = on;
    document.querySelectorAll('.find-web-btn').forEach(b => (b as HTMLButtonElement).disabled = on);
  }

  // The run button says what it will actually do, which depends on the top field
  function syncFindButton() {
    const run = findEl('find-run');
    if (run) run.textContent = findVal('find-company') ? 'Look up company' : 'Find leads';
  }

  findEl('open-find')?.addEventListener('click', () => {
    findBoard = activeQuadrant;
    renderFindBoards();
    syncFindButton();
    findSay('');
    findClearResults();
    findModal?.classList.add('visible');
    findEl<HTMLInputElement>('find-company')?.focus();
  });

  function closeFind() { findModal?.classList.remove('visible'); }
  findModal?.querySelector('.modal-close')?.addEventListener('click', closeFind);
  findModal?.addEventListener('click', e => { if (e.target === findModal) closeFind(); });
  findEl('find-company')?.addEventListener('input', syncFindButton);

  // Enter anywhere in the form runs it, which is what you expect of a search box
  ['find-company', 'find-location', 'find-industry', 'find-role'].forEach(id =>
    findEl(id)?.addEventListener('keydown', e => {
      if ((e as KeyboardEvent).key === 'Enter') findEl<HTMLButtonElement>('find-run')?.click();
    }));

  /* One person, straight onto a board. Same shape drainLeadInbox builds, so
     a lead found here is indistinguishable from one the agent sent in. */
  function addFoundLead(l: { name?: string; role?: string; company?: string; linkedin?: string;
                            phone?: string; email?: string; website?: string }) {
    const q = findBoard;
    const onBoard = state.notes.filter(n => (n.quadrant ?? 0) === q).length;
    const col = onBoard % 5;
    const row = Math.floor(onBoard / 5);

    const note: Note = {
      id: `find-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
      text: [l.name, l.role, l.company].filter(Boolean).join('\n'),
      color: BOARD_COLORS[q],
      x: 40 + col * 200,
      y: 80 + row * 175,
      rotation: (Math.random() - 0.5) * 6,
      createdAt: Date.now(),
      updatedAt: Date.now(),
      zIndex: state.nextZIndex++,
      isLead: true,
      quadrant: q,
      name: l.name || '',
      role: l.role || '',
      company: l.company || '',
      phone: l.phone || '',
      email: l.email || '',
      linkedin: l.linkedin || '',
      website: l.website || '',
      notes: '',
    } as Note;

    state.notes.push(note);
    save();
    refreshView();
  }

  function renderFindPeople(people: Array<{ name?: string; role?: string; company?: string; linkedin?: string }>) {
    const box = findEl('find-results');
    if (!box) return;
    box.innerHTML = people.map((p, i) => `
      <div class="find-row">
        <div class="find-row-main">
          <div class="find-row-name">${escapeHtml(p.name || 'Unnamed')}</div>
          <div class="find-row-sub">${escapeHtml([p.role, p.company].filter(Boolean).join(' · '))}</div>
        </div>
        <button class="find-add" data-i="${i}">Add</button>
      </div>`).join('');

    box.querySelectorAll('.find-add').forEach(btn => btn.addEventListener('click', () => {
      const el = btn as HTMLButtonElement;
      if (el.classList.contains('added')) return;
      addFoundLead(people[Number(el.dataset.i)] || {});
      el.classList.add('added');
      el.textContent = 'Added';
    }));
  }

  /* Web results are links, not people. A company link fills the top field so
     you can enrich it; a person link goes to the clipboard, because the thing
     you want with those is to open them. */
  function renderFindLinks(kind: string, results: Array<{ title?: string; subtitle?: string; url: string }>) {
    const box = findEl('find-results');
    if (!box) return;
    const domainOf = (u: string) => { try { return new URL(u.startsWith('http') ? u : `https://${u}`).hostname.replace(/^www\./, ''); } catch { return u; } };

    box.innerHTML = results.map((r, i) => `
      <div class="find-row">
        <div class="find-row-main">
          <div class="find-row-name">${escapeHtml(r.title || domainOf(r.url))}</div>
          <div class="find-row-sub">${escapeHtml(r.subtitle || domainOf(r.url))}</div>
        </div>
        <button class="find-add" data-i="${i}">${kind === 'people' ? 'Copy' : 'Use'}</button>
      </div>`).join('');

    box.querySelectorAll('.find-add').forEach(btn => btn.addEventListener('click', () => {
      const r = results[Number((btn as HTMLElement).dataset.i)];
      if (!r) return;
      if (kind === 'people') {
        navigator.clipboard?.writeText(r.url).then(() => findSay('Link copied.'), () => findSay(r.url));
      } else {
        const input = findEl<HTMLInputElement>('find-company');
        if (input) { input.value = domainOf(r.url); syncFindButton(); }
        findSay(`Company set to ${domainOf(r.url)}. Press Look up company.`);
      }
    }));
  }

  findEl('find-run')?.addEventListener('click', async () => {
    if (findBusy) return;
    const pw = getSyncPassword();
    if (!pw) { findSay('No project set, so there is nowhere to search from. Pick one in Settings first.', true); return; }

    const company = findVal('find-company');
    findClearResults();
    findBusyState(true);

    try {
      if (company) {
        findSay(`Looking up ${company}...`);
        const res = await fetch(`${WORKER_URL}/enrich-url`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Sync-Password': pw },
          body: JSON.stringify({ url: company }),
        });
        const data = await res.json();
        if (!res.ok || data.error) { findSay(`Could not read that company${data.error ? ': ' + data.error : ''}.`, true); return; }
        renderFindPeople([{
          name: data.name || data.company || company,
          role: data.role || data.industry || '',
          company: data.company || '',
        }]);
        findSay('Found this. Add it, or refine and search again.');
        return;
      }

      const location = findVal('find-location');
      const industry = findVal('find-industry');
      const role = findVal('find-role');
      if (!location && !industry && !role) { findSay('Give it a location, an industry or a role to work with.', true); return; }

      findSay('Searching...');
      const res = await fetch(`${WORKER_URL}/search`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Sync-Password': pw },
        body: JSON.stringify({ location, industry, role }),
      });
      const data = await res.json();
      const people = data.profiles || [];
      if (!people.length) { findSay('Nobody came back. Try broader words.', true); return; }
      renderFindPeople(people);
      findSay(`${people.length} found.`);
    } catch {
      findSay('That search failed to reach the worker.', true);
    } finally {
      findBusyState(false);
    }
  });

  document.querySelectorAll('.find-web-btn').forEach(btn => btn.addEventListener('click', async () => {
    if (findBusy) return;
    const pw = getSyncPassword();
    if (!pw) { findSay('No project set, so there is nowhere to search from. Pick one in Settings first.', true); return; }

    const kind = (btn as HTMLElement).dataset.g!;
    const body = {
      kind,
      company: findVal('find-company'),
      location: findVal('find-location'),
      industry: findVal('find-industry'),
      role: findVal('find-role'),
    };
    if (kind === 'website' && !body.company) { findSay('Put a company in the top field first.', true); return; }
    if (kind === 'people' && !body.role && !body.industry && !body.location) { findSay('Add a role, industry or location first.', true); return; }
    if (kind === 'companies' && !body.industry && !body.location) { findSay('Add an industry or location first.', true); return; }

    findClearResults();
    findBusyState(true);
    findSay('Searching the web...');
    try {
      const res = await fetch(`${WORKER_URL}/lookup`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Sync-Password': pw },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      const results = data.results || [];
      if (!results.length) { findSay('Nothing found. Try different words.', true); return; }
      renderFindLinks(kind, results);
      findSay(`${results.length} result${results.length === 1 ? '' : 's'}.`);
    } catch {
      findSay('That search failed to reach the worker.', true);
    } finally {
      findBusyState(false);
    }
  }));

  async function init() {
    state = load();
    const rawCloud = await syncFromCloud();
    if (rawCloud) {
      state = mergeFromCloud(state, rawCloud);
      localStorage.setItem(storageKey(), JSON.stringify(state));
    }
    /* Baseline AFTER loading, never before: stamping is for edits made from
       here on. Snapshotting an empty state would mark everything as new and
       let this device's copy win every merge it takes part in. */
    snapshotItems();

    // ?view= (arriving from the PDA nav) beats the remembered mode
    const urlView = new URLSearchParams(location.search).get('view');
    const savedMode = localStorage.getItem(VIEW_MODE_KEY);
    const wanted = VIEW_MODES.includes(urlView as ViewMode)
      ? urlView as ViewMode
      : (VIEW_MODES.includes(savedMode as ViewMode) ? savedMode as ViewMode : 'tasks');
    setViewMode(wanted);
    if (urlView) history.replaceState(null, '', location.pathname);

    refreshView();   // setViewMode draws the right one; this keeps it explicit
    updateSyncIndicator();
    updateFabColor();
    updateCurrentProjectDisplay();

    // Save current project to list on init
    const currentProject = getSyncPassword();
    if (currentProject) saveProjectToList(currentProject);

    drainLeadInbox();
    setInterval(() => { drainLeadInbox(); pullFromCloud(); }, 30000);
    window.addEventListener('focus', () => { drainLeadInbox(); pullFromCloud(); });
  }

  // Start. If init throws, the app paints nothing and looks simply broken -
  // so draw something regardless and put the reason where it can be seen.
  if (checkAuth()) {
    init().catch(err => {
      console.error('[stiki] init failed', err);
      try { refreshView(true); updateSyncIndicator(); } catch {}
    });
  }
</script>
</body>
</html>
