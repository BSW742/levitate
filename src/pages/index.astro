  document.getElementById('play-delete')?.addEventListener('click', () => {
    if (!editingPlay || !confirm(`Delete "${editingPlay.name}"?`)) return;
    state.plays = getPlays().filter(p => p.id !== editingPlay!.id);
    state.notes.forEach(n => { if (n.playId === editingPlay!.id) { delete n.playId; delete n.playStep; } });
    save();
    renderPlaysList();
    document.getElementById('play-modal')!.classList.remove('visible');
    editingPlay = null;
