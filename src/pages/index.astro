  // Template picker for sending email
  function showTemplatePicker(note: Note) {
    const templates = getTemplates();
    if (templates.length === 0) {
      alert('No email templates. Create one in Settings first.');
      return;
    }

    pendingEmailLead = note;
    templatePickerList.innerHTML = templates.map((t, i) => `
