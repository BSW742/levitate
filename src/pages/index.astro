    (document.getElementById('detail-role') as HTMLInputElement).value = note.role || '';
    (document.getElementById('detail-company') as HTMLInputElement).value = companyValue;
    (document.getElementById('detail-phone') as HTMLInputElement).value = note.phone || '';
    (document.getElementById('detail-email') as HTMLInputElement).value = note.email || '';
