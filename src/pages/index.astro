  document.getElementById('switch-project-btn')?.addEventListener('click', async () => {
    const input = document.getElementById('switch-project-input') as HTMLInputElement;
    const newProject = input.value.trim();

    if (!newProject || newProject.length < 4) {
      alert('Project name must be at least 4 characters');
      return;
    }

    const currentProject = getSyncPassword();

    // Don't switch if same project
    if (newProject === currentProject) {
      settingsModal.classList.remove('visible');
      return;
    }

    // Step 1: Check if project exists first
    syncStatus = 'syncing';
    updateSyncIndicator();

    let projectExists = false;
    let cloudData: State | null = null;

    try {
      const checkRes = await fetch(`${WORKER_URL}?t=${Date.now()}`, {
        method: 'GET',
        headers: { 'X-Sync-Password': newProject },
        cache: 'no-store'
      });

      if (checkRes.ok) {
        projectExists = true;
        cloudData = await checkRes.json() as State;
      } else if (checkRes.status === 404) {
        projectExists = false;
      } else {
        throw new Error('Failed to check project');
      }
    } catch (e) {
      syncStatus = 'error';
      updateSyncIndicator();
      alert('Connection error. Please try again.');
      return;
    }

    // Step 2: If new project, confirm with user
    if (!projectExists) {
      const confirmed = confirm(`"${newProject}" is a new project.\n\nThis will create an empty board. Continue?`);
      if (!confirmed) {
        syncStatus = 'success';
        updateSyncIndicator();
        return;
      }
    }

    // Step 3: Save current data to current project (if we have one)
    if (currentProject) {
      try {
        await fetch(WORKER_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Sync-Password': currentProject },
          body: JSON.stringify(state)
        });
      } catch (e) {
        console.error('Failed to save current project:', e);
      }
    }

    // Step 4: Set new project password and save to list
    localStorage.setItem(SYNC_PASSWORD_KEY, newProject);
    saveProjectToList(newProject);

    // Step 5: Load data
    state = (projectExists && cloudData) ? normalizeState(cloudData) : emptyState();
    syncStatus = 'success';

    // Step 6: Save locally and redraw the view that is actually on screen
    selectedId = null;
    activeQuadrant = 0;
    document.querySelectorAll('.board').forEach(b => {
      b.classList.toggle('active', (b as HTMLElement).dataset.q === '0');
    });
    localStorage.setItem(storageKey(), JSON.stringify(state));
    /* Every view is now showing the OLD project. refreshView() alone honours
       the viewDirty cache, which was last cleared while the previous project
       was on screen - so the goals grid would keep painting that project's
       cards over this project's state until something else forced a redraw.
       Ticking one of those stale cards then did nothing at all, because its id
       does not exist in the project you just switched to. */
    snapshotItems();   // different project, different baseline
    markViewsDirty();
    refreshView(true);
    updateSyncIndicator();
    updateCurrentProjectDisplay();
    migratePlayTasks();
    removeEmptyLeads();
    drainLeadInbox();   // this project may have agent leads waiting

    settingsModal.classList.remove('visible');
  });

  document.getElementById('export-data')?.addEventListener('click', () => {
