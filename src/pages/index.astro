}

/* Email Templates */
.email-templates-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 12px;
}
.email-template-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s;
}
.email-template-item:hover {
  background: #f3f4f6;
  border-color: #d1d5db;
}
.email-template-name {
  font-weight: 500;
  color: #374151;
}
.email-template-subject {
  font-size: 12px;
  color: #9ca3af;
  margin-top: 2px;
}
.add-template-btn {
  padding: 10px 16px;
  background: #f3f4f6;
  border: 1px dashed #d1d5db;
  border-radius: 8px;
  color: #6b7280;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.15s;
  width: 100%;
}
.add-template-btn:hover {
  background: #e5e7eb;
  border-color: #9ca3af;
}
.add-template-btn:disabled {
