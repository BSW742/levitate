  // Minimap
  function updateMinimap() {
    document.querySelectorAll('.minimap-note').forEach(n => n.remove());

    // Notional board size the dots are mapped down from
    const BOARD_W = 1500, BOARD_H = 830;
    const DOT_W = 4, DOT_H = 3;
    const titles = state.boardTitles || DEFAULT_TITLES;
    const keys = ['O', 'Y', 'G', 'B', 'I', 'V'];

    const mapped = viewMode === 'people'
      ? state.notes.filter(n => n.isLead)
      : state.notes.filter(n => !n.isLead);

    mapped.forEach(note => {
      const q = note.quadrant ?? 0;
      const btn = document.querySelector(`.quadrant-btn[data-q="${q}"]`);
      if (!btn) return;

      // Scale against this button, not the whole minimap, or the dots
      // land outside their own board frame
      const bw = (btn as HTMLElement).clientWidth;
      const bh = (btn as HTMLElement).clientHeight;
      if (!bw || !bh) return;

      const dot = document.createElement('div');
      dot.className = 'minimap-note';
      const x = Math.max(0, Math.min(note.x * (bw / BOARD_W), bw - DOT_W));
      const y = Math.max(0, Math.min(note.y * (bh / BOARD_H), bh - DOT_H));
      dot.style.cssText = `left:${x}px;top:${y}px;width:${DOT_W}px;height:${DOT_H}px;`;
      btn.appendChild(dot);
    });

    document.querySelectorAll('.quadrant-btn').forEach(btn => {
      const q = parseInt((btn as HTMLElement).dataset.q || '0');
      btn.classList.toggle('active', q === activeQuadrant);
      // Update button title from state.boardTitles
      (btn as HTMLElement).title = `${titles[q]} (${keys[q]})`;
    });
  }

  // ============ GOALS ============
  const VIEW_MODE_KEY = 'stiki-view-mode';
  const STEP_TYPES: { id: StepType; label: string; icon: string }[] = [
    { id: 'email',      label: 'Email',                 icon: '✉️' },
    { id: 'email_fup',  label: 'Email follow-up',       icon: '↩️' },
    { id: 'call',       label: 'Call',                  icon: '📞' },
    { id: 'f2f',        label: 'Face to face',          icon: '🤝' },
    { id: 'li_connect', label: 'LI connection request', icon: '🔗' },
    { id: 'li_comment', label: 'LI comment',            icon: '💬' },
    { id: 'li_like',    label: 'LI like',               icon: '👍' },
    { id: 'text',       label: 'Text',                  icon: '💬' },
  ];
  const stepLabel = (t: StepType) => STEP_TYPES.find(x => x.id === t)?.label || t;
  const stepIcon  = (t: StepType) => STEP_TYPES.find(x => x.id === t)?.icon || '•';

  function getPlays(): Play[] {
    if (!state.plays) state.plays = [];
    return state.plays;
  }

  const TODAY_BOARD = 0;   // default landing board for goal-created tasks - no special meaning

  /* "Today" is a commitment, not a location. The flag stores the day it was
     made, so yesterday's plan expires at midnight with no cleanup job. */
  function isFlaggedToday(n: Note): boolean {
    if (!n.todayOn) return false;
    const d = new Date(n.todayOn), t = new Date();
    return d.getFullYear() === t.getFullYear() && d.getMonth() === t.getMonth() && d.getDate() === t.getDate();
  }
  function isDueToday(n: Note): boolean {
    return !!(n.snoozeUntil && n.snoozeUntil <= Date.now());
  }
  function countsAsToday(n: Note): boolean {
    return isFlaggedToday(n) || isDueToday(n);
  }
  function toggleToday(id: string) {
    const n = state.notes.find(x => x.id === id);
    if (!n) return;
    n.todayOn = isFlaggedToday(n) ? undefined : Date.now();
    n.updatedAt = Date.now();
    save();
    refreshView(true);
  }
  type ViewMode = 'goals' | 'people' | 'plays' | 'tasks' | 'list' | 'opps' | 'deals' | 'sales' | 'funnel' | 'scripts';
  // list still works, it just no longer earns a place in the nav
  const VIEW_MODES: ViewMode[] = ['sales', 'goals', 'funnel', 'opps', 'deals', 'plays', 'tasks', 'people', 'scripts'];
  let viewMode: ViewMode = 'tasks';

  function getGoals(): Goal[] {
    if (!state.goals) state.goals = [];
    return state.goals;
  }

  function setViewMode(mode: ViewMode) {
    viewMode = mode;
    localStorage.setItem(VIEW_MODE_KEY, mode);
    document.body.classList.toggle('goals-mode', mode === 'goals');
    document.body.classList.toggle('list-mode', mode === 'list');
    document.body.classList.toggle('plays-mode', mode === 'plays');
    document.body.classList.toggle('people-mode', mode === 'people');
    document.body.classList.toggle('opps-mode', mode === 'opps');
    document.body.classList.toggle('deals-mode', mode === 'deals');
    document.body.classList.toggle('scripts-mode', mode === 'scripts');
    document.body.classList.toggle('sales-mode', mode === 'sales');
    document.body.classList.toggle('funnel-mode', mode === 'funnel');
    document.getElementById('opps-view')?.classList.toggle('active', mode === 'opps');
    document.getElementById('deals-view')?.classList.toggle('active', mode === 'deals');
    document.getElementById('scripts-view')?.classList.toggle('active', mode === 'scripts');
    document.getElementById('sales-view')?.classList.toggle('active', mode === 'sales');
    document.getElementById('funnel-view')?.classList.toggle('active', mode === 'funnel');
    document.getElementById('people-view')?.classList.toggle('active', mode === 'people');

    document.getElementById('plays-view')?.classList.toggle('active', mode === 'plays');
    document.getElementById('goals-view')?.classList.toggle('active', mode === 'goals');
    document.getElementById('list-view')?.classList.toggle('active', mode === 'list');
    document.querySelectorAll('.mode-btn').forEach(b => {
      b.classList.toggle('active', (b as HTMLElement).dataset.mode === mode);
    });
    /* The strip scrolls on a narrow screen, so the tab you just landed on can
       be off the edge of it. Centre it rather than leaving the page looking
       like nothing is selected. */
    const strip = document.getElementById('mode-toggle');
    const on = strip?.querySelector('.mode-btn.active') as HTMLElement | null;
    if (strip && on && strip.scrollWidth > strip.clientWidth) {
      strip.scrollLeft = on.offsetLeft - (strip.clientWidth - on.offsetWidth) / 2;
    }
    refreshView();
  }

  function addGoal() {
    const goal: Goal = {
      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7),
      text: '',
      done: false,
      createdAt: Date.now()
    };
    getGoals().push(goal);
    save();
    renderGoals();
    const el = document.querySelector(`.goal-card[data-id="${goal.id}"] .goal-text`) as HTMLElement;
    el?.focus();
  }

  function toggleGoal(id: string) {
    const goal = getGoals().find(g => g.id === id);
    // The card on screen belongs to a project that is no longer loaded. Silently
    // doing nothing is what made this look like the app changing project by itself.
    if (!goal) { renderGoals(); return; }
    goal.done = !goal.done;
    goal.completedAt = goal.done ? Date.now() : undefined;

    const card = document.querySelector(`.goal-card[data-id="${id}"]`) as HTMLElement;
    if (card) {
      card.classList.remove('settled');   // let the strike play
      card.classList.toggle('done', goal.done);
      const btn = card.querySelector('.goal-check') as HTMLElement;
      if (btn) btn.title = goal.done ? 'Reopen' : 'Mark complete';
      const count = document.getElementById('goals-count');
      const goals = getGoals();
      if (count) count.textContent = `${goals.filter(g => g.done).length} of ${goals.length} complete`;
    }
    save();
  }



  function deleteGoal(id: string) {
    tombstone(id);
    state.goals = getGoals().filter(g => g.id !== id);
    // Unlink any tasks pointing at this goal
    state.notes.forEach(n => { if (n.goalId === id) delete n.goalId; });
    save();
    renderGoals();
  }

  /*
   * A goal's daily state falls out of its linked tasks - nothing is stored.
   * "Today" means a task sitting on the Orange board (Ben's today board) or
   * one whose snooze date has arrived. Because finishing a task deletes it,
   * clearing today's work flips a goal back to up-to-date, or to needs-a-task
   * if that was the last one, which is the prompt to name the next action.
   */
  function goalDailyState(goalId: string) {
    const linked = state.notes.filter(n => n.goalId === goalId);
    const now = Date.now();
    // "today" regardless of origin: a task you flagged, or a lead with a step due
    const today = linked
      .filter(n => (n.isLead ? playDueToday(n) : countsAsToday(n)))
      .sort((a, b) => (a.createdAt || 0) - (b.createdAt || 0));   // oldest first
    // Genuinely handled: every remaining task is booked for a future date
    const future = linked
      .filter(n => n.snoozeUntil && n.snoozeUntil > now)
      .sort((a, b) => (a.snoozeUntil || 0) - (b.snoozeUntil || 0));

    return {
      linked,
      today,
      future,
      status: today.length ? 'today'
        : future.length ? 'scheduled'      // banner-worthy
        : linked.length ? 'ok'             // tasks exist but nothing is booked
        : 'empty',
    };
  }

  function noteHeadline(n: Note): string {
    if (n.isLead) return n.name || (n.text || '').split('\n')[0] || 'Unnamed lead';
    return (n.text || '').split('\n').map(l => l.trim()).find(Boolean) || 'Untitled task';
  }

  // The + on a goal card: a blank task on the today board, already linked
  let pendingEmptyNoteId: string | null = null;
  function addTaskToGoal(goalId: string) {
    const onBoard = state.notes.filter(n => (n.quadrant ?? 0) === TODAY_BOARD).length;
    const note: Note = {
      id: `note-${Date.now()}-${Math.random().toString(36).slice(2, 9)}`,
      text: '',
      color: BOARD_COLORS[TODAY_BOARD],
      x: 40 + (onBoard % 5) * 200,
      y: 80 + Math.floor(onBoard / 5) * 175,
      rotation: (Math.random() - 0.5) * 6,
      createdAt: Date.now(),
      updatedAt: Date.now(),
      zIndex: state.nextZIndex++,
      isLead: false,
      quadrant: TODAY_BOARD,
      goalId,
      todayOn: Date.now(),   // added from a goal, so it is today by definition
    };
    state.notes.push(note);
    save();
    pendingEmptyNoteId = note.id;   // binned on close if nothing gets typed
    openDetailModal(note.id);
  }

  /* Reorder goals by dragging - first is highest priority.
   * Mirrors the sticky-note rule: land on a letter and you edit, start
   * anywhere else and you drag. The card is lifted out of flow and a dashed
   * slot shows where it will land. Nothing is added to a resting card, so
   * the board looks untouched until something is actually moving. */
  let goalDragEl: HTMLElement | null = null;
  let goalPlaceholder: HTMLElement | null = null;
  let goalGrab = { x: 0, y: 0 };
  let goalDragFrom = { x: 0, y: 0 };
  let goalDragging = false;
  const GOAL_DRAG_THRESHOLD = 6;

  document.getElementById('goals-grid')?.addEventListener('mousedown', (e) => {
    const ev = e as MouseEvent;
    if (ev.button !== 0) return;
    const target = ev.target as HTMLElement;
    const card = target.closest('.goal-card') as HTMLElement | null;
    if (!card) return;
    if (target.closest('button')) return;               // controls and mini stickies

    const editable = [...card.querySelectorAll('[data-field]')] as HTMLElement[];
    if (editable.some(el => pointOnGlyph(el, ev.clientX, ev.clientY))) return;   // editing wins

    // stop the browser starting a text selection before we know it is a drag
    ev.preventDefault();
    goalDragEl = card;
    goalDragFrom = { x: ev.clientX, y: ev.clientY };
    goalDragging = false;
  });

  function liftGoalCard(card: HTMLElement, clientX: number, clientY: number) {
    const rect = card.getBoundingClientRect();
    goalGrab = { x: clientX - rect.left, y: clientY - rect.top };

    goalPlaceholder = document.createElement('div');
    goalPlaceholder.className = 'goal-placeholder';
    card.parentElement!.insertBefore(goalPlaceholder, card);

    card.style.width = `${rect.width}px`;
    card.style.height = `${rect.height}px`;
    card.style.left = `${rect.left}px`;
    card.style.top = `${rect.top}px`;
    card.classList.add('goal-dragging');
    document.body.classList.add('goals-reordering');
  }

  document.addEventListener('mousemove', (e) => {
    if (!goalDragEl) return;

    if (!goalDragging) {
      if (Math.abs(e.clientX - goalDragFrom.x) < GOAL_DRAG_THRESHOLD &&
          Math.abs(e.clientY - goalDragFrom.y) < GOAL_DRAG_THRESHOLD) return;
      goalDragging = true;
      (document.activeElement as HTMLElement)?.blur();
      window.getSelection()?.removeAllRanges();
      liftGoalCard(goalDragEl, goalDragFrom.x, goalDragFrom.y);
    }
    e.preventDefault();

    goalDragEl.style.left = `${e.clientX - goalGrab.x}px`;
    goalDragEl.style.top = `${e.clientY - goalGrab.y}px`;

    // the lifted card has pointer-events:none, so this finds what is beneath it
    const under = (document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null)
      ?.closest('.goal-card') as HTMLElement | null;
    if (!under || under === goalDragEl || !goalPlaceholder) return;

    if (goalPlaceholder.compareDocumentPosition(under) & Node.DOCUMENT_POSITION_FOLLOWING) {
      under.after(goalPlaceholder);
    } else {
      under.before(goalPlaceholder);
    }
  });

  document.addEventListener('mouseup', () => {
    if (!goalDragEl) return;
    const card = goalDragEl;
    const wasDragging = goalDragging;
    goalDragEl = null;
    goalDragging = false;

    if (!wasDragging) return;

    card.classList.remove('goal-dragging');
    card.style.cssText = '';
    document.body.classList.remove('goals-reordering');
    goalPlaceholder?.replaceWith(card);
    goalPlaceholder = null;

    // DOM order is the new priority order
    const grid = document.getElementById('goals-grid');
    if (!grid) return;
    const order = [...grid.querySelectorAll('.goal-card')].map(el => (el as HTMLElement).dataset.id);
    const byId = new Map(getGoals().map(g => [g.id, g]));
    const reordered = order.map(id => byId.get(id!)).filter(Boolean) as Goal[];
    getGoals().forEach(g => { if (!reordered.includes(g)) reordered.push(g); });
    state.goals = reordered;
    save();
    viewDirty.goals = false;   // the DOM is already correct, no need to redraw
  });

  /* ---- Committing a goal edit ------------------------------------------
     A goal's text and its "done when" line are contenteditable, and they used
     to be written back on blur alone. Reloading with the caret still in the
     text never fires blur, so the edit went with the page. Read the field
     straight off the DOM so the same commit works from the blur handler and
     from the unload flush below. ---- */
  function commitGoalField(el: HTMLElement) {
    const id = el.closest('.goal-card')?.getAttribute('data-id');
    const field = el.dataset.field as 'text' | 'doneWhen' | undefined;
    if (!id || !field) return;
    const goal = getGoals().find(g => g.id === id);
    if (!goal) return;
    const val = (el.innerText || '').trim();
    if (goal[field] !== val) { (goal as any)[field] = val; save(); }
  }

  /* save() writes localStorage synchronously, so flushing the open field on the
     way out is enough - no need for the unreliable work-after-unload dance. */
  function flushOpenGoalEdit() {
    const el = document.activeElement as HTMLElement | null;
    if (el?.matches?.('.goal-card [data-field]')) commitGoalField(el);
  }

  window.addEventListener('pagehide', flushOpenGoalEdit);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') flushOpenGoalEdit();
  });

  function renderGoals() {
    const grid = document.getElementById('goals-grid');
    const count = document.getElementById('goals-count');
    if (!grid) return;
    const goals = getGoals();

    if (count) {
      const done = goals.filter(g => g.done).length;
      count.textContent = goals.length ? `${done} of ${goals.length} complete` : '';
    }

    const titles = state.boardTitles || DEFAULT_TITLES;

    grid.innerHTML = goals.map(g => {
      const daily = goalDailyState(g.id);
      const statusHtml = g.done || daily.status === 'today' ? '' : (
        daily.status === 'scheduled' ? `
          <div class="goal-status scheduled">
            <div class="gs-banner">
              <span class="gs-tick">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span class="gs-banner-label">Up to date</span>
              <span class="gs-next">${escapeHtml(formatDate(daily.future[0].snoozeUntil!))}${daily.future.length > 1 ? ` · ${daily.future.length} booked` : ''}</span>
            </div>
          </div>`
        : daily.status === 'ok'
          ? `<div class="goal-status ok"><span class="gs-dot"></span>Nothing booked</div>`
          : `<div class="goal-status empty"><span class="gs-dot"></span>Add a task</div>`
      );

      /* Today is shown by the little stickies, not by words. Everything else a
         goal has going on lives in the Tasks boards or the List view. */
      const MAX_STIKIS = 6;
      const shown = daily.today.slice(0, MAX_STIKIS);
      const hidden = daily.today.length - shown.length;
      const boardsHtml = shown.length ? `<div class="goal-stikis" title="${daily.today.length} for today">` + shown
        .map((n, idx) => n.isLead
          ? `<button class="goal-face" data-goal-task="${n.id}" title="${escapeHtml(noteHeadline(n))}" aria-label="${escapeHtml(noteHeadline(n))}">${
              n.avatar ? `<img src="${n.avatar}" alt="">` : `<span>${escapeHtml(initials(n.name || noteHeadline(n)))}</span>`}</button>`
          : `<button class="goal-stiki" data-goal-task="${n.id}"
              style="--sc:${n.color || BOARD_COLORS[n.quadrant ?? 0]}; --st:${idx % 2 ? 4 : -5}deg"
              title="${escapeHtml(noteHeadline(n))}"
              aria-label="${escapeHtml(noteHeadline(n))}"></button>`).join('')
        + (hidden > 0 ? `<span class="goal-stiki-more">+${hidden}</span>` : '')
        + `</div>` : '';

      return `
        <div class="goal-card ${g.done ? 'done settled' : ''} state-${daily.status}" data-id="${g.id}">
          <div class="goal-text" contenteditable="true" spellcheck="false" data-field="text">${escapeHtml(g.text)}</div>
          <div class="goal-when">
            <div class="goal-when-label">Completed when</div>
            <div class="goal-when-text" contenteditable="true" spellcheck="false" data-field="doneWhen">${escapeHtml(g.doneWhen || '')}</div>
          </div>
          ${statusHtml}
          <div class="goal-foot">
            <div class="goal-controls">
              <button class="goal-add-task" title="Add a task for today" aria-label="Add a task">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <button class="goal-check" title="${g.done ? 'Reopen' : 'Mark complete'}" aria-label="Mark complete">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <button class="goal-delete" title="Delete goal" aria-label="Delete goal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            ${boardsHtml}
          </div>
          <span class="goal-flames" aria-hidden="true"><i></i><i></i></span>
          <svg class="goal-cross" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <path class="s1" d="M -6 -5 C 30 28, 64 62, 106 105" pathLength="100"/>
            <path class="s2" d="M 106 -5 C 68 30, 32 64, -6 105" pathLength="100"/>
          </svg>
        </div>`;
    }).join('') + `
      <button class="goal-add" title="New goal" aria-label="New goal">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </button>`;

    grid.querySelector('.goal-add')?.addEventListener('click', addGoal);

    grid.querySelectorAll('.goal-card').forEach(card => {
      const id = (card as HTMLElement).dataset.id!;

      card.querySelectorAll('[data-field]').forEach(el => {
        el.addEventListener('blur', () => commitGoalField(el as HTMLElement));
        el.addEventListener('keydown', (e) => {
          if ((e as KeyboardEvent).key === 'Escape') (el as HTMLElement).blur();
        });
      });

      card.querySelector('.goal-add-task')?.addEventListener('click', () => addTaskToGoal(id));
      card.querySelector('.goal-check')?.addEventListener('click', () => toggleGoal(id));
      card.querySelector('.goal-delete')?.addEventListener('click', () => {
        const goal = getGoals().find(g => g.id === id);
        const label = goal?.text ? `"${goal.text.split('\n')[0]}"` : 'this goal';
        if (confirm(`Delete ${label}?`)) deleteGoal(id);
      });
    });

    // Jump straight to that goal's tasks on that board
    grid.querySelectorAll('[data-goal-task]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const first = state.notes.find(n => n.id === (btn as HTMLElement).dataset.goalTask);
        if (!first) return;
        const q = first.quadrant ?? 0;
        setViewMode('tasks');
        switchQuadrant(q);
        setTimeout(() => {
          const el = document.querySelector(`.sticky-note[data-id="${first.id}"]`) as HTMLElement;
          el?.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
          el?.classList.add('selected');
        }, 60);
      });
    });
  }

  /* The short-lived experiment where a play created a task card. Those tasks
     are not work you wrote, so remove them and put the schedule back on the
     lead where the play lives. */
  /* A person with nothing in them at all is not a person - it is a card the
     old + button created and never filled. Strict test: no name, no text, no
     contact detail, no photo, no history, no play. Only junk can match. */
  function removeEmptyLeads() {
    const junk = state.notes.filter(n =>
      n.isLead &&
      !(n.name || '').trim() &&
      !(n.text || '').trim() &&
      !n.company && !n.role && !n.email && !n.phone && !n.linkedin && !n.website &&
      !n.avatar && !n.playId &&
      !(n.activity && n.activity.length) &&
      !(n.images && n.images.length));
    if (!junk.length) return;
    const ids = new Set(junk.map(n => n.id));
    tombstone(...ids);
    state.notes = state.notes.filter(n => !ids.has(n.id));
    console.log(`[stiki] removed ${ids.size} empty lead card(s)`);
    save();
    refreshView(true);
  }

  function migratePlayTasks() {
    const generated = state.notes.filter(n => (n as any).stepType && (n as any).leadId);
    if (!generated.length) return;
    const ids = new Set(generated.map(n => n.id));
    generated.forEach(t => {
      const lead = state.notes.find(n => n.id === (t as any).leadId);
      if (lead && lead.playId && !lead.playDueAt) {
        lead.playDueAt = t.todayOn ? startOfToday() : (t.snoozeUntil || startOfToday());
      }
    });
    tombstone(...ids);
    state.notes = state.notes.filter(n => !ids.has(n.id));
    console.log(`[stiki] removed ${ids.size} generated play task(s)`);
    save();
    refreshView(true);
  }

  /* Changes made elsewhere - the PDA hydrating someone, the agent adding a
     lead - only reach this tab if we go and look. Held off while you are
     dragging or have a card open, so nothing moves under your hands. */
  function stateSignature(): string {
    return state.notes.length + '|' + state.notes.reduce((t, n) => t + (n.updatedAt || 0), 0)
      + '|' + (state.goals?.length || 0) + '|' + (state.deals?.length || 0)
      + '|' + (state.sales?.length || 0)
      + '|' + (state.sales || []).reduce((t, c) => t + (c.updatedAt || 0), 0);
  }

  async function pullFromCloud() {
    if (!getSyncPassword()) return;
    if (isDragging || goalDragging || multiSelectMode) return;
    if (document.getElementById('detail-modal')?.classList.contains('visible')) return;
    if (document.activeElement?.isContentEditable) return;
    if (salesCellFocused()) return;

    const raw = await syncFromCloud();
    if (!raw) return;
    const before = stateSignature();
    state = mergeFromCloud(state, raw);
    if (stateSignature() === before) return;
    snapshotItems();   // the merged copy is the new baseline
    localStorage.setItem(storageKey(), JSON.stringify(state));
    refreshView(true);
    console.log('[stiki] pulled changes from the cloud');
  }

  // ============ AGENT LEAD INBOX ============
  /*
   * Leads posted by the ChatGPT action land in a server-side inbox rather
   * than the project blob, because syncToCloud() PUTs that blob wholesale
   * and any open tab would overwrite them. We pull them in here, then ack
   * so the server can drop them. Note ids are derived from the inbox id,
   * so a failed ack replays harmlessly instead of duplicating.
   */
  async function drainLeadInbox() {
    const pw = getSyncPassword();
    if (!pw) return;

    let payload: { leads?: { key: string; lead: any }[] };
    try {
      const res = await fetch(`${WORKER_URL}/api/inbox`, { headers: { 'X-Sync-Password': pw } });
      if (!res.ok) return;
      payload = await res.json();
    } catch { return; }

    const items = payload.leads || [];
    if (!items.length) return;

    const keys: string[] = [];
    let added = 0;

    items.forEach(item => {
      const l = item.lead || {};
      keys.push(item.key);

      const id = `agent-${l.id}`;
      if (state.notes.some(n => n.id === id)) return;   // already merged

      const q = Number.isInteger(l.board) && l.board >= 0 && l.board <= 5 ? l.board : 0;

      // lay them out in a grid so they never land on top of each other
      const onBoard = state.notes.filter(n => (n.quadrant ?? 0) === q).length + added;
      const col = onBoard % 5;
      const row = Math.floor(onBoard / 5);

      const text = [l.name, l.role, l.company].filter(Boolean).join('\n');

      const note: Note = {
        id,
        text,
        color: BOARD_COLORS[q],
        x: 40 + col * 200,
        y: 80 + row * 175,
        rotation: (Math.random() - 0.5) * 6,
        createdAt: l.receivedAt || Date.now(),
        updatedAt: Date.now(),
        zIndex: state.nextZIndex++,
        isLead: true,
        quadrant: q,
        name: l.name || '',
        role: l.role || '',
        company: l.company || '',
        phone: l.phone || '',
        email: l.email || '',
        linkedin: l.linkedin || '',
        website: l.website || '',
        notes: l.notes || '',
        activity: [{
          id: `act-${l.id}`,
          timestamp: l.receivedAt || Date.now(),
          type: 'note',
          text: l.notes ? `From agent: ${l.notes}` : 'Added by agent',
        }],
      };

      state.notes.push(note);
      added++;
    });

    if (added) {
      save();
      if (viewMode === 'tasks') render();
      else if (viewMode === 'list') renderList();
      else if (viewMode === 'goals') renderGoals();
      updateMinimap();
      console.log(`[stiki] merged ${added} lead(s) from the agent inbox`);
    }

    // Clear the server copy either way; anything we skipped was already merged
    try {
      await fetch(`${WORKER_URL}/api/inbox/ack`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Sync-Password': pw },
        body: JSON.stringify({ keys }),
      });
    } catch { /* it will simply replay next time */ }
  }

  document.querySelectorAll('.settings-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const pane = (tab as HTMLElement).dataset.pane;
      document.querySelectorAll('.settings-tab').forEach(t => t.classList.toggle('active', t === tab));
      document.querySelectorAll('.settings-pane').forEach(p =>
        p.classList.toggle('active', (p as HTMLElement).dataset.pane === pane));
    });
  });

  // ============ PLAYS ============
  /* A play answers one question: what is the next move, and when. It never
     tracks deal status - that is the road to a pipeline field that lies.
     Steps drive snoozeUntil/snoozeAction, so a due step already shows up as
     today's work on the lead's goal without any extra plumbing. */

  function playOf(n: Note): Play | undefined {
    return n.playId ? getPlays().find(p => p.id === n.playId) : undefined;
  }

  function currentStep(n: Note): PlayStep | undefined {
    const play = playOf(n);
    return play ? play.steps[n.playStep ?? 0] : undefined;
  }

  function stepToSnoozeAction(t: StepType): 'call' | 'email' | 'meeting' | 'linkedin' | 'web' {
    if (t === 'call' || t === 'text') return 'call';
    if (t === 'email' || t === 'email_fup') return 'email';
    if (t === 'f2f') return 'meeting';
    return 'linkedin';
  }

  function addPlayActivity(n: Note, text: string, type: Activity['type'] = 'note') {
    n.activity = n.activity || [];
    n.activity.push({ id: `act-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`, timestamp: Date.now(), type, text });
  }

  function startOfToday(): number {
    const d = new Date(); d.setHours(0, 0, 0, 0); return d.getTime();
  }
  function endOfToday(): number { return startOfToday() + 86400000 - 1; }

  function playDueToday(n: Note): boolean {
    return !!(n.playId && n.playDueAt && n.playDueAt <= endOfToday());
  }

  function leadsWithStepDue(): Note[] {
    return state.notes
      .filter(n => n.isLead && playDueToday(n) && currentStep(n))
      .sort((a, b) => (a.playDueAt || 0) - (b.playDueAt || 0));
  }

  function schedulePlayStep(lead: Note, step: PlayStep, isFirst: boolean) {
    const due = new Date();
    due.setHours(0, 0, 0, 0);
    due.setDate(due.getDate() + (isFirst ? 0 : step.offsetDays));
    lead.playDueAt = due.getTime();
    lead.updatedAt = Date.now();
  }

  function applyPlay(leadId: string, playId: string) {
    const lead = state.notes.find(x => x.id === leadId);
    const play = getPlays().find(p => p.id === playId);
    if (!lead || !play || !play.steps.length) return;
    lead.playId = playId;
    lead.playStep = 0;
    schedulePlayStep(lead, play.steps[0], true);
    addPlayActivity(lead, `Started play: ${play.name}`);
    save();
    refreshView(true);
    if (detailNoteId === leadId) renderPlayControl(lead);
  }

  function advancePlay(lead: Note, logged: string | null) {
    const play = playOf(lead);
    if (!play) return;
    const idx = lead.playStep ?? 0;
    if (logged) addPlayActivity(lead, logged, stepToSnoozeAction(play.steps[idx].type) as Activity['type']);
    const next = idx + 1;
    if (next >= play.steps.length) {
      addPlayActivity(lead, `Play complete: ${play.name}`);
      delete lead.playId;
      delete lead.playStep;
      delete lead.playDueAt;
    } else {
      lead.playStep = next;
      schedulePlayStep(lead, play.steps[next], false);
    }
    lead.updatedAt = Date.now();
    save();
    refreshView(true);
    if (detailNoteId === lead.id) renderPlayControl(lead);
  }

  function stopPlay(lead: Note) {
    const play = playOf(lead);
    if (play) addPlayActivity(lead, `Stopped play: ${play.name}`);
    delete lead.playId;
    delete lead.playStep;
    delete lead.playDueAt;
    save();
    refreshView(true);
    renderPlayControl(lead);
  }

  /* Perform the step against the lead. Email opens an Outlook draft - we
     never send, and add no signature, because Outlook appends its own. */
  function performStep(lead: Note, type: StepType, template?: string): boolean {
    const tpl = (state.emailTemplates || []).find(t => t.name === template);
    const first = (lead.name || '').trim().split(/\s+/)[0] || '';
    const fill = (v: string) => v
      .replace(/\[name\]/gi, first)
      .replace(/\[company\]/gi, lead.company || '')
      .replace(/\[role\]/gi, lead.role || '');

    switch (type) {
      case 'email':
      case 'email_fup': {
        if (!lead.email) { alert('This lead has no email address.'); return false; }
        let subject = tpl ? fill(tpl.subject) : '';
        if (type === 'email_fup' && subject && !/^re:/i.test(subject)) subject = `RE: ${subject}`;
        window.location.href = `mailto:${encodeURIComponent(lead.email)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(tpl ? fill(tpl.body) : '')}`;
        break;
      }
      case 'call':  if (lead.phone) window.location.href = `tel:${lead.phone.replace(/\s+/g, '')}`; break;
      case 'text':  if (lead.phone) window.location.href = `sms:${lead.phone.replace(/\s+/g, '')}`; break;
      case 'li_connect':
      case 'li_comment':
      case 'li_like': {
        const li = lead.linkedin
          ? (lead.linkedin.startsWith('http') ? lead.linkedin : `https://${lead.linkedin}`)
          : `https://www.google.com/search?q=${encodeURIComponent(`${lead.name || ''} ${lead.company || ''} linkedin`)}`;
        window.open(li, '_blank', 'noopener');
        break;
      }
      case 'f2f': break;   // a reminder, nothing to launch
    }
    return true;
  }

  function doPlayStep(leadId: string) {
    const lead = state.notes.find(n => n.id === leadId);
    const step = lead ? currentStep(lead) : undefined;
    if (!lead || !step) return;
    if (!performStep(lead, step.type, step.template)) return;
    advancePlay(lead, `${stepLabel(step.type)}${step.template ? ` (${step.template})` : ''}`);
  }

  function skipPlayStep(leadId: string) {
    const lead = state.notes.find(n => n.id === leadId);
    const step = lead ? currentStep(lead) : undefined;
    if (!lead || !step) return;
    advancePlay(lead, `Skipped: ${stepLabel(step.type)}`);
  }

  function renderPlayControl(n: Note | undefined) {
    const trigger = document.getElementById('detail-play');
    const display = document.getElementById('play-display');
    const pop = document.getElementById('play-popover');
    if (!trigger || !display || !pop) return;

    // plays are for people
    (trigger.parentElement as HTMLElement).style.display = n && n.isLead ? '' : 'none';
    if (!n || !n.isLead) return;

    const play = playOf(n);
    const step = currentStep(n);
    trigger.classList.toggle('on', !!play);
    display.textContent = play ? `${play.name} · ${(n.playStep ?? 0) + 1}/${play.steps.length}` : 'Play';

    if (!play || !step) {
      const plays = getPlays();
      pop.innerHTML = plays.length ? `
        <div class="play-pop-head">Start a play</div>
        ${plays.map(p => `<button class="play-pick" data-play="${p.id}">${escapeHtml(p.name)} <span>${p.steps.length} steps</span></button>`).join('')}
      ` : `<div class="play-pop-head">No plays yet</div><p class="play-pop-hint">Create one in Settings.</p>`;
      pop.querySelectorAll('[data-play]').forEach(b => b.addEventListener('click', () => {
        applyPlay(n.id, (b as HTMLElement).dataset.play!);
        pop.classList.remove('open');
      }));
      return;
    }

    const due = n.playDueAt ? formatDate(n.playDueAt) : 'today';
    pop.innerHTML = `
      <div class="play-pop-head">Next</div>
      <div class="play-next"><span class="play-next-icon">${stepIcon(step.type)}</span>
        <span><strong>${stepLabel(step.type)}</strong><em>${due}${step.template ? ` · ${escapeHtml(step.template)}` : ''}</em></span>
      </div>
      ${step.note ? `<div class="play-note">${escapeHtml(step.note)}</div>` : ''}
      <div class="play-pop-actions">
        <button class="play-do primary">Do it</button>
        <button class="play-skip">Skip</button>
        <button class="play-stop">Stop play</button>
      </div>`;
    pop.querySelector('.play-do')?.addEventListener('click', () => { doPlayStep(n.id); pop.classList.remove('open'); });
    pop.querySelector('.play-skip')?.addEventListener('click', () => { skipPlayStep(n.id); });
    pop.querySelector('.play-stop')?.addEventListener('click', () => { stopPlay(n); pop.classList.remove('open'); });
  }

  document.getElementById('detail-play')?.addEventListener('click', (e) => {
    e.stopPropagation();
    document.getElementById('play-popover')?.classList.toggle('open');
  });
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('.play-control')) document.getElementById('play-popover')?.classList.remove('open');
  });


  let editingPlay: Play | null = null;

  function renderPlaysList() {
    const box = document.getElementById('plays-list');
    if (!box) return;
    const plays = getPlays();
    box.innerHTML = plays.length ? plays.map(p => `
      <div class="template-item" data-play="${p.id}">
        <span class="template-name">${escapeHtml(p.name || 'Untitled play')}</span>
        <span class="template-meta">${p.steps.length} step${p.steps.length === 1 ? '' : 's'}</span>
      </div>`).join('') : '<p class="setting-hint">No plays yet.</p>';

    box.querySelectorAll('[data-play]').forEach(el => {
      el.addEventListener('click', () => openPlayModal((el as HTMLElement).dataset.play!));
    });
  }

  function openPlayModal(id?: string) {
    const plays = getPlays();
    editingPlay = id
      ? JSON.parse(JSON.stringify(plays.find(p => p.id === id))) as Play
      : { id: `play-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`, name: '', steps: [] };

    (document.getElementById('play-modal-title') as HTMLElement).textContent = id ? 'Edit Play' : 'New Play';
