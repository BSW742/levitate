      countBadge.textContent = editingActivities.length > 0 ? String(editingActivities.length) : '';
    }

    const sorted = [...editingActivities].sort((a, b) => b.timestamp - a.timestamp);

    const html = editingActivities.length === 0
      ? '<div class="activity-empty">No activity yet</div>'
      : sorted.map(act => `
        <div class="activity-item" data-id="${act.id}" data-type="${act.type}">
